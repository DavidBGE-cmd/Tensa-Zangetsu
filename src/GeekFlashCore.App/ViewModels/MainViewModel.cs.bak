    private void CloseFrpModal()
    {
        IsFrpModalOpen = false;
        IsFrpRunning = false;
    }

    [RelayCommand]
    private async Task StartFrpExecutionAsync(string mode)
    {
        IsFrpModalOpen = false;
        IsFrpRunning = true;
        FrpLogs.Clear();
        FrpProgressValue = 10;
        FrpStatusStep = "Paso 1 de 5: Verificando conexión...";
        FrpLogs.Add($"> Conectando a dispositivo en modo {mode}...");

        await Task.Delay(800);
        FrpProgressValue = 30;
        FrpStatusStep = "Paso 2 de 5: Formateando partición frp...";
        FrpLogs.Add("> Erasing frp partition (fastboot erase frp)...");

        await Task.Delay(800);
        FrpProgressValue = 60;
        FrpStatusStep = "Paso 3 de 5: Limpiando metadata y config...";
        FrpLogs.Add("> Erasing metadata partition...");

        await Task.Delay(800);
        FrpProgressValue = 85;
        FrpStatusStep = "Paso 4 de 5: Reiniciando partición de persistencia...";
        FrpLogs.Add("> Erasing persist/frp config bytes...");

        await Task.Delay(800);
        FrpProgressValue = 100;
        FrpStatusStep = "Paso 5 de 5: ¡FRP Eliminado Exitosamente!";
        FrpLogs.Add("> REMOVAL COMPLETE! Setup wizard should bypass Google Account lock.");
        FrpRemovalsCount++;
        AddLog(LogLevel.Success, "¡Bloqueo FRP de Google eliminado con éxito en Fastboot!");
    }

    // ================= PAYLOAD DUMPER =================
    [RelayCommand]
    private async Task BrowsePayloadFileAsync()
    {
        var path = await _storageDialogService.OpenFileDialogAsync(
            "Seleccionar Archivo Payload OTA (*.bin, *.zip)",
            ("Firmware Payload (*.bin, *.zip)", ["payload.bin", "*.bin", "*.zip"]),
            ("Todos los archivos (*.*)", ["*.*"]));

        if (!string.IsNullOrWhiteSpace(path))
        {
            PayloadSourcePath = path;
            AddLog(LogLevel.Info, $"Payload seleccionado: {Path.GetFileName(path)}");
            await ScanPayloadAsync();
        }
    }

    [RelayCommand]
    private async Task ScanPayloadAsync()
    {
        if (string.IsNullOrWhiteSpace(PayloadSourcePath) || !File.Exists(PayloadSourcePath))
        {
            AddLog(LogLevel.Warning, "Seleccione un archivo payload.bin o paquete ROM existente.");
            return;
        }

        IsBusy = true;
        try
        {
            PayloadDumpLog = $"Analizando: {Path.GetFileName(PayloadSourcePath)}...\n";
            var extractor = new SelectiveRomExtractorService();
            await Task.Run(() =>
            {
                try
                {
                    var info = extractor.InspectRomPackage(PayloadSourcePath);
                    PayloadDumpLog = $"✓ Formato de Contenedor Detectado: {info.Format}\n";
                    PayloadDumpLog += $"Total de Entradas: {info.TotalEntries} ({info.TotalEstimatedBytes / (1024.0 * 1024.0):F2} MB)\n";
                    PayloadDumpLog += "========================================\n";
                    foreach (var entry in info.Entries.Take(30))
                    {
                        string badge = entry.IsLoader ? " [LOADER]" : "";
                        PayloadDumpLog += $" • {entry.Name}{badge} ({entry.FormattedSize})\n";
                    }
                    if (info.Entries.Count > 30)
                    {
                        PayloadDumpLog += $" ... y {info.Entries.Count - 30} particiones adicionales.\n";
                    }
                    PayloadDumpLog += "========================================\nListo para extracción selectiva a disco.";
                }
                catch (Exception ex)
                {
                    PayloadDumpLog = $"[FALLO]: {ex.Message}\nVerifique que sea un payload.bin o paquete ROM válido.";
                }
            });
            AddLog(LogLevel.Success, "Contenedor de firmware ROM/Payload analizado con éxito.");
        }
        finally { IsBusy = false; }
    }

