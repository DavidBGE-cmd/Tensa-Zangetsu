    // ================= DRIVER FIX REMEDIATION =================
    [RelayCommand]
    private async Task FixDriverAsync()
    {
        AddLog(LogLevel.Info, "::: Iniciando remediación de controlador USB :::");
        if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.MissingDriverFastboot or ConnectedDeviceMode.Fastboot or ConnectedDeviceMode.FastbootD)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "GOOGLE_ADB");
            if (comp != null) await InstallComponentAsync(comp);
        }
        else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.MissingDriverAdb or ConnectedDeviceMode.AdbOnline or ConnectedDeviceMode.AdbRecovery)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "GOOGLE_ADB");
            if (comp != null) await InstallComponentAsync(comp);
        }
        else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.SamsungDownload)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "SAMSUNG_CDC");
            if (comp != null) await InstallComponentAsync(comp);
        }
        else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.MtkBrom or ConnectedDeviceMode.MtkPreloader or ConnectedDeviceMode.MtkDa)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "MTK_VCOM");
            if (comp != null) await InstallComponentAsync(comp);
            else await CleanComPortsAsync();
        }
        else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.QualcommEdl)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "QCOM_9008");
            if (comp != null) await InstallComponentAsync(comp);
            else await CleanComPortsAsync();
        }
        else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.UnisocBsl)
        {
            var comp = SystemComponents.FirstOrDefault(c => c.Id == "SPRD_DIAG");
            if (comp != null) await InstallComponentAsync(comp);
            else await CleanComPortsAsync();
        }
        else
        {
            await CleanComPortsAsync();
        }
    }

    // ================= 1. GLOBAL TOP BAR: ANALYZE & AUTO-MATCH =================
    [RelayCommand]
    private async Task AnalyzeAndMatchDeviceAsync()
    {
        IsBusy = true;
        try
        {
            AddLog(LogLevel.Info, "::: ANALIZANDO EQUIPO Y AUTO-EMPAREJANDO LOADERS :::");
            var detected = await _adbFastbootService.ScanDevicesAsync();
            if (detected.Mode != ConnectedDeviceMode.Disconnected)
            {
                ConnectedDeviceInfo = detected;
            }

            var resolver = new AutoLoaderResolverService();
            DeviceHardwareFingerprint? fp = null;

            if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.QualcommEdl)
            {
                DetectedHardwareSummary = "Qualcomm Snapdragon (EDL 9008 Detectado)";
                fp = new DeviceHardwareFingerprint("QCOM");
            }
            else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.MtkBrom or ConnectedDeviceMode.MtkPreloader or ConnectedDeviceMode.MtkDa)
            {
                DetectedHardwareSummary = "MediaTek Helio / Dimensity (BROM/Preloader Detectado)";
                fp = new DeviceHardwareFingerprint("MTK");
            }
            else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.UnisocBsl)
            {
                DetectedHardwareSummary = "UNISOC / SPRD (BSL Diag Mode Detectado)";
                fp = new DeviceHardwareFingerprint("SPRD");
            }
            else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.Fastboot or ConnectedDeviceMode.FastbootD)
            {
                string product = ConnectedDeviceInfo.ProductCode;
                DetectedHardwareSummary = $"Fastboot Device ({product})";
                if (product.Contains("qcom", StringComparison.OrdinalIgnoreCase) || product.Contains("sm", StringComparison.OrdinalIgnoreCase))
                    fp = new DeviceHardwareFingerprint("QCOM");
                else if (product.Contains("mt", StringComparison.OrdinalIgnoreCase))
                    fp = new DeviceHardwareFingerprint("MTK");
                else if (product.Contains("sprd", StringComparison.OrdinalIgnoreCase) || product.Contains("ums", StringComparison.OrdinalIgnoreCase))
                    fp = new DeviceHardwareFingerprint("SPRD");
                else
                    fp = new DeviceHardwareFingerprint("MTK");
            }
            else if (ConnectedDeviceInfo.Mode is ConnectedDeviceMode.AdbOnline or ConnectedDeviceMode.AdbRecovery)
            {
                DetectedHardwareSummary = $"Android Device ({ConnectedDeviceInfo.ModelName})";
                fp = new DeviceHardwareFingerprint("MTK");
            }
            else
            {
                var ports = System.IO.Ports.SerialPort.GetPortNames();
                if (ports.Length > 0)
                {
                    DetectedHardwareSummary = $"Puerto Serial detectado: {string.Join(", ", ports)}";
                    fp = new DeviceHardwareFingerprint("MTK");
                }
                else
                {
                    DetectedHardwareSummary = "Sin dispositivo USB / COM detectado";
                    ResolvedLoaderStatus = "Conecte un dispositivo por USB para auto-emparejar loaders.";
                    AddLog(LogLevel.Warning, "No se detectó ningún dispositivo ni puerto COM activo.");
                    return;
                }
            }

            if (UseAutoLoaderMatch && fp != null)
            {
                var bundle = resolver.ResolveForDevice(fp);
                if (!string.IsNullOrEmpty(bundle.QcomFirehosePath))
                {
                    QcomFirehosePath = bundle.QcomFirehosePath;
                    ResolvedLoaderStatus = $"✓ Firehose: {Path.GetFileName(bundle.QcomFirehosePath)}";
                    AddLog(LogLevel.Success, $"[AUTO-MATCH] Firehose emparejado: {bundle.QcomFirehosePath}");
                }
                if (!string.IsNullOrEmpty(bundle.MtkDaPath))
                {
                    MtkDaPath = bundle.MtkDaPath;
                    ResolvedLoaderStatus = $"✓ DA: {Path.GetFileName(bundle.MtkDaPath)}";
                    AddLog(LogLevel.Success, $"[AUTO-MATCH] Download Agent emparejado: {bundle.MtkDaPath}");
                }
                if (!string.IsNullOrEmpty(bundle.MtkPreloaderPath))
                {
                    MtkPreloaderOrRomPath = bundle.MtkPreloaderPath;
                    ResolvedLoaderStatus += $" | Preloader: {Path.GetFileName(bundle.MtkPreloaderPath)}";
                    AddLog(LogLevel.Success, $"[AUTO-MATCH] Preloader emparejado: {bundle.MtkPreloaderPath}");
                }
                if (!string.IsNullOrEmpty(bundle.SprdFdl1Path))
                {
                    SprdFdl1Path = bundle.SprdFdl1Path;
                    SprdFdl1Address = $"0x{bundle.SprdFdl1Address:X8}";
                }
                if (!string.IsNullOrEmpty(bundle.SprdFdl2Path))
                {
                    SprdFdl2Path = bundle.SprdFdl2Path;
                    SprdFdl2Address = $"0x{bundle.SprdFdl2Address:X8}";
                    ResolvedLoaderStatus = $"✓ SPRD FDL1/FDL2 emparejados ({SprdFdl1Address} / {SprdFdl2Address})";
                    AddLog(LogLevel.Success, $"[AUTO-MATCH] FDL1/FDL2 emparejados.");
                }
                if (!string.IsNullOrEmpty(bundle.AuthFilePath))
                {
                    MtkAuthPath = bundle.AuthFilePath;
                    AddLog(LogLevel.Success, $"[AUTO-MATCH] Certificado Auth SLA/DAA emparejado: {bundle.AuthFilePath}");
                }

                if (string.IsNullOrEmpty(bundle.QcomFirehosePath) && string.IsNullOrEmpty(bundle.MtkDaPath) && string.IsNullOrEmpty(bundle.SprdFdl1Path))
                {
                    ResolvedLoaderStatus = "Loaders no encontrados en Assets/Loaders. Use el Extractor de ROM o seleccione manualmente.";
                    AddLog(LogLevel.Info, "Loaders no encontrados en disco. Use la pestaña Extractor de ROM.");
                }
            }
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al analizar equipo: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

