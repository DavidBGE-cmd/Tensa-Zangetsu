    [RelayCommand]
    private void OpenFrpModal()
    {
        if (!FrpAgreedEraseData || !FrpConfirmedFastboot)
        {
            AddLog(LogLevel.Warning, "Debes marcar las dos casillas de verificación de seguridad para continuar.");
            return;
