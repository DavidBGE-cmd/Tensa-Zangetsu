    // ================= 5. SELECTIVE ROM & LOADERS EXTRACTOR COMMANDS =================
    [RelayCommand]
    private async Task BrowseSelectiveRomAsync()
    {
        var path = await _storageDialogService.OpenFileDialogAsync(
            "Seleccionar Contenedor de Firmware ROM (.ofp, .ops, .pac, .ozip, payload.bin, .zip)",
            ("Contenedores de ROM (*.ofp, *.ops, *.pac, *.ozip, payload.bin, *.zip)", ["*.ofp", "*.ops", "*.pac", "*.ozip", "payload.bin", "*.bin", "*.zip"]),
            ("Todos los archivos (*.*)", ["*.*"]));

        if (!string.IsNullOrWhiteSpace(path))
        {
            SelectiveRomPath = path;
            AddLog(LogLevel.Info, $"Contenedor de ROM cargado: {Path.GetFileName(path)}");
            await InspectSelectiveRomAsync();
        }
    }

    [RelayCommand]
    private async Task InspectSelectiveRomAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectiveRomPath) || !File.Exists(SelectiveRomPath))
        {
            AddLog(LogLevel.Warning, "Seleccione un contenedor de ROM válido existente.");
            return;
        }

        IsBusy = true;
        try
        {
            var extractor = new SelectiveRomExtractorService();
            RomPackageInfo info = await Task.Run(() => extractor.InspectRomPackage(SelectiveRomPath));

            Dispatcher.UIThread.Post(() =>
            {
                RomEntries.Clear();
                foreach (var entry in info.Entries)
                {
                    RomEntries.Add(new RomEntryItem
                    {
                        Name = entry.Name,
                        SizeBytes = entry.SizeBytes,
                        FormattedSize = entry.FormattedSize,
                        IsLoader = entry.IsLoader,
                        IsSelected = true
                    });
                }
            });

            RomPackageSummary = $"Formato: {info.Format} | Entradas: {info.TotalEntries} ({info.TotalEstimatedBytes / (1024.0 * 1024.0):F1} MB)";
            AddLog(LogLevel.Success, $"✓ {RomPackageSummary}");
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al inspeccionar ROM: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    [RelayCommand]
    private async Task ExtractOnlyLoadersFromRomAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectiveRomPath) || !File.Exists(SelectiveRomPath))
        {
            AddLog(LogLevel.Warning, "Seleccione primero un contenedor de ROM para extraer loaders.");
            return;
        }

        IsBusy = true;
        try
        {
            AddLog(LogLevel.Info, $"::: EXTRAYENDO SOLO LOADERS EN STREAMING DESDE {Path.GetFileName(SelectiveRomPath)} :::");
            string outDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Assets", "Loaders", "Extracted");
            Directory.CreateDirectory(outDir);

            var extractor = new SelectiveRomExtractorService();
            var progress = new Progress<ProgressRecord>(p =>
            {
                AddLog(LogLevel.Info, $"[EXTRACT] {p.Label}");
            });

            var extracted = await extractor.ExtractLoadersOnlyAsync(SelectiveRomPath, outDir, progress);
            AddLog(LogLevel.Success, $"✓ ¡{extracted.Count} loaders extraídos en menos de 1 segundo!");

            foreach (var file in extracted)
            {
                string fn = Path.GetFileName(file).ToLowerInvariant();
                if (fn.Contains("prog_firehose") || fn.EndsWith(".elf") || fn.EndsWith(".mbn"))
                {
                    QcomFirehosePath = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] Firehose asignado: {Path.GetFileName(file)}");
                }
                else if (fn.Contains("preloader") || fn.Contains("boot0") || fn.Contains("emi"))
                {
                    MtkPreloaderOrRomPath = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] Preloader asignado: {Path.GetFileName(file)}");
                }
                else if (fn.Contains("da.bin") || fn.Contains("da_"))
                {
                    MtkDaPath = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] Download Agent asignado: {Path.GetFileName(file)}");
                }
                else if (fn.Contains("fdl1"))
                {
                    SprdFdl1Path = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] FDL1 asignado: {Path.GetFileName(file)}");
                }
                else if (fn.Contains("fdl2"))
                {
                    SprdFdl2Path = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] FDL2 asignado: {Path.GetFileName(file)}");
                }
                else if (fn.EndsWith(".auth"))
                {
                    MtkAuthPath = file;
                    AddLog(LogLevel.Success, $"[AUTO-ASSIGN] Auth asignado: {Path.GetFileName(file)}");
                }
            }

            ResolvedLoaderStatus = $"✓ {extracted.Count} Loaders extraídos y asignados a pestañas MTK/QCOM/SPRD.";
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al extraer loaders: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    [RelayCommand]
    private void FilterRomEntries(string filterType)
    {
        foreach (var entry in RomEntries)
        {
            entry.IsSelected = filterType switch
            {
                "All" => true,
                "Clear" => false,
                "BootVbmeta" => entry.Name.Contains("boot", StringComparison.OrdinalIgnoreCase) ||
                                entry.Name.Contains("vbmeta", StringComparison.OrdinalIgnoreCase) ||
                                entry.Name.Contains("dtbo", StringComparison.OrdinalIgnoreCase),
                "ModemRf" => entry.Name.Contains("modem", StringComparison.OrdinalIgnoreCase) ||
                             entry.Name.Contains("nvram", StringComparison.OrdinalIgnoreCase) ||
                             entry.Name.Contains("nvdata", StringComparison.OrdinalIgnoreCase) ||
                             entry.Name.Contains("fsg", StringComparison.OrdinalIgnoreCase) ||
                             entry.Name.Contains("sec", StringComparison.OrdinalIgnoreCase),
                "Loaders" => entry.IsLoader,
                _ => true
            };
        }
    }

    [RelayCommand]
    private async Task ExtractSelectedRomEntriesAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectiveRomPath) || !File.Exists(SelectiveRomPath))
        {
            AddLog(LogLevel.Warning, "Seleccione un archivo de firmware ROM primero.");
            return;
        }

        var selected = RomEntries.Where(e => e.IsSelected).Select(e => e.Name).ToList();
        if (selected.Count == 0)
        {
            AddLog(LogLevel.Warning, "No hay ninguna partición seleccionada para extraer.");
            return;
        }

        var folder = await _storageDialogService.OpenFolderDialogAsync("Seleccionar Carpeta para Guardar Particiones Extraídas");
        if (string.IsNullOrWhiteSpace(folder)) return;

        IsBusy = true;
        try
        {
            AddLog(LogLevel.Info, $"::: EXTRAYENDO {selected.Count} PARTICIONES SELECCIONADAS A: {folder} :::");
            var extractor = new SelectiveRomExtractorService();
            var progress = new Progress<ProgressRecord>(p =>
            {
                AddLog(LogLevel.Info, $"[EXTRACT] {p.Label}");
            });

            var result = await extractor.ExtractPartitionsAsync(SelectiveRomPath, selected, folder, progress);
            AddLog(LogLevel.Success, $"✓ Extracción completada con éxito ({result.Count} archivos guardados).");
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al extraer particiones: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }
}
