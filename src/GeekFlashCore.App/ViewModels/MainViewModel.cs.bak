    [RelayCommand]
    private async Task LoadScatterFileAsync()
    {
        if (string.IsNullOrWhiteSpace(ScatterFilePath) || !File.Exists(ScatterFilePath))
        {
            AddLog(LogLevel.Warning, "Ruta de archivo Scatter no válida o inexistente.");
            return;
        }

        IsBusy = true;
        try
        {
            var parts = await _engineService.LoadScatterFileAsync(ScatterFilePath);
            ScatterPartitions.Clear();
            if (parts != null)
            {
                foreach (var p in parts) ScatterPartitions.Add(p);
            }
            HasScatterLoaded = ScatterPartitions.Count > 0;
            long totalBytes = (long)ScatterPartitions.Where(p => p.FileExists).Sum(p => (long)p.PartitionSize);
            ScatterSummary = $"Particiones encontradas: {ScatterPartitions.Count} | Listas para flasheo: {ScatterPartitions.Count(p => p.FileExists)} ({totalBytes / 1024.0 / 1024.0:N1} MB)";
            AddLog(LogLevel.Success, ScatterSummary);
        }
        finally { IsBusy = false; }
    }

    [RelayCommand]
    private void SelectAllScatter()
    {
        foreach (var p in ScatterPartitions) if (p.FileExists) p.IsSelected = true;
    }

    [RelayCommand]
    private void DeselectAllScatter()
    {
        foreach (var p in ScatterPartitions) p.IsSelected = false;
    }

    [RelayCommand]
    private async Task FlashScatterAsync()
    {
        var model = GetOrBuildActiveModel();
        if (!HasScatterLoaded || ScatterPartitions.Count == 0)
        {
            AddLog(LogLevel.Warning, "Debe cargar un archivo Scatter primero antes de flashear.");
            return;
        }

        var toFlash = ScatterPartitions.Where(p => p.IsSelected && p.FileExists).ToList();
        if (toFlash.Count == 0)
        {
            AddLog(LogLevel.Warning, "No hay ninguna partición seleccionada con archivo de imagen existente.");
            return;
        }

        IsBusy = true;
        try
        {
            await _engineService.FlashScatterAsync(model, ScatterFilePath, toFlash, SelectedFlashMode);
            TotalFlashesCount++;
        }
        finally { IsBusy = false; }
    }

