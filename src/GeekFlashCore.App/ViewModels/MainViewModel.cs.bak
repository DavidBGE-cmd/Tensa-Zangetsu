    private string? DetectMtkPort()
    {
        try
        {
            var enumerator = GeekFlashCore.UsbWatcher.UsbEnumeratorFactory.Create();
            foreach (var dev in enumerator.GetDevices())
            {
                if (dev.VendorId == 0x0E8D || (dev.Description != null && dev.Description.Contains("MediaTek", StringComparison.OrdinalIgnoreCase)))
                {
                    string? port = ExtractComPort(dev.FriendlyName) ?? ExtractComPort(dev.Description);
                    if (!string.IsNullOrEmpty(port)) return port;
                }
            }
        }
        catch { }

        if (OperatingSystem.IsWindows())
        {
            try
            {
                using var commKey = Microsoft.Win32.Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");
                if (commKey != null)
                {
                    foreach (var val in commKey.GetValueNames())
                    {
                        if (val.Contains("usb2ser", StringComparison.OrdinalIgnoreCase) ||
                            val.Contains("MTK", StringComparison.OrdinalIgnoreCase) ||
                            val.Contains("MediaTek", StringComparison.OrdinalIgnoreCase))
                        {
                            var port = commKey.GetValue(val)?.ToString();
                            if (!string.IsNullOrEmpty(port)) return port;
                        }
                    }
                }
            }
            catch { }
        }

        var coms = SerialPort.GetPortNames();
        var mtkCom = coms.FirstOrDefault(c => c.Equals("COM9", StringComparison.OrdinalIgnoreCase)) ??
                     coms.FirstOrDefault(c => c.StartsWith("COM", StringComparison.OrdinalIgnoreCase));
        return mtkCom;
    }

    private static string? ExtractComPort(string? text)
    {
        if (string.IsNullOrEmpty(text)) return null;
        int idx = text.IndexOf("(COM", StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
        {
            int end = text.IndexOf(')', idx);
            if (end > idx)
            {
                return text.Substring(idx + 1, end - idx - 1).Trim();
            }
        }
        return null;
    }

    partial void OnPartitionSearchQueryChanged(string value) => FilterPartitions();

    private void FilterPartitions()
    {
        FilteredPartitions.Clear();
        var q = PartitionSearchQuery?.Trim();
        var items = string.IsNullOrWhiteSpace(q)
            ? PartitionList
            : PartitionList.Where(p => p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                                       p.Description.Contains(q, StringComparison.OrdinalIgnoreCase));
        foreach (var item in items) FilteredPartitions.Add(item);
    }

    [RelayCommand]
    private async Task ReadSelectedPartitionAsync()
    {
        if (SelectedPartition == null)
        {
            AddLog(LogLevel.Warning, "Selecciona primero una partición de la tabla GPT.");
            return;
        }

        var model = GetOrBuildActiveModel();
        IsBusy = true;
        try
        {
            string outDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), "GeekFlashDumps");
            Directory.CreateDirectory(outDir);
            string outFile = Path.Combine(outDir, $"{SelectedPartition.Name}.img");
            await _engineService.ReadPartitionAsync(model, SelectedPartition, outFile);
        }
        finally { IsBusy = false; }
    }

    [RelayCommand]
    private async Task WriteSelectedPartitionAsync()
    {
        if (SelectedPartition is null)
        {
            AddLog(LogLevel.Warning, "Selecciona primero una partición de la tabla GPT.");
            return;
        }

        var model = GetOrBuildActiveModel();

        var desktop = Avalonia.Application.Current?.ApplicationLifetime
            as Avalonia.Controls.ApplicationLifetimes.IClassicDesktopStyleApplicationLifetime;
        var mainWindow = desktop?.MainWindow;

        string? selectedFilePath = null;

        if (mainWindow?.StorageProvider != null)
        {
            var files = await mainWindow.StorageProvider.OpenFilePickerAsync(
                new Avalonia.Platform.Storage.FilePickerOpenOptions
                {
                    Title = $"Seleccionar imagen para flashear en '{SelectedPartition.Name}'",
                    AllowMultiple = false,
                    FileTypeFilter =
                    [
                        new Avalonia.Platform.Storage.FilePickerFileType("Imágenes de Partición (*.bin, *.img)")
                        {
                            Patterns = ["*.bin", "*.img"]
                        },
                        Avalonia.Platform.Storage.FilePickerFileTypes.All
                    ]
                });

            if (files.Count == 0)
            {
                AddLog(LogLevel.Info, "Escritura cancelada por el usuario.");
                return;
            }

            selectedFilePath = files[0].Path.LocalPath;
        }
        else
        {
            selectedFilePath = await _storageDialogService.OpenFileDialogAsync(
                $"Seleccionar imagen para flashear en '{SelectedPartition.Name}'",
                ("Imágenes de Partición (*.bin, *.img)", ["*.bin", "*.img"]),
                ("Todos los archivos (*.*)", ["*.*"]));

            if (string.IsNullOrWhiteSpace(selectedFilePath))
            {
                AddLog(LogLevel.Info, "Escritura cancelada por el usuario.");
                return;
            }
        }

        IsBusy = true;
        try
        {
            await _engineService.WritePartitionAsync(model, SelectedPartition, selectedFilePath);
        }
        finally
        {
            IsBusy = false;
        }
    }

