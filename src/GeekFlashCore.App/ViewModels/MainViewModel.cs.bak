    public MainViewModel()
    {
        _engineService = new FlashEngineService();
        _driverToolkitService = new DriverToolkitService();
        _adbFastbootService = new AdbFastbootService();
        _storageDialogService = new StorageDialogService();
        _autoLoaderResolverService = new AutoLoaderResolverService();

        _engineService.LogEmitted += OnEngineLog;
        _engineService.ProgressUpdated += OnEngineProgress;
        _engineService.DeviceChanged += OnDeviceChanged;

        _adbFastbootService.DeviceStateChanged += OnAdbFastbootDeviceChanged;
        _adbFastbootService.OutputEmitted += OnAdbFastbootOutput;

        InitializeCatalog();
        InitializeOtaCatalog();
        InitializeTerminalDefaults();

        _ = _engineService.StartMonitoringAsync();
        _ = _adbFastbootService.StartMonitoringAsync();
        _ = DiagnoseComponentsAsync();

        AddLog(LogLevel.Info, "::: GEEKFLASH PRO • DOTS SUITE INITIALIZED :::");
        AddLog(LogLevel.Info, "Motor multi-chipset activo: MediaTek, Qualcomm 9008, Unisoc SPRD.");
        AddLog(LogLevel.Info, "Monitor de ADB, Fastboot, FastbootD y Recovery en tiempo real iniciado.");
        AddLog(LogLevel.Success, "Listo. Seleccione una herramienta en la barra lateral.");
    }

