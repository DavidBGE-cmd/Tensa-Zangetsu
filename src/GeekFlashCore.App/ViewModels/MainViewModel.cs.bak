    [RelayCommand]
    private async Task ExecuteTerminalInputAsync()
    {
        if (string.IsNullOrWhiteSpace(TerminalInputText)) return;
        string input = TerminalInputText.Trim();
        TerminalInputText = string.Empty;
        AppendTerminal($"$ {input}");

        var parts = input.Split(' ', 2);
        string cmd = parts[0];
        string args = parts.Length > 1 ? parts[1] : "";
        await ExecuteCliCommandAsync(cmd, args);
    }

    [RelayCommand]
    private void ClearTerminal()
    {
        Dispatcher.UIThread.Post(() =>
        {
            TerminalOutputLines.Clear();
            TerminalOutputLines.Add("::: Terminal Limpiado :::");
        });
    }

    private async Task ExecuteCliCommandAsync(string cmd, string args)
    {
        try
        {
            string output = await _adbFastbootService.ExecuteRawCommandAsync(cmd, args);
            if (!string.IsNullOrWhiteSpace(output))
            {
                foreach (var line in output.Split('\n'))
                {
                    if (!string.IsNullOrWhiteSpace(line)) AppendTerminal(line.TrimEnd());
                }
            }
        }
        catch (Exception ex)
        {
            AppendTerminal($"[ERROR]: No se pudo ejecutar '{cmd}': {ex.Message}");
        }
    }

