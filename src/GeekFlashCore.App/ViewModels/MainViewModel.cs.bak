    // ================= DRIVERS TOOLKIT =================
    partial void OnSelectedComponentCategoryChanged(string value) => FilterComponents();

    private void FilterComponents()
    {
        FilteredComponents.Clear();
        var items = SelectedComponentCategory switch
        {
            "🛠️ Runtimes" => SystemComponents.Where(c => c.Category == ComponentCategory.SystemRuntime),
            "⚡ Drivers Chipset" => SystemComponents.Where(c => c.Category == ComponentCategory.ChipsetDriver),
            "📱 Drivers OEM & ADB" => SystemComponents.Where(c => c.Category == ComponentCategory.OemDriver),
            "🔬 Filtros Avanzados" => SystemComponents.Where(c => c.Category == ComponentCategory.AdvancedFilter),
            _ => SystemComponents
        };

        foreach (var item in items)
        {
            FilteredComponents.Add(item);
        }
    }

    [RelayCommand]
    public async Task DiagnoseComponentsAsync()
    {
        IsDiagnosingDrivers = true;
        try
        {
            var results = await _driverToolkitService.DiagnoseAllComponentsAsync();
            SystemComponents.Clear();
            foreach (var r in results)
            {
                SystemComponents.Add(r);
            }
            FilterComponents();

            int installed = SystemComponents.Count(x => x.IsInstalled);
            int total = SystemComponents.Count;
            DriversInstalledCount = installed;
            DriverDiagnosticsSummary = $"{installed} de {total} controladores listos en el sistema.";
            AddLog(LogLevel.Info, $"Diagnóstico de drivers: {DriverDiagnosticsSummary}");
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al diagnosticar drivers: {ex.Message}");
        }
        finally
        {
            IsDiagnosingDrivers = false;
        }
    }

    [RelayCommand]
    public async Task InstallComponentAsync(SystemComponentItem? item)
    {
        if (item == null) return;
        AddLog(LogLevel.Info, $"Iniciando descarga/instalación de {item.Name}...");
        bool ok = await _driverToolkitService.InstallComponentAsync(item, (pct, status) =>
        {
            item.Progress = pct;
            item.StatusMessage = status;
            if (pct >= 100) AddLog(LogLevel.Success, status);
            else if (pct <= 0) AddLog(LogLevel.Error, status);
        });

        if (ok)
        {
            await DiagnoseComponentsAsync();
        }
    }

