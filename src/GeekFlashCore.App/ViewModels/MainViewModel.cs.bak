        await ExecuteCliCommandAsync("fastboot", "reboot fastboot");
    }

    [RelayCommand]
    private async Task RunRebootSystemAsync()
    {
        if (SelectedCmdMode == "ADB Mode")
        {
            AdbCmdCount++;
            AppendTerminal("$ adb reboot");
            await ExecuteCliCommandAsync("adb", "reboot");
