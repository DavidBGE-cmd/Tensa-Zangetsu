    {
        AccentColorHex = colorHex;
        AddLog(LogLevel.Info, $"Color de acento cambiado a {colorHex}");
    }

    // ================= CATALOG LOGIC =================
    private void InitializeCatalog()
    {
        Brands.Clear();
        Brands.Add("Todas");
        foreach (var brand in DeviceCatalogRepository.GetBrands())
        {
            Brands.Add(brand);
        }

        UpdateFilteredModels();
        SelectedModel = FilteredModels.FirstOrDefault();
    }

    private void InitializeOtaCatalog()
    {
        AllOtaModels.Clear();
        // OnePlus
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus 12", "CPH2581 • IN, EU, GLO", "4 Versions", "OnePlus", "#FF1744"));
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus 11", "CPH2449 • IN, EU, NA", "6 Versions", "OnePlus", "#FF1744"));
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus 10 Pro", "NE2213 • Global", "5 Versions", "OnePlus", "#FF1744"));
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus Nord 4", "CPH2663 • IN, EU", "3 Versions", "OnePlus", "#FF1744"));
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus Ace 3 Pro", "PJX110 • CN", "4 Versions", "OnePlus", "#FF1744"));
        AllOtaModels.Add(new OtaPhoneModelCard("OnePlus Open", "CPH2551 • Foldable", "3 Versions", "OnePlus", "#FF1744"));

        // Realme
        AllOtaModels.Add(new OtaPhoneModelCard("realme GT 7 Pro", "RMX5010 • Global", "4 Versions", "Realme", "#FFAB00"));
        AllOtaModels.Add(new OtaPhoneModelCard("realme GT 6", "RMX3851 • Snapdragon 8s", "5 Versions", "Realme", "#FFAB00"));
        AllOtaModels.Add(new OtaPhoneModelCard("realme 13 Pro+", "RMX3921 • Global", "3 Versions", "Realme", "#FFAB00"));
        AllOtaModels.Add(new OtaPhoneModelCard("realme 12+", "RMX3867 • Dimensity", "4 Versions", "Realme", "#FFAB00"));
        AllOtaModels.Add(new OtaPhoneModelCard("realme GT Neo 6", "RMX3852 • CN", "3 Versions", "Realme", "#FFAB00"));

        // OPPO
        AllOtaModels.Add(new OtaPhoneModelCard("OPPO Find X8 Pro", "PKC110 • Dimensity 9400", "4 Versions", "OPPO", "#00E676"));
        AllOtaModels.Add(new OtaPhoneModelCard("OPPO Find N3", "CPH2499 • Global Fold", "5 Versions", "OPPO", "#00E676"));
        AllOtaModels.Add(new OtaPhoneModelCard("OPPO Reno 12 Pro", "CPH2629 • Global", "3 Versions", "OPPO", "#00E676"));
        AllOtaModels.Add(new OtaPhoneModelCard("OPPO Pad 3 Pro", "OPD2401 • Tablet", "2 Versions", "OPPO", "#00E676"));

        FilterOtaModels();
    }

    partial void OnSelectedOtaBrandChanged(string value) => FilterOtaModels();

    private void FilterOtaModels()
    {
        FilteredOtaModels.Clear();
        var matches = AllOtaModels.Where(x => string.Equals(x.Brand, SelectedOtaBrand, StringComparison.OrdinalIgnoreCase)).ToList();
        foreach (var m in matches) FilteredOtaModels.Add(m);
    }

    private void InitializeTerminalDefaults()
    {
        TerminalOutputLines.Clear();
        TerminalOutputLines.Add("$ adb devices");
        TerminalOutputLines.Add("List of devices attached");
        TerminalOutputLines.Add("0947610492810394\tdevice");
        TerminalOutputLines.Add("$ adb shell getprop ro.build.version.release");
        TerminalOutputLines.Add("14");
    }

    partial void OnSearchQueryChanged(string value) => UpdateFilteredModels();
    partial void OnSelectedBrandChanged(string value) => UpdateFilteredModels();

    private void UpdateFilteredModels()
    {
        FilteredModels.Clear();
        var models = string.IsNullOrWhiteSpace(SearchQuery)
            ? DeviceCatalogRepository.GetAll()
            : DeviceCatalogRepository.Search(SearchQuery);

        if (!string.Equals(SelectedBrand, "Todas", StringComparison.OrdinalIgnoreCase))
        {
            models = models.Where(m => string.Equals(m.Brand, SelectedBrand, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        foreach (var m in models)
        {
            FilteredModels.Add(m);
        }

        if (SelectedModel == null || !FilteredModels.Contains(SelectedModel))
        {
            SelectedModel = FilteredModels.FirstOrDefault();
        }
    }

    // ================= HARDWARE & ENGINE EVENTS =================
    private void OnEngineLog(OperationLogEntry entry)
    {
        AddLog(entry.Level, entry.Message);
    }

    private void OnEngineProgress(OperationProgress progress)
    {
        ProgressValue = progress.Percentage;
        ProgressStatus = progress.StatusMessage;
        SpeedInfo = progress.SpeedMbPerSec > 0 ? $"{progress.SpeedMbPerSec:F1} MB/s" : "";
    }

    private void OnAdbFastbootDeviceChanged(AdbFastbootDeviceInfo dev)
    {
        ConnectedDeviceInfo = dev;
        DeviceModeBadgeText = dev.ModeBadgeText;
        DeviceModeColorHex = dev.ModeColorHex;
        DriverAdviceMessage = dev.DriverAdvice;
        HasDriverIssue = !dev.IsDriverOk && dev.Mode != ConnectedDeviceMode.Disconnected;
        ActiveSlotInfo = string.IsNullOrEmpty(dev.ActiveSlot) ? "N/A" : $"Slot {dev.ActiveSlot.ToUpper()}";
        IsUserspaceFastboot = dev.IsUserspace;
        FastbootProduct = dev.ProductCode;

        if (dev.Mode != ConnectedDeviceMode.Disconnected)
        {
            IsDeviceConnected = true;
            ConnectionStatus = dev.ModeBadgeText;
            StatusColorHex = dev.ModeColorHex;
            DevicePortInfo = $"{dev.Serial} • {dev.Brand} {dev.ModelName}";
            DevicesDetectedCount++;
            AddLog(LogLevel.Info, $"[HARDWARE DETECTADO]: {dev.ModeBadgeText} ({dev.Serial})");
            if (!string.IsNullOrWhiteSpace(dev.DriverAdvice))
            {
                AddLog(dev.IsDriverOk ? LogLevel.Info : LogLevel.Warning, $"[CONTROLADOR]: {dev.DriverAdvice}");
            }
        }
        else if (CurrentPage != "Mtk" && CurrentPage != "Qualcomm" && CurrentPage != "Unisoc")
        {
            IsDeviceConnected = false;
            DevicePortInfo = "Ninguno";
            ConnectionStatus = "DISPOSITIVO NO CONECTADO";
            StatusColorHex = "#78909C";
        }
    }

    private void OnAdbFastbootOutput(string text)
    {
        // Ensure UI updates occur on the UI thread
        Dispatcher.UIThread.Post(() => TerminalOutputLines.Add(text));
    }

    private void OnDeviceChanged(DetectedDeviceInfo? device)
    {
        if (device != null && device.IsConnected)
        {
            Dispatcher.UIThread.Post(() =>
            {
                IsDeviceConnected = true;
                DevicePortInfo = $"{device.PortOrUsbPath} • {device.ChipName}";
                ConnectionStatus = $"{device.Description.ToUpper()} DETECTADO";
                StatusColorHex = "#00E676";
                DevicesDetectedCount++;
            });
        }
        else if (ConnectedDeviceInfo.Mode == ConnectedDeviceMode.Disconnected)
        {
            Dispatcher.UIThread.Post(() =>
            {
                IsDeviceConnected = false;
                DevicePortInfo = "Ninguno";
                ConnectionStatus = "DISPOSITIVO NO CONECTADO";
                StatusColorHex = "#78909C";
            });
        }
    }

    private void AddLog(LogLevel level, string message)
    {
        string color = level switch
        {
            LogLevel.Success => "#00E676",
            LogLevel.Warning => "#FFAB00",
            LogLevel.Error => "#FF1744",
            LogLevel.Debug => "#78909C",
            _ => "#ECEFF1"
        };

        string time = DateTime.Now.ToString("HH:mm:ss");
        // Ensure UI updates occur on the UI thread
        Dispatcher.UIThread.Post(() =>
        {
            LogMessages.Add(new LogDisplayItem(time, message, color));
            if (LogMessages.Count > 400) LogMessages.RemoveAt(0);
        });
    }

    [RelayCommand]
    private void ClearLog()
    {
        LogMessages.Clear();
        AddLog(LogLevel.Info, "Consola de registro limpiada.");
    }

    private void AppendTerminal(string line)
    {
        Dispatcher.UIThread.Post(() => TerminalOutputLines.Add(line));
    }

    // ================= CMD STUDIO COMMANDS =================
    [RelayCommand]
    private void ToggleCmdMode(string mode)
    {
        SelectedCmdMode = mode;
        AppendTerminal($"> Modo cambiado a {mode}");
    }

    [RelayCommand]
    private async Task RunAdbDevicesAsync()
    {
        AdbCmdCount++;
        AppendTerminal("$ adb devices");
        await ExecuteCliCommandAsync("adb", "devices");
    }

    [RelayCommand]
    private async Task RunFbDevicesAsync()
    {
        FastbootCmdCount++;
        AppendTerminal("$ fastboot devices");
        await ExecuteCliCommandAsync("fastboot", "devices");
    }

    [RelayCommand]
    private async Task RunDumpLogcatAsync()
    {
        AdbCmdCount++;
        AppendTerminal("$ adb logcat -d -t 100");
        await ExecuteCliCommandAsync("adb", "logcat -d -t 50");
    }

    [RelayCommand]
    private async Task RunGetPropertiesAsync()
    {
        if (SelectedCmdMode == "ADB Mode")
        {
            AdbCmdCount++;
            AppendTerminal("$ adb shell getprop ro.product.model");
            await ExecuteCliCommandAsync("adb", "shell getprop ro.product.model");
        }
        else
        {
            FastbootCmdCount++;
            AppendTerminal("$ fastboot getvar all");
            await ExecuteCliCommandAsync("fastboot", "getvar all");
        }
    }

    [RelayCommand]
    private async Task RunRebootBootloaderAsync()
    {
        AdbCmdCount++;
        AppendTerminal("$ adb reboot bootloader");
        await ExecuteCliCommandAsync("adb", "reboot bootloader");
    }

