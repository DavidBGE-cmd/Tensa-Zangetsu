    private async Task RunRebootRecoveryAsync()
    {
        if (SelectedCmdMode == "ADB Mode")
        {
            AdbCmdCount++;
            AppendTerminal("$ adb reboot recovery");
            await ExecuteCliCommandAsync("adb", "reboot recovery");
        }
        else
        {
            FastbootCmdCount++;
            AppendTerminal("$ fastboot reboot recovery");
            await ExecuteCliCommandAsync("fastboot", "reboot recovery");
