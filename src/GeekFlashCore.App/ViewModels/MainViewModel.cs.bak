    [RelayCommand]
    private async Task ReadSaharaInfoAsync()
    {
        IsBusy = true;
        try
        {
            AddLog(LogLevel.Info, "::: LEYENDO HUELLA SAHARA (HWID + PK HASH) EN MODO EDL 9008 :::");
            var (hwId, pkHash) = await _engineService.ReadSaharaInfoAsync();
            QcomSaharaHwId = hwId;
            QcomSaharaPkHash = pkHash;
            DetectedHardwareSummary = $"Qualcomm Snapdragon • HWID: {hwId}";
            AddLog(LogLevel.Success, $"✓ Huella de Silicio Sahara leída: HWID={hwId} | OEM PK HASH={pkHash}");
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al leer huella Sahara: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    [RelayCommand]
    private async Task ConnectAndReadQcomGptAsync()
    {
        IsBusy = true;
        try
        {
            AddLog(LogLevel.Info, $"::: SUBIENDO FIREHOSE Y LEYENDO GPT MULTI-LUN (Vendor: {SelectedQcomVendor}) :::");
            string? fallback = !string.IsNullOrEmpty(QcomFirehosePath) ? QcomFirehosePath : null;
            var parts = await _engineService.ConnectAndReadQcomGptAsync(
                fallbackRomPath: fallback,
                vendor: SelectedQcomVendor);

            Dispatcher.UIThread.Post(() =>
            {
                PartitionList.Clear();
                if (parts != null)
                {
                    foreach (var p in parts) PartitionList.Add(p);
                }
                FilterPartitions();
            });

            if (parts != null && parts.Count > 0)
            {
                SelectedPartition = parts.FirstOrDefault();
                AddLog(LogLevel.Success, $"✓ ¡Tabla GPT Qualcomm Multi-LUN cargada! Se encontraron {parts.Count} particiones.");
            }
        }
        catch (Exception ex)
        {
            AddLog(LogLevel.Error, $"Error al conectar y leer GPT Qualcomm: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

