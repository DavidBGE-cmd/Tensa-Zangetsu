<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeekFlashCore.App.ViewModels"
        xmlns:cat="using:GeekFlashCore.Services.Catalog"
        xmlns:ops="using:GeekFlashCore.Services.Operations"
        xmlns:drivers="using:GeekFlashCore.Services.Drivers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="860"
        Width="1360" Height="860"
        MinWidth="1180" MinHeight="720"
        x:Class="GeekFlashCore.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GEEKFLASH PRO • FLASHER &amp; SERVICING TOOLKIT (DOTS EDITION)"
        Background="#08090C">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="240,*">

        <!-- ======================================================== -->
        <!-- LEFT SIDEBAR NAVIGATION DRAWER                           -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="#0D0F16" BorderBrush="#1B1F2B" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header Logo & Brand -->
                <Border Grid.Row="0" Padding="18,16" BorderBrush="#181B26" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding AccentColorHex}" VerticalAlignment="Center"/>
                            <TextBlock Text="GEEKFLASH PRO" FontSize="15" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="0.5"/>
                        </StackPanel>
                        <TextBlock Text="DOTS • Android Flashing Toolkit" FontSize="10" Foreground="#78909C"/>
                        <Border Background="#1C1824" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock Text="• v7.2.0 RED DOTS •" FontSize="9" FontWeight="Bold" Foreground="{Binding AccentColorHex}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12" Spacing="2">

                        <!-- SECTION: MAIN -->
                        <TextBlock Text="MAIN" FontSize="9" FontWeight="Bold" Foreground="#546E7A" Margin="10,6,0,4" LetterSpacing="1"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{Binding IsDashboard, Converter={x:Static ObjectConverters.IsNull}}" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📊" FontSize="12"/>
                                <TextBlock Text="Dashboard" FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="DeviceCheck" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📱" FontSize="12"/>
                                <TextBlock Text="Device Check" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="FlashRom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💾" FontSize="12"/>
                                <TextBlock Text="Flash ROM" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="CmdStudio" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💻" FontSize="12"/>
                                <TextBlock Text="CMD Studio (ADB/FB)" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Mtk" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚡" FontSize="12"/>
                                <TextBlock Text="MediaTek BROM/DA" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Qualcomm" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🐉" FontSize="12"/>
                                <TextBlock Text="Qualcomm EDL 9008" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Unisoc" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🛰️" FontSize="12"/>
                                <TextBlock Text="Unisoc / SPRD (BSL)" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <!-- SECTION: OEM BRANDS -->
                        <TextBlock Text="OEM BRANDS" FontSize="9" FontWeight="Bold" Foreground="#546E7A" Margin="10,14,0,4" LetterSpacing="1"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Xiaomi" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🟠" FontSize="12"/>
                                <TextBlock Text="Xiaomi / Redmi / POCO" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Motorola" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔵" FontSize="12"/>
                                <TextBlock Text="Motorola Rescue" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Vivo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🟣" FontSize="12"/>
                                <TextBlock Text="Vivo / iQOO EDL" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Samsung" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔷" FontSize="12"/>
                                <TextBlock Text="Samsung Galaxy (Odin/FB)" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="OtaDownloader" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔴" FontSize="12"/>
                                <TextBlock Text="OnePlus / OPPO / Realme" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <!-- SECTION: TOOLS -->
                        <TextBlock Text="TOOLS" FontSize="9" FontWeight="Bold" Foreground="#546E7A" Margin="10,14,0,4" LetterSpacing="1"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="PayloadDumper" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📦" FontSize="12"/>
                                <TextBlock Text="Payload Dumper" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Imei" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔑" FontSize="12"/>
                                <TextBlock Text="IMEI &amp; NVRAM" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="RemoveFrp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔓" FontSize="12"/>
                                <TextBlock Text="Remove FRP" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="UsbDrivers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔌" FontSize="12"/>
                                <TextBlock Text="USB Drivers" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <!-- SECTION: SYSTEM -->
                        <TextBlock Text="SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#546E7A" Margin="10,14,0,4" LetterSpacing="1"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" Padding="12,8" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙️" FontSize="12"/>
                                <TextBlock Text="Settings &amp; Themes" FontSize="12" FontWeight="SemiBold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Status Indicator -->
                <Border Grid.Row="2" Padding="14,10" Background="#0A0C11" BorderBrush="#181B26" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColorHex}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding DevicePortInfo}" FontSize="11" Foreground="#90A4AE" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN CONTENT AREA (PAGES)                                -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- TOP HEADER BAR (GLOBAL LIVE SILICON & AUTO-MATCH LOADERS) -->
            <Border Grid.Row="0" Background="#0A0C12" Padding="20,10" BorderBrush="#161A26" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Fila 0: Info de Dispositivo, Huella, Checkbox Auto-Match y Botón Destacado -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
                        <!-- Título de Página y Huella de Silicio -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding CurrentPage, StringFormat={}{0}}" FontSize="16" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock Text="HUELLA SILICIO:" FontSize="9" FontWeight="Bold" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding DetectedHardwareSummary}" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Píldora de Dispositivo Conectado -->
                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="#111520" CornerRadius="16" Padding="12,5"
                                BorderBrush="{Binding DeviceModeColorHex}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding DeviceModeColorHex}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectedDeviceInfo.DisplayName, StringFormat='DISPOSITIVO: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#ECEFF1"/>
                                <TextBlock Text="•" FontSize="11" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding DeviceModeBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DeviceModeColorHex}"/>
                            </StackPanel>
                        </Border>

                        <!-- CheckBox Auto-Match Loaders & RAM Patch -->
                        <CheckBox Grid.Column="2" IsChecked="{Binding UseAutoLoaderMatch}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Auto-Match Loaders &amp; RAM Patch" FontSize="11" Foreground="#00E676" FontWeight="SemiBold"/>
                        </CheckBox>

                        <!-- Botón Diagnóstico Rápido -->
                        <Button Grid.Column="3" Command="{Binding DiagnoseComponentsCommand}" Background="#1C2436"
                                Padding="12,7" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔌" FontSize="11"/>
                                <TextBlock Text="Drivers" FontSize="11" FontWeight="Bold" Foreground="#CFD8DC"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Destacado: ANALIZAR EQUIPO + AUTO-MATCH LOADERS -->
                        <Button Grid.Column="4" Command="{Binding AnalyzeAndMatchDeviceCommand}" Background="{Binding AccentColorHex}"
                                Padding="16,8" CornerRadius="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⚡" FontSize="13"/>
                                <TextBlock Text="ANALIZAR EQUIPO + AUTO-MATCH LOADERS" FontSize="11" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Fila 1: Ticker / Estado del Buscador de Loaders -->
                    <Border Grid.Row="1" Background="#06070B" CornerRadius="5" Padding="10,5" BorderBrush="#161B26" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🔍 BUSCADOR DE LOADERS:" FontSize="10" FontWeight="Bold" Foreground="#FFD54F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResolvedLoaderStatus}" FontSize="10" FontFamily="Cascadia Code, Consolas, monospace"
                                       Foreground="#80CBC4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SCROLLABLE PAGE WORKSPACE -->
            <ScrollViewer Grid.Row="1" Padding="24,18" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- ======================================================== -->
                    <!-- 1. DASHBOARD PAGE (BENTO GRID AS SEEN IN VIDEO)          -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsDashboard}" Spacing="16">

                        <!-- Ready To Flash Card -->
                        <Border Background="#10141F" CornerRadius="12" Padding="20" BorderBrush="#1C2336" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Ready to Flash" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Connect an Android device via USB to get started with BROM, Fastboot, or EDL." FontSize="12" Foreground="#90A4AE"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <TextBlock Text="• Status:" FontSize="11" FontWeight="Bold" Foreground="#546E7A"/>
                                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="{Binding StatusColorHex}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding NavigateCommand}" CommandParameter="FlashRom"
                                        Background="#1C2436" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="20" Foreground="{Binding AccentColorHex}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Historical Usage Statistics (Bento Grid) -->
                        <TextBlock Text="HISTORICAL USAGE STATISTICS" FontSize="10" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1" Margin="2,4,0,0"/>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <!-- Bento 1 -->
                            <Border Grid.Column="0" Background="#10141F" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ADB CMDS" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding AdbCmdCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Executed" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 2 -->
                            <Border Grid.Column="1" Background="#10141F" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="FASTBOOT CMDS" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding FastbootCmdCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Executed" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 3 -->
                            <Border Grid.Column="2" Background="#10141F" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="TOTAL FLASHES" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding TotalFlashesCount}" FontSize="20" FontWeight="ExtraBold" Foreground="{Binding AccentColorHex}"/>
                                    <TextBlock Text="Stock &amp; Custom" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 4 -->
                            <Border Grid.Column="3" Background="#10141F" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="OTA DOWNLOADS" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding OtaDownloadsCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Downloaded" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 5 -->
                            <Border Grid.Column="4" Background="#10141F" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="IMEI OPS" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding ImeiOpsCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Backup &amp; Restore" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 6 -->
                            <Border Grid.Column="5" Background="#10141F" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="FRP REMOVALS" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding FrpRemovalsCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#00E676"/>
                                    <TextBlock Text="Completed" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>

                            <!-- Bento 7 -->
                            <Border Grid.Column="6" Background="#10141F" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#1A2030" BorderThickness="1">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DEVICES" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding DevicesDetectedCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#00E5FF"/>
                                    <TextBlock Text="Detected" FontSize="9" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Access Cards Grid -->
                        <TextBlock Text="QUICK ACCESS MODULES" FontSize="10" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1" Margin="2,8,0,0"/>
                        <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">
                            <!-- Card 1: Flash ROM -->
                            <Button Grid.Row="0" Grid.Column="0" Command="{Binding NavigateCommand}" CommandParameter="FlashRom"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="💾 Flash ROM" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Flash Generic / Stock via Fastboot" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 2: CMD Studio -->
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding NavigateCommand}" CommandParameter="CmdStudio"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="💻 CMD Studio" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Run ADB &amp; Fastboot terminal" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 3: MediaTek -->
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding NavigateCommand}" CommandParameter="Mtk"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="⚡ MediaTek Tool" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="BROM Handshake &amp; Scatter" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 4: Qualcomm EDL -->
                            <Button Grid.Row="0" Grid.Column="3" Command="{Binding NavigateCommand}" CommandParameter="Qualcomm"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="🐉 Qualcomm 9008" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="EDL Sahara &amp; Firehose loader" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 5: Unisoc SPRD -->
                            <Button Grid.Row="0" Grid.Column="4" Command="{Binding NavigateCommand}" CommandParameter="Unisoc"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="🛰️ Unisoc (SPD)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="BSL Mode &amp; PAC flasher" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 6: Payload Dumper -->
                            <Button Grid.Row="1" Grid.Column="0" Command="{Binding NavigateCommand}" CommandParameter="PayloadDumper"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="📦 Payload Dumper" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Extract boot/super from payload.bin" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 7: IMEI Backup -->
                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding NavigateCommand}" CommandParameter="Imei"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="🔑 IMEI &amp; NVRAM" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Backup &amp; Restore RF partitions" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 8: Remove FRP -->
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding NavigateCommand}" CommandParameter="RemoveFrp"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="🔓 Remove FRP" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Bypass Factory Reset Protection" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 9: OTA Downloader -->
                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding NavigateCommand}" CommandParameter="OtaDownloader"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="☁️ OTA Downloader" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Find &amp; download official OTAs" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>

                            <!-- Card 10: USB Drivers -->
                            <Button Grid.Row="1" Grid.Column="4" Command="{Binding NavigateCommand}" CommandParameter="UsbDrivers"
                                    Background="#10141F" BorderBrush="#1C2336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="🔌 USB Drivers" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Install low-level &amp; OEM drivers" FontSize="10" Foreground="#78909C"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 2. FLASH ROM PAGE (IDENTICAL TO VIDEO 01:17)             -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsFlashRom}" Spacing="16">

                        <!-- Critical Warning Banner -->
                        <Border Background="#2B0D12" CornerRadius="10" Padding="16" BorderBrush="#59131C" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" FontSize="16"/>
                                    <TextBlock Text="Critical Pre-Flash Check" FontWeight="Bold" FontSize="13" Foreground="#FF5252"/>
                                </StackPanel>
                                <TextBlock Text="• BACK UP all data - this WILL wipe your device!" FontSize="11" Foreground="#FFCDD2"/>
                                <TextBlock Text="• Unlocked Bootloader required • Ensure battery above 60%" FontSize="11" Foreground="#FFCDD2"/>
                                <TextBlock Text="• Do NOT disconnect USB cable during flashing!" FontSize="11" Foreground="#FFCDD2"/>
                            </StackPanel>
                        </Border>

                        <!-- Sub-categories: Port ROM | Stock ROM | Boot Flasher -->
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Target ROM / Images Source" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding RomFolderPath}" Background="#090C12" Foreground="#ECEFF1"
                                             FontSize="11" Padding="10" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Command="{Binding BrowseRomFolderCommand}" Background="#263238" Padding="14,10" CornerRadius="6">
                                        <TextBlock Text="📁 Browse Folder" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                </Grid>

                                <!-- Checkboxes -->
                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <CheckBox IsChecked="{Binding WipeUserdataAfterFlash}">
                                        <TextBlock Text="Wipe userdata + metadata + FRP after flash (Clean Install)" FontSize="11" Foreground="#CFD8DC"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding RunSetupBypassAdb}">
                                        <TextBlock Text="Run Setup Bypass via ADB after flash finishes" FontSize="11" Foreground="#CFD8DC"/>
                                    </CheckBox>
                                </StackPanel>

                                <!-- Action Button -->
                                <Button Command="{Binding StartFlashRomCommand}" IsEnabled="{Binding !IsBusy}"
                                        Background="{Binding AccentColorHex}" HorizontalAlignment="Left" CornerRadius="6" Padding="20,12" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⚡" FontSize="13"/>
                                        <TextBlock Text="Start Flash ROM" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 3. CMD STUDIO PAGE (TERMINAL AS IN VIDEO 01:31)          -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsCmdStudio}" Spacing="16">

                        <!-- Mode Toggle Pill -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="ADB and Fastboot terminal with live streaming output" FontSize="12" Foreground="#90A4AE" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding ToggleCmdModeCommand}" CommandParameter="ADB Mode"
                                        Background="#1C2436" Padding="12,6" CornerRadius="4">
                                    <TextBlock Text="ADB Mode" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Button>
                                <Button Command="{Binding ToggleCmdModeCommand}" CommandParameter="Fastboot Mode"
                                        Background="{Binding AccentColorHex}" Padding="12,6" CornerRadius="4">
                                    <TextBlock Text="Fastboot Mode" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Live Connection, Driver Status & Fastboot-D / Slot Info Bar -->
                        <Border Background="#10141F" CornerRadius="8" Padding="14" BorderBrush="#1C2336" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{Binding DeviceModeColorHex}" CornerRadius="12" Padding="10,4">
                                        <TextBlock Text="{Binding DeviceModeBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    </Border>
                                    <TextBlock Text="{Binding ConnectedDeviceInfo.Serial, StringFormat='ID: {0}'}" FontSize="11" Foreground="#90A4AE" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveSlotInfo}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding DriverAdviceMessage}" FontSize="11" Foreground="#FFD54F"
                                           VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SwitchToFastbootDCommand}" Background="#B71C1C" Padding="10,6" CornerRadius="4">
                                        <TextBlock Text="⚡ Conmutar Fastboot-D" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Command="{Binding SwitchToBootloaderCommand}" Background="#263238" Padding="10,6" CornerRadius="4">
                                        <TextBlock Text="🔄 Bootloader" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Command="{Binding ToggleActiveSlotCommand}" Background="#1A237E" Padding="10,6" CornerRadius="4">
                                        <TextBlock Text="🔁 Alternar Slot A/B" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Command="{Binding UnlockGenericCommand}" Background="#004D40" Padding="10,6" CornerRadius="4">
                                        <TextBlock Text="🔓 Flashing Unlock" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Command="{Binding FixDriverCommand}" Background="#E65100" Padding="10,6" CornerRadius="4"
                                            IsVisible="{Binding HasDriverIssue}">
                                        <TextBlock Text="🛠️ Reparar Driver" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Actions Grid -->
                        <Grid ColumnDefinitions="*,*">
                            <!-- Left: Quick Actions -->
                            <Border Grid.Column="0" Background="#10141F" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="#1C2336" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding RunAdbDevicesCommand}"
                                                Background="#141A28" Margin="0,0,4,6" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="ADB Devices" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="adb devices -l" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="0" Grid.Column="1" Command="{Binding RunFbDevicesCommand}"
                                                Background="#141A28" Margin="4,0,0,6" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="FB Devices" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot devices" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="0" Command="{Binding RunDumpLogcatCommand}"
                                                Background="#141A28" Margin="0,0,4,0" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Dump Logcat" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="adb logcat 100 lines" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding RunGetPropertiesCommand}"
                                                Background="#141A28" Margin="4,0,0,0" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Get Properties" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot getvar all" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right: Power Menu -->
                            <Border Grid.Column="1" Background="#10141F" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="#1C2336" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="POWER MENU" FontSize="10" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding RunRebootBootloaderCommand}"
                                                Background="#141A28" Margin="0,0,4,6" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Reboot Bootloader" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot reboot bootloader" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="0" Grid.Column="1" Command="{Binding RunRebootRecoveryCommand}"
                                                Background="#141A28" Margin="4,0,0,6" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Reboot Recovery" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot reboot recovery" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="0" Command="{Binding RunRebootFastbootdCommand}"
                                                Background="#141A28" Margin="0,0,4,0" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Reboot Fastboot(d)" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot reboot fastboot" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding RunRebootSystemCommand}"
                                                Background="#141A28" Margin="4,0,0,0" Padding="10" CornerRadius="6" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Reboot System" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="fastboot reboot" FontSize="9" Foreground="#78909C"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Interactive Terminal Console Box -->
                        <Border Background="#06070B" CornerRadius="8" Padding="14" BorderBrush="#181D2A" BorderThickness="1">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="TERMINAL CONSOLE (LIVE)" FontSize="10" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                    <Button HorizontalAlignment="Right" Command="{Binding ClearTerminalCommand}" Background="Transparent" BorderThickness="0" Padding="4">
                                        <TextBlock Text="Clear Console" FontSize="10" Foreground="#78909C"/>
                                    </Button>
                                </Grid>

                                <!-- Console output text -->
                                <Border Grid.Row="1" Height="260" Background="#040407" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TerminalOutputLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#00E5FF" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Input Box & Run Button -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding TerminalInputText}" PlaceholderText="e.g. adb devices or fastboot oem unlock"
                                             FontFamily="Cascadia Code, monospace" FontSize="12" Background="#0D1017" Foreground="#FFFFFF"
                                             Padding="10" BorderBrush="#1C2336" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Command="{Binding ExecuteTerminalInputCommand}"
                                            Background="{Binding AccentColorHex}" CornerRadius="6" Padding="18,10">
                                        <TextBlock Text="Run" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 4. USB DRIVERS PAGE (EXACTLY AS IN VIDEO 04:30)          -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsUsbDrivers}" Spacing="16">

                        <!-- Admin Elevation Warning Box -->
                        <Border Background="#16140D" CornerRadius="8" Padding="14" BorderBrush="#3D3318" BorderThickness="1">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🛡️" FontSize="13"/>
                                    <TextBlock Text="Admin Elevation Required" FontWeight="Bold" FontSize="12" Foreground="#FFD54F"/>
                                </StackPanel>
                                <TextBlock Text="Driver installers launch with UAC elevation (ShellExecute runas). Follow the Windows wizard prompts."
                                           FontSize="11" Foreground="#FFF8E1"/>
                            </StackPanel>
                        </Border>

                        <!-- Clean COM Ports Action -->
                        <Border Background="#10141F" CornerRadius="8" Padding="14" BorderBrush="#1C2336" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="🧹 Limpiador de Puertos COM Fantasma (Windows ComDB)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Restablece el registro ComDB y desasigna puertos huérfanos (COM15, COM42...) para evitar conflictos de asignación."
                                               FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding ComCleanupStatus}" FontSize="10" Foreground="#00E676" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CleanComPortsCommand}" Background="#C62828" CornerRadius="6" Padding="14,10" VerticalAlignment="Center">
                                    <TextBlock Text="Limpiar Puertos COM" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Horizontal Cards for Each Driver -->
                        <ItemsControl ItemsSource="{Binding FilteredComponents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="drivers:SystemComponentItem">
                                    <Border Width="340" Background="#10141F" CornerRadius="10" Padding="16" Margin="0,0,12,12" BorderBrush="#1C2336" BorderThickness="1">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            <!-- Title & Badge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#90A4AE" Height="36" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- Progress if busy -->
                                            <ProgressBar Grid.Row="2" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                         IsVisible="{Binding IsBusy}" Foreground="#00E5FF" Margin="0,0,0,6"/>

                                            <!-- Install Button -->
                                            <Button Grid.Row="3" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).InstallComponentCommand}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding !IsBusy}"
                                                    Background="{Binding $parent[Window].((vm:MainViewModel)DataContext).AccentColorHex}"
                                                    CornerRadius="6" Padding="14,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="⚡" FontSize="11"/>
                                                    <TextBlock Text="{Binding ActionText}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 5. MEDIATEK SERVICE (V5 XFLASH & V6 XML + PENUMBRA)      -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsMtk}" Spacing="16">

                        <!-- PANEL A: LOADERS & PENUMBRA ENGINE -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="PANEL A • DOWNLOAD AGENTS &amp; PENUMBRA ENGINE" FontSize="12" FontWeight="ExtraBold" Foreground="#00E5FF" LetterSpacing="1"/>
                                        <TextBlock Text="Soporte unificado DA V5 (XFlash) y V6 (XML) con parcheo en RAM y bypass SLA/DAA" FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#162238" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="BROM / PRELOADER" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                </Grid>

                                <!-- Grid de Selectores de Archivos -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                    <!-- 1. Download Agent -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Spacing="4">
                                        <TextBlock Text="DOWNLOAD AGENT (DA V5 / V6):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding MtkDaPath}" PlaceholderText="Seleccione MTK_AllInOne_DA.bin o DA V5/V6..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseMtkDaCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="⚡ DA..." FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 2. Preloader / EMI / ROM -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Spacing="4">
                                        <TextBlock Text="PRELOADER / EMI O ROM PARA BROM:" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding MtkPreloaderOrRomPath}" PlaceholderText="preloader.bin, boot0.bin o ROM (.ofp/.pac/payload.bin)..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseMtkPreloaderOrRomCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 Preloader..." FontSize="11" FontWeight="Bold" Foreground="#FFD54F"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 3. Scatter File -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                                        <TextBlock Text="SCATTER FILE (OPCIONAL PARA MAPA V5):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding MtkScatterPath}" PlaceholderText="*_Android_scatter.txt..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseMtkScatterCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📄 Scatter..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 4. Auth File -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                                        <TextBlock Text="AUTH FILE (SLA / DAA CERTIFICADO):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding MtkAuthPath}" PlaceholderText="auth_sv5.auth / MT6768_AUTH.bin..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseMtkAuthCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="🔑 Auth..." FontSize="11" FontWeight="Bold" Foreground="#FFD54F"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- CheckBoxes Penumbra, EMI, Boot0 -->
                                <Border Background="#090B10" CornerRadius="8" Padding="12" Margin="0,6,0,0" BorderBrush="#181D2A" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <CheckBox IsChecked="{Binding EnablePenumbraRamPatch}">
                                            <TextBlock Text="Parchear DA1/DA2 en RAM (Penumbra V5/V6: Bypass SLA, DAA, SBC y Anti-Rollback)" FontSize="11" Foreground="#00E676" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding EnableBromEmiInjection}">
                                            <TextBlock Text="Extraer e Inyectar EMI/DRAM si el equipo está muerto en BROM" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding EnableAutoBoot0Harvest}">
                                            <TextBlock Text="Auto-Cosechar Preloader y EMI desde boot0 al conectar" FontSize="11" Foreground="#FFD54F" FontWeight="SemiBold"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PANEL B: ACCIONES DIRECTAS SIN DEPENDER DE SCATTER -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="PANEL B • OPERACIONES DIRECTAS DE DISPOSITIVO (SIN DEPENDER DE SCATTER)" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1"/>
                                        <TextBlock Text="Ejecución directa en memoria física: lectura de GPT, cosecha de preloader y respaldo de seguridad RF." FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>

                                    <!-- Insignia de Estado de Conexión MTK -->
                                    <Border Grid.Column="1" Background="#0A0F1A" CornerRadius="14" Padding="12,5" BorderBrush="#1F283E" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding IsMtkDeviceConnected, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MtkConnectedPortInfo, FallbackValue='Sin Conexión'}" FontSize="10" FontWeight="Bold" Foreground="#ECEFF1"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- TARJETA DE CONTROL DE CONEXIÓN Y BYPASS BROM -->
                                <!-- Estado 1: Desconectado - Botón para iniciar conexión -->
                                <Border IsVisible="{Binding ShowMtkStartButton}" Background="#0B1324" CornerRadius="8" Padding="14,12" BorderBrush="#00E5FF" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚡" FontSize="16"/>
                                                <TextBlock Text="INICIAR CONEXIÓN BROM &amp; BYPASS PENUMBRA" FontSize="12" FontWeight="ExtraBold" Foreground="#00E5FF"/>
                                            </StackPanel>
                                            <TextBlock Text="Pulse para iniciar la escucha de puerto COM, handshake BROM, apagado de Watchdog y bypass de seguridad SLA/DAA."
                                                       FontSize="11" Foreground="#90A4AE"/>
                                            <TextBlock Text="{Binding MtkConnectionStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding StartMtkConnectionCommand}" IsEnabled="{Binding !IsBusy}"
                                                Background="#00E5FF" Foreground="#000000" CornerRadius="6" Padding="18,12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚡" FontSize="14" FontWeight="ExtraBold" Foreground="#000000"/>
                                                <TextBlock Text="CONECTAR DISPOSITIVO" FontSize="11" FontWeight="ExtraBold" Foreground="#000000"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Estado 2: Esperando Dispositivo -->
                                <Border IsVisible="{Binding IsWaitingForMtkDevice}" Background="#1F1809" CornerRadius="8" Padding="14,12" BorderBrush="#FFD54F" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⏳" FontSize="16"/>
                                                <TextBlock Text="ESPERANDO DISPOSITIVO EN BROM O PRELOADER..." FontSize="12" FontWeight="ExtraBold" Foreground="#FFD54F"/>
                                            </StackPanel>
                                            <TextBlock Text="Conecte el dispositivo APAGADO al cable USB manteniendo presionado Vol- (o ambos botones de volumen)." FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding MtkConnectionStatusText}" FontSize="10" Foreground="#ECEFF1" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding CancelMtkConnectionCommand}"
                                                Background="#37474F" Foreground="#FFFFFF" CornerRadius="6" Padding="14,10" VerticalAlignment="Center">
                                            <TextBlock Text="✖ CANCELAR ESPERA" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Estado 3: Conectado con Éxito -->
                                <Border IsVisible="{Binding IsMtkDeviceConnected}" Background="#0C1D18" CornerRadius="8" Padding="14,12" BorderBrush="#00E676" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="✓" FontSize="16" Foreground="#00E676"/>
                                                <TextBlock Text="DISPOSITIVO CONECTADO Y BYPASS PENUMBRA ACTIVO" FontSize="12" FontWeight="ExtraBold" Foreground="#00E676"/>
                                                <Border Background="#163828" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MtkConnectedPortInfo}" FontSize="10" FontWeight="Bold" Foreground="#00E676"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MtkConnectionStatusText}" FontSize="11" Foreground="#A5D6A7"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding DisconnectMtkCommand}"
                                                Background="#263238" Foreground="#ECEFF1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                                            <TextBlock Text="🔄 RECONECTAR" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- BOTONES DE OPERACIONES DIRECTAS -->
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Command="{Binding ReadGptCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#141E33" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,4,0" Padding="12,12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🚀 SUBIR DA + GPT" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Penumbra RAM Patch + GPT" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding HarvestBoot0PreloaderCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#1E1E14" BorderBrush="#FFD54F" BorderThickness="1" Margin="2,0,2,0" Padding="12,12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="📥 COSECHAR BOOT0" FontWeight="Bold" FontSize="11" Foreground="#FFD54F" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Extraer Preloader de boot0" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Command="{Binding BackupRfCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#12241A" BorderBrush="#00E676" BorderThickness="1" Margin="2,0,2,0" Padding="12,12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🛡️ RESPALDAR RF" FontWeight="Bold" FontSize="11" Foreground="#00E676" HorizontalAlignment="Center"/>
                                            <TextBlock Text="NVRAM / NVDATA / NVCFG" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3" Command="{Binding StartMtkScatterFlashCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="{Binding AccentColorHex}" Margin="4,0,0,0" Padding="12,12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔥 FLASHEAR SCATTER" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Ejecutar Flasheo Completo" FontSize="9" Foreground="#ECEFF1" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PANEL C: TABLA GPT INTERACTIVA INTEGRADA -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="PANEL C • TABLA DE PARTICIONES GPT EN VIVO" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1"/>
                                        <TextBlock Text="Lectura física en streaming de la tabla de particiones desde el dispositivo" FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>

                                    <!-- Buscador de particiones -->
                                    <TextBox Grid.Column="1" Text="{Binding PartitionSearchQuery}" PlaceholderText="Filtrar (ej. boot, nvram, super)..."
                                             Background="#0A0D14" Foreground="#FFFFFF" FontSize="11" Padding="8,4" Width="200" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Command="{Binding ReadGptCommand}" Background="#1C2436" Padding="10,6" CornerRadius="6" VerticalAlignment="Center">
                                        <TextBlock Text="🔄 Refrescar GPT" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                </Grid>

                                <!-- Lista / Tabla de Particiones -->
                                <Border Background="#06070B" CornerRadius="8" Padding="6" BorderBrush="#181D2A" BorderThickness="1" Height="220">
                                    <ListBox ItemsSource="{Binding FilteredPartitions}" SelectedItem="{Binding SelectedPartition}" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="ops:PartitionItem">
                                                <Grid ColumnDefinitions="140,160,110,120,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LbaRange}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#78909C" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding OffsetHex}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#80CBC4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Description}" FontSize="10" Foreground="#546E7A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Botones de Acción de Partición Seleccionada -->
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Command="{Binding ReadSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#141E33" Padding="12,8" CornerRadius="6" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="💾 Volcar (Read) Seleccionada" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding WriteSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#2B1414" Padding="12,8" CornerRadius="6" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="📤 Escribir (.img / .bin)..." FontSize="11" FontWeight="Bold" Foreground="#FF5252"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding EraseSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#211818" Padding="12,8" CornerRadius="6" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="🗑️ Borrar (Erase)" FontSize="11" FontWeight="Bold" Foreground="#FF8A80"/>
                                    </Button>
                                    <Button Grid.Column="3" Command="{Binding DumpFullRomCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#182A1C" Padding="12,8" CornerRadius="6" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="📦 Dump ROM Completa (Sin Userdata)" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 6. QUALCOMM EDL 9008 PAGE (SAHARA + FIREHOSE)            -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsQualcomm}" Spacing="16">

                        <!-- Telemetría Sahara (HWID, PK Hash, Almacenamiento) -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="TELEMETRÍA SAHARA &amp; SILICÓN QUALCOMM (EDL 9008)" FontSize="12" FontWeight="ExtraBold" Foreground="#00E5FF" LetterSpacing="1"/>
                                        <TextBlock Text="Huella criptográfica y hardware detectada en modo de emergencia HS-USB QDLoader 9008" FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding ReadSaharaInfoCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#1C2436" Padding="12,7" CornerRadius="6">
                                        <TextBlock Text="🔍 Leer Huella Sahara" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <Border Grid.Column="0" Background="#0A0D14" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#1F2638" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SAHARA HWID (SOC ID):" FontSize="9" FontWeight="Bold" Foreground="#546E7A"/>
                                            <TextBlock Text="{Binding QcomSaharaHwId}" FontFamily="Consolas, monospace" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0A0D14" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="#1F2638" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="OEM PK HASH (CERTIFICADO ROOT):" FontSize="9" FontWeight="Bold" Foreground="#546E7A"/>
                                            <TextBlock Text="{Binding QcomSaharaPkHash}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Bold" Foreground="#FFD54F" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#0A0D14" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#1F2638" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="TIPO DE ALMACENAMIENTO:" FontSize="9" FontWeight="Bold" Foreground="#546E7A"/>
                                            <TextBlock Text="{Binding QcomStorageType}" FontSize="12" FontWeight="Bold" Foreground="#00E676"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Configuración Firehose & Scripts XML -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PROGRAMADOR FIREHOSE &amp; PARTICIONES XML" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="FIREHOSE PROGRAMMER (.ELF / .MBN):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding QcomFirehosePath}" PlaceholderText="prog_firehose_ddr.elf / prog_emmc_firehose_*.mbn..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseQcomFirehoseCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 Firehose..." FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" Width="180">
                                        <TextBlock Text="ESTRATEGIA VENDOR:" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <ComboBox ItemsSource="{Binding QcomVendorList}" SelectedItem="{Binding SelectedQcomVendor}"
                                                  Background="#1C2436" Foreground="#FFFFFF" FontSize="11" Height="36" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                                        <TextBlock Text="RAWPROGRAM XML (rawprogram0.xml):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding QcomRawProgramXmlPath}" PlaceholderText="rawprogram0.xml..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseQcomRawProgramCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 RawProgram..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                                        <TextBlock Text="PATCH XML (patch0.xml):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding QcomPatchXmlPath}" PlaceholderText="patch0.xml..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseQcomPatchXmlCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 Patch..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Botones de Operación Qualcomm -->
                                <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,0">
                                    <Button Grid.Column="0" Command="{Binding ConnectAndReadQcomGptCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#141E33" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,4,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🚀 SUBIR FIREHOSE + GPT" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Lectura de LUN0..LUN5" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding BackupQcomEfsCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#12241A" BorderBrush="#00E676" BorderThickness="1" Margin="2,0,2,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🛡️ RESPALDAR EFS" FontWeight="Bold" FontSize="11" Foreground="#00E676" HorizontalAlignment="Center"/>
                                            <TextBlock Text="modemst1, modemst2, fsg" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Command="{Binding FlashQcomRawProgramCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="{Binding AccentColorHex}" Margin="4,0,0,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔥 FLASHEAR RAWPROGRAM" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Flasheo XML de bajo nivel" FontSize="9" Foreground="#ECEFF1" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Visor GPT Multi-LUN para Qualcomm -->
                        <Border Background="#10141F" CornerRadius="10" Padding="16" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="PARTICIONES GPT MULTI-LUN DETECTADAS" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding PartitionSearchQuery}" PlaceholderText="Filtrar partición..."
                                             Background="#0A0D14" Foreground="#FFFFFF" FontSize="11" Padding="8,4" Width="180" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Command="{Binding ConnectAndReadQcomGptCommand}" Background="#1C2436" Padding="10,6" CornerRadius="6">
                                        <TextBlock Text="🔄 Refrescar LUNs" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                </Grid>

                                <Border Background="#06070B" CornerRadius="8" Padding="6" BorderBrush="#181D2A" BorderThickness="1" Height="200">
                                    <ListBox ItemsSource="{Binding FilteredPartitions}" SelectedItem="{Binding SelectedPartition}" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="ops:PartitionItem">
                                                <Grid ColumnDefinitions="140,160,110,120,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LbaRange}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#78909C" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding OffsetHex}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#80CBC4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Description}" FontSize="10" Foreground="#546E7A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <Grid ColumnDefinitions="*,*,*">
                                    <Button Grid.Column="0" Command="{Binding ReadSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#141E33" Padding="12,8" CornerRadius="6" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="💾 Volcar (Read) LUN/Partición" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding WriteSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#2B1414" Padding="12,8" CornerRadius="6" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="📤 Escribir (.img / .bin)..." FontSize="11" FontWeight="Bold" Foreground="#FF5252"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding EraseSelectedPartitionCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#211818" Padding="12,8" CornerRadius="6" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <TextBlock Text="🗑️ Borrar (Erase)" FontSize="11" FontWeight="Bold" Foreground="#FF8A80"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 7. UNISOC / SPREADTRUM PAGE (BSL + FDL1 / FDL2)          -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsUnisoc}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="UNISOC / SPREADTRUM BSL PROTOCOL &amp; .PAC WORKSTATION" FontSize="13" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1"/>
                                        <TextBlock Text="Soporte BSL U2S Diag con salto FDL1/FDL2 para procesadores T606, T612, T616, SC9863A y SC7731" FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding DetectSprdChipCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#1C2436" Padding="12,7" CornerRadius="6">
                                        <TextBlock Text="⚡ Detectar Chip SPD + Auto-FDL" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                </Grid>

                                <!-- FDL1 y Dirección -->
                                <Grid ColumnDefinitions="*,160" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="FDL1 LOADER (.BIN):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SprdFdl1Path}" PlaceholderText="fdl1.bin..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseSprdFdl1Command}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 FDL1..." FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="DIRECCIÓN FDL1 HEX:" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <TextBox Text="{Binding SprdFdl1Address}" FontFamily="Consolas, monospace"
                                                 Background="#0A0D14" Foreground="#FFD54F" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>

                                <!-- FDL2 y Dirección -->
                                <Grid ColumnDefinitions="*,160" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="FDL2 LOADER (.BIN):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SprdFdl2Path}" PlaceholderText="fdl2.bin..."
                                                     Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseSprdFdl2Command}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                                <TextBlock Text="📁 FDL2..." FontSize="11" FontWeight="Bold" Foreground="#FFD54F"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="DIRECCIÓN FDL2 HEX:" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                        <TextBox Text="{Binding SprdFdl2Address}" FontFamily="Consolas, monospace"
                                                 Background="#0A0D14" Foreground="#FFD54F" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Paquete .PAC -->
                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                    <TextBlock Text="PAQUETE DE FIRMWARE (.PAC):" FontSize="10" FontWeight="Bold" Foreground="#546E7A"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SprdPacFilePath}" PlaceholderText="Seleccione paquete de firmware Unisoc (*.PAC)..."
                                                 Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="8" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseSprdPacCommand}" Background="#1C2436" Padding="10,8" CornerRadius="6">
                                            <TextBlock Text="📁 Archivo .PAC..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Botones de Acción Unisoc -->
                                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                                    <Button Grid.Column="0" Command="{Binding SendFdlAndReadGptCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="#141E33" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,6,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🚀 ENVIAR FDL1/FDL2 + LEER GPT" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Handshake BSL e inicialización RAM" FontSize="9" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding FlashSprdPacCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="{Binding AccentColorHex}" Margin="6,0,0,0" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔥 FLASHEAR PAQUETE .PAC" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Flasheo de Firmware en Modo BSL" FontSize="9" Foreground="#ECEFF1" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 8. OEM: XIAOMI / POCO PAGE                               -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsXiaomi}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Xiaomi / Redmi / POCO Specialized Services" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Verificación de Anti-Rollback (ARB) para evitar Hard-Bricks, lectura de Codename, bypass de asistente MIUI/HyperOS y modo Mi Assistant." FontSize="11" Foreground="#90A4AE"/>

                                <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Command="{Binding GetXiaomiArbCommand}" Background="#141A28" Margin="0,0,4,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="⚡ Verificar ARB" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="fastboot getvar anti" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding GetXiaomiProductAndTokenCommand}" Background="#141A28" Margin="2,0,2,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="📱 Codename &amp; Token" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="getvar product / token" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding BypassXiaomiSetupCommand}" Background="#141A28" Margin="2,0,2,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🪄 Bypass Setup Wizard" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="adb shell disable wizard" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Command="{Binding RebootXiaomiSideloadCommand}" Background="#141A28" Margin="4,0,0,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔄 Mi Assistant Sideload" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="adb reboot recovery" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Output Log Box -->
                                <Border Background="#06070B" CornerRadius="6" Padding="12" Margin="0,4,0,0" BorderBrush="#161B26" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RESULTADO DE OPERACIÓN XIAOMI:" FontSize="9" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                        <TextBlock Text="{Binding XiaomiOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#00E5FF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 9. OEM: MOTOROLA PAGE                                    -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsMotorola}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Motorola Rescue &amp; Bootloader Workstation" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Extracción de Unlock Data (5 líneas unificadas y copiadas al portapapeles), reinicio directo a Qualcomm EDL 9008 y diagnóstico de hardware." FontSize="11" Foreground="#90A4AE"/>

                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Command="{Binding GetMotorolaUnlockDataCommand}" Background="#141A28" Margin="0,0,4,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔓 Obtener Unlock Data" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Une 5 líneas en 1 código único" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding RebootMotorolaEdlCommand}" Background="#141A28" Margin="2,0,2,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="⚡ Reboot a EDL 9008" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="fastboot oem reboot-edl" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding GetMotorolaInfoCommand}" Background="#141A28" Margin="4,0,0,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="📦 Info Hardware &amp; CID" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="getvar ro.build / channelid" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Unlock Execution Bar -->
                                <Border Background="#090B10" CornerRadius="6" Padding="12" BorderBrush="#181D2A" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DESBLOQUEAR BOOTLOADER CON CLAVE OFICIAL MOTOROLA:" FontSize="10" FontWeight="Bold" Foreground="#546E7A" Margin="0,0,0,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MotorolaUnlockKey}" PlaceholderText="Pegue aquí el código recibido por correo..."
                                                 FontFamily="Cascadia Code, monospace" FontSize="11" Background="#040508" Foreground="#FFFFFF"
                                                 Padding="10" BorderBrush="#1C2336" CornerRadius="6" Margin="0,0,8,0"/>
                                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding UnlockMotorolaCommand}" Background="#FF1744" Padding="16,10" CornerRadius="6">
                                            <TextBlock Text="🔓 Desbloquear" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Output Log Box -->
                                <Border Background="#06070B" CornerRadius="6" Padding="12" BorderBrush="#161B26" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RESULTADO DE OPERACIÓN MOTOROLA:" FontSize="9" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                        <TextBlock Text="{Binding MotorolaOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#00E5FF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 10. OEM: SAMSUNG GALAXY PAGE                             -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsSamsung}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Samsung Galaxy Servicing &amp; Protocol Workstation" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Reinicio a Modo Descarga (Odin / Loke), conmutación a FastbootD en Android 10+ y lectura de código CSC de región." FontSize="11" Foreground="#90A4AE"/>

                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Command="{Binding RebootSamsungDownloadCommand}" Background="#141A28" Margin="0,0,4,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="🔵 Reboot Download Mode" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="adb reboot download (Odin)" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding RebootSamsungFastbootDCommand}" Background="#141A28" Margin="2,0,2,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="⚡ Reboot Fastboot-D" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="adb reboot fastboot" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding GetSamsungInfoCommand}" Background="#141A28" Margin="4,0,0,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="📋 Leer CSC &amp; PDA" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="getprop ro.csc.sales_code" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Output Log Box -->
                                <Border Background="#06070B" CornerRadius="6" Padding="12" BorderBrush="#161B26" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RESULTADO DE OPERACIÓN SAMSUNG:" FontSize="9" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                        <TextBlock Text="{Binding SamsungOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#00E5FF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 11. OEM: VIVO / IQOO PAGE                                -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsVivo}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Vivo &amp; iQOO Servicing Workstation" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Reinicio a EDL 9008 desde Vivo Fastboot y consulta de propiedades propietarias BBK." FontSize="11" Foreground="#90A4AE"/>

                                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Command="{Binding RebootVivoEdlCommand}" Background="#141A28" Margin="0,0,4,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="⚡ Fastboot to EDL 9008" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="fastboot oem reboot-edl" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding GetVivoInfoCommand}" Background="#141A28" Margin="4,0,0,0" Padding="12" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="📱 Info Vivo Fastboot" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="getvar product / oem info" FontSize="9" Foreground="#78909C"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Output Log Box -->
                                <Border Background="#06070B" CornerRadius="6" Padding="12" BorderBrush="#161B26" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RESULTADO DE OPERACIÓN VIVO:" FontSize="9" FontWeight="Bold" Foreground="#546E7A" LetterSpacing="1"/>
                                        <TextBlock Text="{Binding VivoOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#00E5FF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 11. OTA DOWNLOADER (AS IN VIDEO 02:27)                   -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsOtaDownloader}" Spacing="16">
                        <!-- Brand Selector Pill Bar -->
                        <Border Background="#10141F" CornerRadius="8" Padding="10" BorderBrush="#1C2336" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Seleccionar Marca:" FontSize="11" FontWeight="Bold" Foreground="#78909C" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding SelectedOtaBrand}" Background="#1A2234" Foreground="#FFFFFF" FontSize="11" Height="30">
                                        <x:String>OnePlus</x:String>
                                        <x:String>Realme</x:String>
                                        <x:String>OPPO</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <TextBox Grid.Column="1" PlaceholderText="Buscar modelo (ej. OnePlus 12)..." Background="#0B0D14" Foreground="#ECEFF1"
                                         FontSize="11" Padding="8,5" Width="220" BorderBrush="#1C2336" CornerRadius="4"/>
                            </Grid>
                        </Border>

                        <!-- Cards Grid for Phone Models -->
                        <ItemsControl ItemsSource="{Binding FilteredOtaModels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OtaPhoneModelCard">
                                    <Border Width="340" Background="#10141F" CornerRadius="8" Padding="14" Margin="0,0,10,10" BorderBrush="#1C2336" BorderThickness="1">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Code}" FontSize="10" Foreground="#78909C" Margin="0,2,0,8"/>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                <Border Grid.Column="0" Background="#192233" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Versions}" FontSize="9" FontWeight="Bold" Foreground="#80CBC4"/>
                                                </Border>
                                                <Button Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="4" Padding="10,4">
                                                    <TextBlock Text="Configure" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 12. EXTRACTOR SELECTIVO DE ROM & LOADERS EN STREAMING    -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsPayloadDumper}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="EXTRACTOR SELECTIVO DE ROM &amp; LOADERS EN STREAMING" FontSize="13" FontWeight="ExtraBold" Foreground="#FFFFFF" LetterSpacing="1"/>
                                        <TextBlock Text="Abre contenedores .ofp, .ops, .pac, .ozip y payload.bin para inspeccionar y extraer particiones o loaders sin descomprimir gigabytes" FontSize="11" Foreground="#90A4AE"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#162238" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="FAST STREAMING ENGINE" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                </Grid>

                                <!-- Selector de Archivo ROM -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding SelectiveRomPath}" PlaceholderText="Seleccione paquete .ofp, .ops, .pac, .ozip o payload.bin..."
                                             Background="#0A0D14" Foreground="#ECEFF1" FontSize="11" Padding="10" BorderBrush="#1F2638" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Command="{Binding BrowseSelectiveRomCommand}" Background="#1C2436" Padding="14,10" CornerRadius="6" Margin="0,0,8,0">
                                        <TextBlock Text="📁 Cargar ROM..." FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding InspectSelectiveRomCommand}" Background="#263238" Padding="14,10" CornerRadius="6">
                                        <TextBlock Text="🔍 Inspeccionar" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Button>
                                </Grid>

                                <!-- Botón Destacado: EXTRAER SOLO LOADERS EN STREAMING (<1s) -->
                                <Border Background="#0D1626" CornerRadius="8" Padding="14" BorderBrush="#00E5FF" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚡" FontSize="14"/>
                                                <TextBlock Text="EXTRACCIÓN INSTANTÁNEA DE LOADERS" FontWeight="Bold" FontSize="12" Foreground="#00E5FF"/>
                                            </StackPanel>
                                            <TextBlock Text="Extrae en menos de 1 segundo los loaders (Preloader, EMI, Firehose, FDL1/FDL2) y los asigna automáticamente a las pestañas MTK, Qualcomm y UNISOC."
                                                       FontSize="11" Foreground="#90A4AE"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ExtractOnlyLoadersFromRomCommand}" IsEnabled="{Binding !IsBusy}"
                                                Background="#00E5FF" CornerRadius="6" Padding="16,10" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ EXTRAER SOLO LOADERS" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Resumen del Paquete y Barra de Filtros -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding RomPackageSummary}" FontSize="11" FontWeight="Bold" Foreground="#80CBC4" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button Command="{Binding FilterRomEntriesCommand}" CommandParameter="All" Background="#141A26" Padding="10,6" CornerRadius="4">
                                            <TextBlock Text="Seleccionar Todo" FontSize="10" Foreground="#ECEFF1"/>
                                        </Button>
                                        <Button Command="{Binding FilterRomEntriesCommand}" CommandParameter="Clear" Background="#141A26" Padding="10,6" CornerRadius="4">
                                            <TextBlock Text="Limpiar" FontSize="10" Foreground="#ECEFF1"/>
                                        </Button>
                                        <Button Command="{Binding FilterRomEntriesCommand}" CommandParameter="BootVbmeta" Background="#141A26" Padding="10,6" CornerRadius="4">
                                            <TextBlock Text="Solo Boot / Vbmeta" FontSize="10" Foreground="#00E5FF"/>
                                        </Button>
                                        <Button Command="{Binding FilterRomEntriesCommand}" CommandParameter="ModemRf" Background="#141A26" Padding="10,6" CornerRadius="4">
                                            <TextBlock Text="Solo Modem / RF" FontSize="10" Foreground="#00E676"/>
                                        </Button>
                                        <Button Command="{Binding FilterRomEntriesCommand}" CommandParameter="Loaders" Background="#141A26" Padding="10,6" CornerRadius="4">
                                            <TextBlock Text="Solo Loaders" FontSize="10" Foreground="#FFD54F"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Lista de Entradas de la ROM -->
                                <Border Background="#06070B" CornerRadius="8" Padding="6" BorderBrush="#181D2A" BorderThickness="1" Height="260">
                                    <ListBox ItemsSource="{Binding RomEntries}" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RomEntryItem">
                                                <Grid ColumnDefinitions="36,*,120,110">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Background="#1A2D2F" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" IsVisible="{Binding IsLoader}" VerticalAlignment="Center">
                                                        <TextBlock Text="LOADER" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Botón Extraer Particiones Seleccionadas -->
                                <Button Command="{Binding ExtractSelectedRomEntriesCommand}" IsEnabled="{Binding !IsBusy}"
                                        Background="{Binding AccentColorHex}" CornerRadius="6" Padding="18,10" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📦" FontSize="12"/>
                                        <TextBlock Text="Extraer Particiones Marcadas..." FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 13. IMEI & NVRAM (AS IN VIDEO 03:20)                     -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsImei}" Spacing="16">
                        <!-- Backup IMEI Card -->
                        <Border Background="#10141F" CornerRadius="10" Padding="20" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Full IMEI &amp; NVRAM Partition Backup" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Respalda los bloques nvram, nvdata, nvcfg, protect1, protect2 y modem directamente a tu PC."
                                           FontSize="11" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                <Button Command="{Binding BackupRfAndImeiCommand}" IsEnabled="{Binding !IsBusy}"
                                        Background="#00C853" CornerRadius="6" Padding="20,10" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="⚡ Backup IMEI &amp; NVRAM" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Restore IMEI Card with High Risk Warning -->
                        <Border Background="#2B0D12" CornerRadius="10" Padding="20" BorderBrush="#59131C" BorderThickness="1">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Restore IMEI &amp; NVRAM Partitions" FontSize="16" FontWeight="Bold" Foreground="#FF5252" HorizontalAlignment="Center"/>
                                <TextBlock Text="High Risk Operation: Solo restaure archivos respaldados desde el MISMO dispositivo para evitar pérdida de banda base."
                                           FontSize="11" Foreground="#FFCDD2" HorizontalAlignment="Center"/>
                                <Button Background="#D50000" CornerRadius="6" Padding="20,10" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="Restaurar Particiones de Calibración" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 14. REMOVE FRP LOCK (AS IN VIDEO 03:30)                  -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsRemoveFrp}" Spacing="16">

                        <!-- Warning Banner -->
                        <Border Background="#2B0D12" CornerRadius="10" Padding="16" BorderBrush="#59131C" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" FontSize="14"/>
                                    <TextBlock Text="PERMANENT DATA WIPE WARNING" FontWeight="Bold" FontSize="12" Foreground="#FF5252"/>
                                </StackPanel>
                                <TextBlock Text="ALL USER DATA WILL BE PERMANENTLY ERASED. Ensure device is in Fastboot/Fastbootd mode." FontSize="11" Foreground="#FFCDD2"/>
                            </StackPanel>
                        </Border>

                        <!-- Flow instructions and confirmation -->
                        <Border Background="#10141F" CornerRadius="10" Padding="18" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="5 Step Fastboot FRP Erase Flow:" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                <TextBlock Text="1. Connect device in fastboot/fastbootd mode" FontSize="11" Foreground="#90A4AE"/>
                                <TextBlock Text="2. Erase FRP partition (fastboot erase frp)" FontSize="11" Foreground="#90A4AE"/>
                                <TextBlock Text="3. Erase Userdata partition (fastboot erase userdata)" FontSize="11" Foreground="#90A4AE"/>
                                <TextBlock Text="4. Erase Metadata partition (fastboot erase metadata)" FontSize="11" Foreground="#90A4AE"/>
                                <TextBlock Text="5. Reboot system (fastboot reboot)" FontSize="11" Foreground="#90A4AE"/>

                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <CheckBox IsChecked="{Binding FrpAgreedEraseData}">
                                        <TextBlock Text="I understand that ALL user data on the device will be completely erased." FontSize="11" Foreground="#CFD8DC"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding FrpConfirmedFastboot}">
                                        <TextBlock Text="I confirm my device is already in fastboot or bootloader mode." FontSize="11" Foreground="#CFD8DC"/>
                                    </CheckBox>
                                </StackPanel>

                                <Button Command="{Binding OpenFrpModalCommand}" Background="{Binding AccentColorHex}"
                                        CornerRadius="6" Padding="20,12" HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="🔓 REMOVE FRP &amp; WIPE DATA" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Modal Dialog for FRP Execution -->
                        <Border IsVisible="{Binding IsFrpModalOpen}" Background="#161B26" CornerRadius="10" Padding="20" BorderBrush="{Binding AccentColorHex}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Select Fastboot Mode" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Button Command="{Binding StartFrpExecutionCommand}" CommandParameter="fastbootd"
                                        Background="#10141F" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                    <TextBlock Text="⚡ Already in Fastboot / fastbootd" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </Button>
                                <Button Command="{Binding StartFrpExecutionCommand}" CommandParameter="bootloader"
                                        Background="#10141F" Padding="14,10" CornerRadius="6" HorizontalAlignment="Stretch">
                                    <TextBlock Text="🔌 In Bootloader (Reboot via Fastboot)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                </Button>
                                <Button Command="{Binding CloseFrpModalCommand}" Background="Transparent" HorizontalAlignment="Right" Padding="6">
                                    <TextBlock Text="Cancel" FontSize="11" Foreground="#78909C"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Running Progress Box -->
                        <Border IsVisible="{Binding IsFrpRunning}" Background="#090C12" CornerRadius="10" Padding="18" BorderBrush="#00E676" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding FrpStatusStep}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FrpProgressValue, StringFormat={}{0:F0}%}" FontWeight="Bold" FontSize="13" Foreground="#00E676"/>
                                </Grid>
                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding FrpProgressValue}" Foreground="#00E676" Background="#263238" CornerRadius="3"/>
                                <ItemsControl ItemsSource="{Binding FrpLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Code, monospace" FontSize="11" Foreground="#80CBC4" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- 15. SETTINGS PAGE (AS IN VIDEO 05:10)                    -->
                    <!-- ======================================================== -->
                    <StackPanel IsVisible="{Binding IsSettings}" Spacing="16">
                        <Border Background="#10141F" CornerRadius="10" Padding="20" BorderBrush="#1C2336" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="SETTINGS &amp; THEMES" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>

                                <!-- Primary Accent Color Selector -->
                                <TextBlock Text="Primary Accent Color (DOTS):" FontSize="11" FontWeight="Bold" Foreground="#78909C"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Command="{Binding SetAccentCommand}" CommandParameter="#FF1744" Background="#FF1744" CornerRadius="15" Width="30" Height="30"/>
                                    <Button Command="{Binding SetAccentCommand}" CommandParameter="#FFAB00" Background="#FFAB00" CornerRadius="15" Width="30" Height="30"/>
                                    <Button Command="{Binding SetAccentCommand}" CommandParameter="#00E5FF" Background="#00E5FF" CornerRadius="15" Width="30" Height="30"/>
                                    <Button Command="{Binding SetAccentCommand}" CommandParameter="#00E676" Background="#00E676" CornerRadius="15" Width="30" Height="30"/>
                                    <Button Command="{Binding SetAccentCommand}" CommandParameter="#D500F9" Background="#D500F9" CornerRadius="15" Width="30" Height="30"/>
                                </StackPanel>

                                <!-- Flashing Preferences -->
                                <TextBlock Text="Flashing Preferences:" FontSize="11" FontWeight="Bold" Foreground="#78909C" Margin="0,8,0,0"/>
                                <StackPanel Spacing="8">
                                    <CheckBox IsChecked="{Binding AutoRebootAfterFlash}">
                                        <TextBlock Text="Auto reboot device after flashing completion" FontSize="11" Foreground="#ECEFF1"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding VerifyImageChecksums}">
                                        <TextBlock Text="Verify partition image checksums before flashing" FontSize="11" Foreground="#ECEFF1"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding DisableAndroidVerify}">
                                        <TextBlock Text="Disable Android Verity &amp; Verification for GSI flashing" FontSize="11" Foreground="#ECEFF1"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

        </Grid>

    </Grid>
</Window>
