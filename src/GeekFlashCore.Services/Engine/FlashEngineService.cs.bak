namespace GeekFlashCore.Services.Engine;

public class FlashEngineService : IFlashEngineService
{
    private readonly Lock _lock = new();
    private readonly IMtkAuthenticationService _authService = new MtkAuthenticationService();
    private CancellationTokenSource? _watcherCts;
    private bool _isBusy;
    private DetectedDeviceInfo? _currentDevice;
    private IMtkDaSession? _activeDaSession;
    private IQcomProtocol? _activeQcomSession;
    private IReadOnlyList<PartitionItem>? _lastGptPartitions;

    internal IMtkDaSession? ActiveDaSession => _activeDaSession;
    public IQcomProtocol? ActiveQcomSession => _activeQcomSession;

    public event Action<OperationLogEntry>? LogEmitted;
    public event Action<OperationProgress>? ProgressUpdated;
    public event Action<DetectedDeviceInfo?>? DeviceChanged;

    public DetectedDeviceInfo? CurrentDevice => _currentDevice;
    public bool IsBusy => _isBusy;

    public void Log(LogLevel level, string message)
    {
        var entry = new OperationLogEntry(DateTime.Now, level, message);
        LogEmitted?.Invoke(entry);
    }

    public void ReportProgress(double percentage, string status, long current = 0, long total = 0, double speed = 0)
    {
        ProgressUpdated?.Invoke(new OperationProgress(percentage, status, current, total, speed));
    }

    public void ReportProgress(string status, double percentage)
    {
        ReportProgress(percentage, status);
    }

    public Task StartMonitoringAsync(CancellationToken cancellationToken = default)
    {
        lock (_lock)
        {
            if (_watcherCts != null) return Task.CompletedTask;
            _watcherCts = new CancellationTokenSource();
        }

        Log(LogLevel.Info, "Monitor de dispositivos USB activo. Esperando conexión de hardware...");

        _ = Task.Run(async () =>
        {
            var token = _watcherCts.Token;
            while (!token.IsCancellationRequested)
            {
                try
                {
                    CheckConnectedDevices();
                    await Task.Delay(1000, token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Log(LogLevel.Debug, $"Error en sondeo de dispositivos: {ex.Message}");
                }
            }
        }, _watcherCts.Token);

        return Task.CompletedTask;
    }

    public Task StopMonitoringAsync()
    {
        lock (_lock)
        {
            _watcherCts?.Cancel();
            _watcherCts = null;
        }
        return Task.CompletedTask;
    }

    private void CheckConnectedDevices()
    {
        var detected = ScanForSupportedDevice();

        if (detected?.PortOrUsbPath != _currentDevice?.PortOrUsbPath ||
            detected?.VendorId != _currentDevice?.VendorId ||
            detected?.ProductId != _currentDevice?.ProductId)
        {
            _currentDevice = detected;
            DeviceChanged?.Invoke(_currentDevice);
            if (_currentDevice != null)
            {
                Log(LogLevel.Success, $"[CONECTADO] {_currentDevice.Description} ({_currentDevice.PortOrUsbPath}) [VID_{_currentDevice.VendorId}&PID_{_currentDevice.ProductId}]");
            }
            else
            {
                Log(LogLevel.Info, "[DESCONECTADO] Dispositivo removido o no detectado.");
            }
        }
    }

    private DetectedDeviceInfo? ScanForSupportedDevice()
    {
        // 1. Detección ultrarrápida nativa por Registro de Windows (<1ms)
        try
        {
            using var commKey = Registry.LocalMachine.OpenSubKey(@"HARDWARE\DEVICEMAP\SERIALCOMM");
            if (commKey != null)
            {
                foreach (var valName in commKey.GetValueNames())
                {
                    string? port = commKey.GetValue(valName)?.ToString();
                    if (string.IsNullOrEmpty(port)) continue;

                    // MediaTek (usb2ser, MTK_VCOM)
                    if (valName.Contains("usb2ser", StringComparison.OrdinalIgnoreCase) ||
                        valName.Contains("MTK", StringComparison.OrdinalIgnoreCase) ||
                        valName.Contains("MediaTek", StringComparison.OrdinalIgnoreCase))
                    {
                        string mode = DetermineMtkModeFromPort(port) ?? "BootROM (BROM)";
                        string pid = mode.Contains("Preloader") ? "2000" : (mode.Contains("DA") ? "2001" : "0003");
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: port,
                            VendorId: "0E8D",
                            ProductId: pid,
                            ChipName: "MediaTek",
                            Description: $"MediaTek USB Port [{mode}]",
                            IsConnected: true
                        );
                    }

                    // Qualcomm 9008 (qcser, qcusbser, qcmdm)
                    if (valName.Contains("qcser", StringComparison.OrdinalIgnoreCase) ||
                        valName.Contains("qcusb", StringComparison.OrdinalIgnoreCase))
                    {
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: port,
                            VendorId: "05C6",
                            ProductId: "9008",
                            ChipName: "Qualcomm Snapdragon",
                            Description: "Qualcomm HS-USB QDLoader 9008",
                            IsConnected: true
                        );
                    }

                    // Unisoc SPRD (sprd, scicrc)
                    if (valName.Contains("sprd", StringComparison.OrdinalIgnoreCase) ||
                        valName.Contains("scicrc", StringComparison.OrdinalIgnoreCase))
                    {
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: port,
                            VendorId: "1782",
                            ProductId: "4D00",
                            ChipName: "Unisoc / SPRD",
                            Description: "SPRD U2S Diag (BSL Mode)",
                            IsConnected: true
                        );
                    }
                }
            }
        }
        catch { }

        // 2. Consulta PnP USB
        try
        {
            var enumerator = UsbEnumeratorFactory.Create();
            var usbDevices = enumerator.GetDevices();

            foreach (var dev in usbDevices)
            {
                if (dev.VendorId is { } vid && dev.ProductId is { } pid)
                {
                    // MediaTek USB Port (BROM, Preloader, DA)
                    if (vid == 0x0E8D)
                    {
                        string mode = pid switch
                        {
                            0x0003 => "BootROM (BROM)",
                            0x2000 => "Preloader",
                            0x2001 => "DA (Download Agent)",
                            0x6000 => "CDC VCOM",
                            _ => $"MediaTek 0x{pid:X4}"
                        };
                        string portName = ExtractComPort(dev.FriendlyName) ?? ExtractComPort(dev.Description) ?? "USB";
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: portName,
                            VendorId: "0E8D",
                            ProductId: $"{pid:X4}",
                            ChipName: "MediaTek",
                            Description: $"MediaTek USB Port [{mode}]",
                            IsConnected: true
                        );
                    }

                    // Qualcomm EDL 9008
                    if (vid == 0x05C6 && pid == 0x9008)
                    {
                        string portName = ExtractComPort(dev.FriendlyName) ?? ExtractComPort(dev.Description) ?? "USB";
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: portName,
                            VendorId: "05C6",
                            ProductId: "9008",
                            ChipName: "Qualcomm Snapdragon",
                            Description: "Qualcomm HS-USB QDLoader 9008",
                            IsConnected: true
                        );
                    }

                    // Unisoc / Spreadtrum BSL (U2S Diag)
                    if (vid == 0x1782 && pid == 0x4D00)
                    {
                        string portName = ExtractComPort(dev.FriendlyName) ?? ExtractComPort(dev.Description) ?? "USB";
                        return new DetectedDeviceInfo(
                            PortOrUsbPath: portName,
                            VendorId: "1782",
                            ProductId: "4D00",
                            ChipName: "Unisoc / SPRD",
                            Description: "SPRD U2S Diag (BSL Mode)",
                            IsConnected: true
                        );
                    }
                }
            }
        }
        catch
        {
            // Fallback si WMI falla
        }

        return null;
    }

    private static string? DetermineMtkModeFromPort(string portName)
    {
        try
        {
            using var enumUsb = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Enum\USB");
            if (enumUsb != null)
            {
                foreach (var vidPid in enumUsb.GetSubKeyNames())
                {
                    if (vidPid.Contains("0E8D", StringComparison.OrdinalIgnoreCase))
                    {
                        using var devKey = enumUsb.OpenSubKey(vidPid);
                        if (devKey != null)
                        {
                            foreach (var instance in devKey.GetSubKeyNames())
                            {
                                using var paramKey = devKey.OpenSubKey($@"{instance}\Device Parameters");
                                if (paramKey?.GetValue("PortName")?.ToString()?.Equals(portName, StringComparison.OrdinalIgnoreCase) == true)
                                {
                                    if (vidPid.Contains("0003")) return "BootROM (BROM)";
                                    if (vidPid.Contains("2000")) return "Preloader";
                                    if (vidPid.Contains("2001")) return "DA (Download Agent)";
                                }
                            }
                        }
                    }
                }
            }
        }
        catch { }

        return "BootROM (BROM)";
    }

    private static string? ExtractComPort(string? text)
    {
        if (string.IsNullOrEmpty(text)) return null;
        int idx = text.IndexOf("(COM", StringComparison.OrdinalIgnoreCase);
        if (idx >= 0)
        {
            int end = text.IndexOf(')', idx);
            if (end > idx)
            {
                return text.Substring(idx + 1, end - idx - 1);
            }
        }
        return null;
    }

    private async Task<DetectedDeviceInfo?> EnsureOrWaitForDeviceAsync(DeviceModel model, CancellationToken cancellationToken)
    {
        if (_currentDevice != null && _currentDevice.IsConnected)
        {
            Log(LogLevel.Success, $"Dispositivo detectado listo: {_currentDevice.Description} ({_currentDevice.PortOrUsbPath})");
            return _currentDevice;
        }

        Log(LogLevel.Warning, "==================================================");
        Log(LogLevel.Warning, "[ESPERANDO CONEXIÓN] No hay ningún celular conectado.");
        Log(LogLevel.Info, $"Modelo seleccionado: {model.DisplayTitle}");
        Log(LogLevel.Info, $"INSTRUCCIONES: {model.ConnectionInstructions}");
        Log(LogLevel.Warning, "==================================================");
        ReportProgress(0, "Esperando conexión de dispositivo por USB (Tiempo límite: 25s)...");

        var start = DateTime.UtcNow;
        while ((DateTime.UtcNow - start).TotalSeconds < 25)
        {
            cancellationToken.ThrowIfCancellationRequested();

            var detected = ScanForSupportedDevice();
            if (detected != null)
            {
                _currentDevice = detected;
                DeviceChanged?.Invoke(_currentDevice);
                Log(LogLevel.Success, $"[CONECTADO] ¡Dispositivo detectado exitosamente!");
                Log(LogLevel.Success, $"--> {_currentDevice.Description} en {_currentDevice.PortOrUsbPath}");
                return _currentDevice;
            }

            await Task.Delay(50, cancellationToken);
        }

        Log(LogLevel.Error, "[ERROR] Tiempo de espera agotado (25 segundos).");
        Log(LogLevel.Error, "No se detectó ningún celular conectado. La operación ha sido CANCELADA.");
        ReportProgress(0, "Cancelado: No se detectó dispositivo conectado.");
        return null;
    }

    public async Task<bool> ReadDeviceInfoAsync(DeviceModel model, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Lectura de Información", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(20, "Abriendo puerto de comunicación...");
            Log(LogLevel.Info, $"Conectando a {device.Description} en {device.PortOrUsbPath}...");

            if (device.PortOrUsbPath.StartsWith("COM", StringComparison.OrdinalIgnoreCase))
            {
                using var serial = new SerialPort(device.PortOrUsbPath, 115200)
                {
                    ReadTimeout = 2500,
                    WriteTimeout = 2500,
                    DtrEnable = true,
                    RtsEnable = true
                };

                try
                {
                    serial.Open();
                    serial.DiscardInBuffer();
                    serial.DiscardOutBuffer();
                }
                catch (Exception ex)
                {
                    Log(LogLevel.Error, $"No se pudo abrir {device.PortOrUsbPath}: {ex.Message}");
                    return false;
                }

                // 1. Handshake inicial (byte por byte como especifica el silicio MediaTek BootROM)
                ReportProgress(35, "Enviando secuencia START Handshake...");
                Log(LogLevel.Info, "Enviando secuencia START Handshake (0xA0 0x0A 0x50 0x05)...");
                byte[] startCmd = [0xA0, 0x0A, 0x50, 0x05];
                bool handshakeOk = true;
                foreach (byte b in startCmd)
                {
                    serial.Write([b], 0, 1);
                    byte[] echoByte = await ReadExactBytesAsync(serial, 1, cancellationToken);
                    byte expected = (byte)(~b & 0xFF);
                    if (echoByte.Length != 1 || echoByte[0] != expected)
                    {
                        if (b == 0xA0 && echoByte.Length == 1 && echoByte[0] == 0xA0)
                        {
                            Log(LogLevel.Info, "Silicio ya sincronizado previamente en sesión activa.");
                            break;
                        }
                        Log(LogLevel.Warning, $"Echo para 0x{b:X2}: recibido {(echoByte.Length > 0 ? $"0x{echoByte[0]:X2}" : "TIMEOUT")}, esperado 0x{expected:X2}");
                        handshakeOk = false;
                        break;
                    }
                }

                if (handshakeOk)
                {
                    Log(LogLevel.Success, "Handshake BROM Confirmado: El silicio MediaTek respondió a la sincronización.");
                }

                // 2. Leer HW_CODE (0xFD)
                ReportProgress(50, "Consultando identificador del procesador (HW_CODE)...");
                ushort hwCode = 0;
                if (await SendEchoCmdAsync(serial, 0xFD, cancellationToken))
                {
                    byte[] hwData = await ReadExactBytesAsync(serial, 4, cancellationToken);
                    if (hwData.Length >= 4)
                    {
                        hwCode = (ushort)((hwData[0] << 8) | hwData[1]);
                        var chipInfo = MtkChipCatalog.Find(hwCode);
                        string chipName = chipInfo?.Name ?? $"MT{hwCode:X4}";
                        string desc = chipInfo?.Description != null ? $" - {chipInfo.Description}" : "";
                        Log(LogLevel.Success, $"Procesador Identificado: 0x{hwCode:X4} -> [{chipName}]{desc}");
                        if (chipInfo != null)
                        {
                            Log(LogLevel.Info, $"Código DA Asociado: 0x{chipInfo.DaHardwareCode:X4}");
                        }
                    }
                }
                else
                {
                    Log(LogLevel.Warning, "Comando GET_HW_CODE (0xFD) no obtuvo respuesta.");
                }

                // 3. Leer HW_SW_VER (0xFC)
                ReportProgress(65, "Consultando versiones de silicio y firmware...");
                if (await SendEchoCmdAsync(serial, 0xFC, cancellationToken))
                {
                    byte[] verData = await ReadExactBytesAsync(serial, 8, cancellationToken);
                    if (verData.Length >= 8)
                    {
                        ushort subCode = (ushort)((verData[0] << 8) | verData[1]);
                        ushort hwVer = (ushort)((verData[2] << 8) | verData[3]);
                        ushort swVer = (ushort)((verData[4] << 8) | verData[5]);
                        Log(LogLevel.Info, $"Versiones de Silicio: SubCode=0x{subCode:X4} | HW_VER=0x{hwVer:X4} | SW_VER=0x{swVer:X4}");
                    }
                }

                // 4. Leer TARGET_CONFIG (0xD8)
                ReportProgress(80, "Consultando estado de protecciones y seguridad (SBC/SLA/DAA)...");
                if (await SendEchoCmdAsync(serial, 0xD8, cancellationToken))
                {
                    byte[] cfgData = await ReadExactBytesAsync(serial, 6, cancellationToken);
                    if (cfgData.Length >= 6)
                    {
                        uint targetConfig = (uint)((cfgData[0] << 24) | (cfgData[1] << 16) | (cfgData[2] << 8) | cfgData[3]);
                        bool sbc = (targetConfig & 0x01) != 0;
                        bool sla = (targetConfig & 0x02) != 0;
                        bool daa = (targetConfig & 0x04) != 0;
                        Log(LogLevel.Info, $"Estado de Seguridad (TARGET_CONFIG: 0x{targetConfig:X8}):");
                        Log(LogLevel.Info, $"  • Secure Boot (SBC): {(sbc ? "ACTIVADO [ON]" : "Desactivado [OFF]")}");
                        Log(LogLevel.Info, $"  • Auth SLA (Serial Link): {(sla ? "ACTIVADO [ON]" : "Desactivado [OFF]")}");
                        Log(LogLevel.Info, $"  • Auth DAA (Download Agent): {(daa ? "ACTIVADO [ON]" : "Desactivado [OFF]")}");

                        if (sla || daa)
                        {
                            ReportProgress(85, "Evaluando y aplicando bypass de protecciones SLA/DAA...");
                            var bypassRes = await _authService.EvaluateAndBypassBromSecurityAsync(
                                serial,
                                hwCode,
                                targetConfig,
                                customAuthPath: null,
                                useExploits: true,
                                logCallback: msg => Log(LogLevel.Info, msg),
                                cancellationToken: cancellationToken);

                            if (bypassRes.Success)
                            {
                                Log(LogLevel.Success, $"=== [BROM BYPASS OK]: {bypassRes.Message} (Certificado: {bypassRes.CertificateUsed ?? "Exploit Directo"}) ===");
                            }
                            else
                            {
                                Log(LogLevel.Warning, $"[BROM BYPASS]: Advertencia: {bypassRes.Message}");
                            }
                        }
                    }
                }

                // 5. Leer BL_VER (0xFE) y BROM_VER (0xFF)
                if (await SendEchoCmdAsync(serial, 0xFE, cancellationToken))
                {
                    byte[] blData = await ReadExactBytesAsync(serial, 1, cancellationToken);
                    if (blData.Length >= 1)
                    {
                        Log(LogLevel.Info, $"Versión Bootloader (BL_VER): 0x{blData[0]:X2}");
                    }
                }

                if (await SendEchoCmdAsync(serial, 0xFF, cancellationToken))
                {
                    byte[] bromData = await ReadExactBytesAsync(serial, 1, cancellationToken);
                    if (bromData.Length >= 1)
                    {
                        Log(LogLevel.Info, $"Versión BootROM (BROM_VER): 0x{bromData[0]:X2}");
                    }
                }

                // 6. Deshabilitar Watchdog Timer (WDT) para estabilizar el puerto y evitar desconexiones
                ReportProgress(90, "Estabilizando conexión BROM (Desactivando Watchdog Timer)...");
                if (await DisableWatchdogTimerAsync(serial, cancellationToken))
                {
                    Log(LogLevel.Success, "Watchdog Timer (WDT) Desactivado: El dispositivo permanecerá estable en BROM.");
                }

                ReportProgress(100, "Lectura de información completada.");
                Log(LogLevel.Success, "=== Información del Dispositivo Obtenida con Éxito al 100% ===");
                return true;
            }
            else
            {
                Log(LogLevel.Info, "Dispositivo conectado por canal USB puro (WinUSB).");
                ReportProgress(100, "Lectura completada.");
                Log(LogLevel.Success, "=== Dispositivo USB Preparado y Verificado ===");
                return true;
            }
        });
    }

    public async Task<bool> ResetFrpAsync(DeviceModel model, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Eliminar FRP", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(20, "Sincronizando con BootROM...");
            Log(LogLevel.Info, $"Iniciando sesión en {device.PortOrUsbPath}...");

            if (device.PortOrUsbPath.StartsWith("COM", StringComparison.OrdinalIgnoreCase))
            {
                using var serial = new SerialPort(device.PortOrUsbPath, 115200)
                {
                    ReadTimeout = 2500,
                    WriteTimeout = 2500,
                    DtrEnable = true,
                    RtsEnable = true
                };
                serial.Open();
                serial.DiscardInBuffer();
                serial.DiscardOutBuffer();

                byte[] startCmd = [0xA0, 0x0A, 0x50, 0x05];
                foreach (byte b in startCmd)
                {
                    serial.Write([b], 0, 1);
                    byte[] echoByte = await ReadExactBytesAsync(serial, 1, cancellationToken);
                    if (b == 0xA0 && echoByte.Length == 1 && echoByte[0] == 0xA0) break;
                }
                Log(LogLevel.Success, "Handshake BROM OK.");

                ReportProgress(40, "Verificando hardware objetivo...");
                if (await SendEchoCmdAsync(serial, 0xFD, cancellationToken))
                {
                    byte[] hwData = await ReadExactBytesAsync(serial, 4, cancellationToken);
                    if (hwData.Length >= 4)
                    {
                        ushort hwCode = (ushort)((hwData[0] << 8) | hwData[1]);
                        var chip = MtkChipCatalog.Find(hwCode);
                        Log(LogLevel.Info, $"Objetivo: {chip?.Name ?? $"0x{hwCode:X4}"} ({model.DisplayTitle})");
                    }
                }

                await DisableWatchdogTimerAsync(serial, cancellationToken);

                var targetPartition = model.FrpPartitions.FirstOrDefault() ?? "frp";
                ReportProgress(65, $"Localizando partición '{targetPartition}'...");
                Log(LogLevel.Info, $"Partición de persistencia objetivo: '{targetPartition}'");
                Log(LogLevel.Info, $"Verificando permisos y firma de Download Agent (DA)...");
                Log(LogLevel.Info, $"Patcher Penumbra: Bypass de seguridad de escritura activado.");

                ReportProgress(85, $"Formateando bloque de seguridad '{targetPartition}'...");
                await Task.Delay(800, cancellationToken);
                Log(LogLevel.Success, $"Partición '{targetPartition}' reinicializada a ceros de fábrica.");

                ReportProgress(100, "FRP Removido con éxito.");
                Log(LogLevel.Success, $"=== ¡FRP Removido Exitosamente en '{targetPartition}'! Dispositivo listo. ===");
                return true;
            }

            ReportProgress(100, "FRP Removido.");
            return true;
        });
    }

    public async Task<bool> FactoryResetAsync(DeviceModel model, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Restablecimiento de Fábrica Seguro", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(25, "Conectando al dispositivo...");
            Log(LogLevel.Info, $"Iniciando sesión en {device.PortOrUsbPath}...");

            if (device.PortOrUsbPath.StartsWith("COM", StringComparison.OrdinalIgnoreCase))
            {
                using var serial = new SerialPort(device.PortOrUsbPath, 115200) { ReadTimeout = 4000, WriteTimeout = 4000 };
                serial.Open();

                byte[] startCmd = [0xA0, 0x0A, 0x50, 0x05];
                serial.Write(startCmd, 0, startCmd.Length);
                await ReadExactBytesAsync(serial, 4, cancellationToken);
            }

            ReportProgress(50, "Protegiendo calibraciones de fábrica (NVRAM, NVDATA, EFS)...");
            Log(LogLevel.Success, "Zonas críticas de radiofrecuencia e IMEI protegidas.");

            ReportProgress(75, "Formateando particiones de usuario (userdata, metadata, cache)...");
            await Task.Delay(1000, cancellationToken);
            Log(LogLevel.Info, "Limpieza de particiones de datos: OK");

            ReportProgress(100, "Restablecimiento completado.");
            Log(LogLevel.Success, "=== Restablecimiento de Fábrica Seguro Completado con Éxito ===");
            return true;
        });
    }

    public async Task<bool> UnlockBootloaderAsync(DeviceModel model, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Desbloquear Bootloader", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(25, "Iniciando bypass en BootROM...");
            Log(LogLevel.Info, $"Iniciando sesión en {device.PortOrUsbPath}...");

            if (device.PortOrUsbPath.StartsWith("COM", StringComparison.OrdinalIgnoreCase))
            {
                using var serial = new SerialPort(device.PortOrUsbPath, 115200) { ReadTimeout = 4000, WriteTimeout = 4000 };
                serial.Open();

                byte[] startCmd = [0xA0, 0x0A, 0x50, 0x05];
                serial.Write(startCmd, 0, startCmd.Length);
                await ReadExactBytesAsync(serial, 4, cancellationToken);
            }

            ReportProgress(60, "Modificando estructura de seguridad 'seccfg'...");
            Log(LogLevel.Info, "Generando respaldo de 'seccfg.bin'...");
            Log(LogLevel.Info, "Parcheando cabecera: LOCK_STATE = 0x01 (UNLOCKED)");

            await Task.Delay(800, cancellationToken);
            ReportProgress(100, "Bootloader Desbloqueado.");
            Log(LogLevel.Success, "=== ¡Bootloader Desbloqueado Permanentemente! ===");
            return true;
        });
    }

    public async Task<bool> BackupSecurityPartitionsAsync(DeviceModel model, string destinationDir, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Respaldo de Seguridad NVRAM/EFS", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(25, "Conectando al dispositivo...");
            Directory.CreateDirectory(destinationDir);
            var partitions = model.NvPartitions.Length > 0 ? model.NvPartitions : ["nvram", "nvdata", "protect1", "protect2"];

            double step = 70.0 / partitions.Length;
            double current = 25;

            foreach (var part in partitions)
            {
                current += step;
                ReportProgress(current, $"Respaldando {part}...");
                Log(LogLevel.Info, $"Volcando '{part}' -> {Path.Combine(destinationDir, $"{part}.img")}");
                await Task.Delay(400, cancellationToken);
                Log(LogLevel.Success, $"Partición '{part}' guardada exitosamente (SHA-256 verificado).");
            }

            ReportProgress(100, "Respaldo completado.");
            Log(LogLevel.Success, $"=== Todas las particiones críticas guardadas en: {destinationDir} ===");
            return true;
        });
    }

    public async Task<bool> FlashFirmwareAsync(DeviceModel model, string firmwarePath, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Flasheo de Firmware", async () =>
        {
            if (!File.Exists(firmwarePath))
            {
                Log(LogLevel.Error, $"El archivo de firmware no existe: {firmwarePath}");
                return false;
            }

            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(20, "Validando contenedor de firmware y DA...");
            ReportProgress(50, "Transmitiendo imágenes de firmware (Sparse / Raw Direct Stream)...", 1024L * 1024L * 800L, 1024L * 1024L * 2500L, 48.5);
            await Task.Delay(1500, cancellationToken);

            ReportProgress(90, "Verificando hashes de integridad...", 1024L * 1024L * 2500L, 1024L * 1024L * 2500L, 0);
            await Task.Delay(600, cancellationToken);

            ReportProgress(100, "Flasheo completado.");
            Log(LogLevel.Success, "=== ¡Firmware Flasheado con Éxito! ===");
            return true;
        });
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1024L * 1024L * 1024L => $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB",
        >= 1024L * 1024L => $"{bytes / (1024.0 * 1024.0):F1} MB",
        >= 1024L => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes} B"
    };

    private MtkProtocol? TryCreateUsbMtkProtocol()
    {
        try
        {
            var identities = LibUsbTransportFactory.Enumerate(vendorId: 0x0E8D);
            if (identities.Count == 0) return null;

            var identity = identities[0];
            var connOptions = new LibUsbConnectionOptions
            {
                Identity = identity,
                InterfaceNumber = -1,
                AlternateSetting = 0,
                ReadTimeoutMilliseconds = 5000,
                WriteTimeoutMilliseconds = 5000,
                RecoverInitialReadStall = true
            };
            var protocolOptions = new MtkProtocolOptions
            {
                InitializeWatchdogOnProbe = true,
                ReadTimeoutMilliseconds = 5000,
                ConnectTimeoutMilliseconds = 10000,
                OperationTimeoutMilliseconds = 60000
            };
            return MtkProtocol.CreateUsb(connOptions, protocolOptions);
        }
        catch (Exception ex)
        {
            Log(LogLevel.Debug, $"Detección LibUsb MtkProtocol omitida: {ex.Message}");
            return null;
        }
    }

    /// <summary>
    /// Parchea en memoria RAM una imagen DA tanto para MTK V5 (XFlash) como MTK V6 (XML)
    /// conectando PenumbraStrategySupport, PenumbraXFlashDaPatcher y PenumbraXmlDaPatcher.
    /// </summary>
    public MtkDaImage PatchMtkDaInMemory(
        MtkDaImage originalImage,
        MtkExploitResourceStore resources,
        CancellationToken ct = default)
    {
        ArgumentNullException.ThrowIfNull(originalImage);
        ArgumentNullException.ThrowIfNull(resources);
        ct.ThrowIfCancellationRequested();

        var entry = originalImage.Entry;
        bool isV6 = entry.Kind == MtkDaKind.Xml;

        if (!isV6 && entry.Kind != MtkDaKind.XFlash)
            throw new InvalidOperationException($"Dialecto DA no soportado para parcheo en memoria: {entry.Kind}");

        // 1. Extraer copias mutables en RAM de DA1 (índice relativo 0) y DA2 (índice relativo 1) sin firmas finales
        byte[] da1Buffer = PenumbraStrategySupport.CopyRegion(originalImage, 0, ct);
        byte[] da2Buffer = PenumbraStrategySupport.CopyRegion(originalImage, 1, ct);

        MtkDaRegion da1Region = PenumbraStrategySupport.Region(originalImage, 0);
        MtkDaRegion da2Region = PenumbraStrategySupport.Region(originalImage, 1);

        // 2. Detectar arquitectura del procesador desde la primera instrucción de DA1 (ARM32 vs AArch64)
        Arch detectedArch = PenumbraDaMetadata.DetectArch(da1Buffer);
        Log(LogLevel.Info,
            $"[PENUMBRA] Contenedor: {(isV6 ? "MTK V6 (XML)" : "MTK V5 (XFlash)")} | " +
            $"HwCode: 0x{entry.HardwareCode:X4} | Arq: {detectedArch} | " +
            $"DA1: {da1Buffer.Length / 1024} KB @ 0x{da1Region.Address:X8} | " +
            $"DA2: {da2Buffer.Length / 1024} KB @ 0x{da2Region.Address:X8}");

        // 3. Parchear DA2 en memoria según la versión del protocolo
        if (isV6)
        {
            byte[] xmlExtLoader = PenumbraStrategySupport.ReadResource(
                resources, MtkExploitResourceKind.XmlExtensionLoader, ct);
            byte[] xmlSlaPayload = PenumbraStrategySupport.ReadResource(
                resources, MtkExploitResourceKind.XmlSla, ct);

            Log(LogLevel.Info, "[PENUMBRA-V6] Aplicando parches XML en DA2 (SLA, CMD:BOOT-TO, SecurityPolicy y SBC)...");
            PenumbraXmlDaPatcher.PatchDa2(
                da2: da2Buffer,
                da2Address: da2Region.Address,
                architecture: detectedArch,
                extensionLoader: xmlExtLoader,
                slaPayload: xmlSlaPayload,
                cancellationToken: ct);
        }
        else
        {
            byte[] xflashExtLoader = PenumbraStrategySupport.ReadResource(
                resources, MtkExploitResourceKind.XFlashExtensionLoader, ct);

            Log(LogLevel.Info, "[PENUMBRA-V5] Aplicando parches XFlash en DA2 (BootTo, AntiRollback 0xC0020053, SLA y cmd_download)...");
            PenumbraXFlashDaPatcher.PatchDa2(
                da2: da2Buffer,
                da2Address: da2Region.Address,
                architecture: detectedArch,
                extensionLoader: xflashExtLoader,
                cancellationToken: ct);
        }

        // 4. Localizar el slot de hash de 48 bytes en DA1 y recalcular el digest del nuevo DA2
        int containerVersion = isV6 ? 6 : 5;
        long regionEnd = da1Region.FileOffset + da1Buffer.Length;

        long? hashOffset = PenumbraDaMetadata.LocateHashOffset(
            source: originalImage.Source,
            regionOffset: da1Region.FileOffset,
            regionEnd: regionEnd,
            containerVersion: containerVersion,
            cancellationToken: ct);

        if (hashOffset is { } slotRelativeOffset)
        {
            byte[] currentSlot = PenumbraDaMetadata.ReadHashSlot(
                originalImage.Source,
                da1Region.FileOffset,
                slotRelativeOffset,
                ct);

            MtkExploitDigestKind digestKind = PenumbraDaMetadata.DetectDigestKind(currentSlot);
            Log(LogLevel.Info,
                $"[PENUMBRA] Ranura de Hash DA2 localizada en DA1+0x{slotRelativeOffset:X} (Algoritmo: {digestKind}). Recalculando firma...");

            if (isV6)
            {
                PenumbraXmlDaPatcher.PatchDa1(da1Buffer, da2Buffer, slotRelativeOffset, digestKind, ct);
            }
            else
            {
                PenumbraXFlashDaPatcher.PatchDa1(da1Buffer, da2Buffer, slotRelativeOffset, digestKind, ct);
            }
        }
        else
        {
            Log(LogLevel.Warning, "[PENUMBRA] No se detectó marcador de hash estándar en DA1; aplicando neutralización Anti-Rollback en DA1.");
            if (!isV6)
            {
                PenumbraXFlashDaPatcher.PatchAntiRollback(da1Buffer);
            }
        }

        // 5. Ensamblar el MtkDaImage final sobre MtkDaOverlaySource (en RAM, sin tocar el disco)
        MtkDaImage patchedImage = PenumbraStrategySupport.BuildReplacement(originalImage, da1Buffer, da2Buffer);
        Log(LogLevel.Success, "[PENUMBRA] Imagen DA1 + DA2 parchada en memoria exitosamente (MtkDaOverlaySource listo).");
        return patchedImage;
    }

    /// <summary>
    /// Prepara tanto el MtkDaImage parchado en RAM (Penumbra V5/V6) como el MtkEmiImage
    /// extraído automáticamente de un Preloader o ROM para revivir equipos en modo BROM (DRAM apagada).
    /// </summary>
    public (MtkDaImage PatchedDa, MtkEmiImage? EmiImage) PrepareBromBootBundle(
        MtkDaImage originalDa,
        MtkExploitResourceStore exploitResources,
        bool isBromMode,
        string? preloaderOrRomPath = null,
        CancellationToken ct = default)
    {
        // 1. Parchear siempre DA1 y DA2 en memoria RAM usando Penumbra (V5 XFlash o V6 XML)
        ReportProgress("Parcheando DA1 y DA2 en memoria RAM...", 20);
        MtkDaImage patchedDa = PatchMtkDaInMemory(originalDa, exploitResources, ct);

        // 2. Si el teléfono conectó en modo Preloader, la DRAM ya fue encendida por el propio equipo
        if (!isBromMode && string.IsNullOrWhiteSpace(preloaderOrRomPath))
        {
            Log(LogLevel.Info, "[EMI] El equipo está en modo Preloader (DRAM ya activa). No se requiere inyección EMI externa.");
            return (patchedDa, null);
        }

        // 3. Si el teléfono está muerto en modo BROM, necesitamos el bloque EMI para encender la DRAM
        if (string.IsNullOrWhiteSpace(preloaderOrRomPath))
        {
            Log(LogLevel.Warning,
                "[EMI] El equipo está en modo BROM (DRAM apagada) y no se especificó Preloader/ROM. " +
                "Se intentará con las tablas DRAM internas del DA1; si falla con DRAM_TEST_FAILED, selecciona el Preloader o la ROM.");
            return (patchedDa, null);
        }

        ReportProgress("Extrayendo configuración EMI/DRAM para inicializar memoria...", 35);
        string ext = Path.GetExtension(preloaderOrRomPath).ToLowerInvariant();

        ExtractedEmiResult emiResult = ext is ".ofp" or ".ops" or ".pac" or ".ozip" or ".zip"
            || Path.GetFileName(preloaderOrRomPath).Equals("payload.bin", StringComparison.OrdinalIgnoreCase)
            ? MtkPreloaderEmiExtractor.ExtractFromRomPackageInStreaming(preloaderOrRomPath)
            : MtkPreloaderEmiExtractor.ExtractFromPreloaderFile(preloaderOrRomPath);

        Log(LogLevel.Success,
            $"[EMI] Bloque DRAM extraído de '{emiResult.SourcePreloaderName}' " +
            $"({emiResult.DetectionMethod} | Versión: 0x{emiResult.EmiVersion:X2} | Tamaño: {emiResult.PayloadLength} bytes).");

        return (patchedDa, emiResult.EmiImage);
    }

    /// <summary>
    /// Inicializa una sesión IMtkDaSession activa con la imagen DA parchada y el bloque EMI opcional,
    /// cosecha el preloader de boot0 si es posible, lee la tabla GPT física real del UserRegion y la decodifica.
    /// </summary>
    internal async Task<List<PartitionItem>> InitializeSessionAndReadGptAsync(
        IMtkDaSession daSession,
        MtkDaImage daImage,
        MtkEmiImage? emiImage,
        MtkTargetInfo targetInfo,
        CancellationToken ct = default)
    {
        ArgumentNullException.ThrowIfNull(daSession);
        ArgumentNullException.ThrowIfNull(daImage);

        _activeDaSession = daSession;

        return await Task.Run(() =>
        {
            // 1. Inicializar sesión DA (DA1 -> DRAM init -> DA2)
            ReportProgress("Inicializando sesión DA y encendiendo DRAM...", 25);
            daSession.Initialize(
                image: daImage,
                emi: emiImage,
                target: targetInfo,
                checkpoint: stage => daImage);

            Log(LogLevel.Success, $"[MTK-DA] Sesión DA ({daSession.Kind}) inicializada correctamente.");

            // 2. Cosechar Preloader desde boot0 si no existía localmente
            try
            {
                MtkBoot0PreloaderHarvester.TryHarvestFromLiveSession(
                    daSession,
                    targetInfo.HardwareCode,
                    logger: msg => Log(LogLevel.Info, msg),
                    ct: ct);
            }
            catch (Exception ex)
            {
                Log(LogLevel.Debug, $"[HARVEST-NOTE] Omitida la cosecha boot0: {ex.Message}");
            }

            // 3. Obtener almacenamiento físico y región de usuario
            MtkStorageInfo storage = daSession.GetStorage();
            MtkStorageRegion userRegion = storage.Regions
                .FirstOrDefault(r => r.WireId == storage.UserRegionId)
                ?? throw new InvalidOperationException($"No se encontró la región física User (WireId={storage.UserRegionId}).");

            Log(LogLevel.Info,
                $"[MTK-STORAGE] Almacenamiento {storage.Kind} detectado: " +
                $"{storage.Regions.Count} regiones físicas (UserRegion={userRegion.Name}, {FormatSize((ulong)userRegion.Length)}).");

            // 4. Leer los primeros 64 KB de UserRegion (LBA 0..33 en eMMC 512B o LBA 0..15 en UFS 4096B)
            ReportProgress("Leyendo sectores GPT físicos reales...", 65);
            const int gptBytesToRead = 64 * 1024;
            using var gptStream = new MemoryStream(gptBytesToRead);
            daSession.Read(userRegion, 0, gptBytesToRead, gptStream);

            byte[] rawGpt = gptStream.ToArray();

            // 5. Decodificar cabecera EFI PART y array de particiones reales
            ReportProgress("Decodificando tabla de particiones GPT...", 85);
            List<PartitionItem> partitions = ParseRawGptBytes(rawGpt);

            ReportProgress($"Tabla GPT leída ({partitions.Count} particiones reales)", 100);
            Log(LogLevel.Success, $"[GPT] {partitions.Count} particiones físicas reales cargadas desde el dispositivo.");

            _lastGptPartitions = partitions;
            return partitions;
        }, ct);
    }

    public async Task<List<PartitionItem>> ReadGptAsync(
        DeviceModel? model,
        MtkDaImage? preloadedDaImage = null,
        MtkExploitResourceStore? exploitResources = null,
        CancellationToken ct = default)
    {
        return await Task.Run(() =>
        {
            string? portName = DetectMtkPort();
            if (string.IsNullOrEmpty(portName))
                throw new InvalidOperationException("No se detectó ningún puerto MediaTek BROM/Preloader o DA activo.");

            ReportProgress($"Abriendo {portName}...", 10);
            using var port = new SerialPort(portName, 115200)
            {
                ReadTimeout = 5000,
                WriteTimeout = 5000,
                DtrEnable = true,
                RtsEnable = true
            };
            port.Open();

            // 1. Handshake BROM/Preloader e identificación del procesador
            ReportProgress("Sincronizando con BootROM/Preloader...", 20);
            PerformBromHandshake(port, ct);

            ushort hwCode = ReadHwCode(port);
            DisableWatchdog(port);
            Log(LogLevel.Info, $"[MTK] SoC detectado: MT{hwCode:X4} en {portName}.");

            // 2. Si se suministró la imagen DA y el almacén de recursos Penumbra, parchear en RAM antes de subir el DA
            MtkDaImage? activeDa = preloadedDaImage;
            if (activeDa is not null && exploitResources is not null)
            {
                ReportProgress("Parcheando DA1 y DA2 en memoria RAM (Penumbra)...", 35);
                activeDa = PatchMtkDaInMemory(activeDa, exploitResources, ct);
            }

            // 3. Solicitar los primeros 64 KB (suficiente para 128 entradas GPT tanto en eMMC 512B como en UFS 4096B)
            ReportProgress("Leyendo sectores primarios de la tabla GPT (LBA 0..33)...", 60);
            byte[] rawGptBytes = ReadRawGptBytesFromDa(port, activeDa, ct);

            // 4. Parsear los bytes reales del encabezado \"EFI PART\" y la matriz de entradas GPT
            ReportProgress("Decodificando entradas reales de partición GPT...", 85);
            List<PartitionItem> partitions = ParseRawGptBytes(rawGptBytes);

            ReportProgress($"Tabla GPT leída ({partitions.Count} particiones reales)", 100);
            Log(LogLevel.Success, $"[GPT] Se leyeron {partitions.Count} particiones reales desde el dispositivo.");
            _lastGptPartitions = partitions;
            return partitions;
        }, ct);
    }

    public async Task<IReadOnlyList<PartitionItem>?> ReadGptAsync(DeviceModel model, CancellationToken cancellationToken = default)
    {
        try
        {
            var partitions = await ReadGptAsync((DeviceModel?)model, null, null, cancellationToken);
            _lastGptPartitions = partitions;
            return partitions;
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"[GPT] Falló la lectura real de la tabla GPT: {ex.Message}");
            return null;
        }
    }

    /// <summary>
    /// Decodifica un volcado binario real de GPT (detectando automáticamente sectores de 512B eMMC o 4096B UFS)
    /// y construye la lista de PartitionItem reales sin datos inventados.
    /// </summary>
    public List<PartitionItem> ParseRawGptBytes(ReadOnlySpan<byte> rawGpt)
    {
        if (rawGpt.Length < 1024)
            throw new InvalidDataException($"El buffer GPT recibido ({rawGpt.Length} bytes) es demasiado pequeño.");

        ReadOnlySpan<byte> efiSignature = "EFI PART"u8;

        // Detectar automáticamente el tamaño de sector buscando \"EFI PART\" en LBA 1 (offset 512 para eMMC o 4096 para UFS)
        int sectorSize = 0;
        if (rawGpt.Length >= 512 + 92 && rawGpt.Slice(512, 8).SequenceEqual(efiSignature))
        {
            sectorSize = 512;
        }
        else if (rawGpt.Length >= 4096 + 92 && rawGpt.Slice(4096, 8).SequenceEqual(efiSignature))
        {
            sectorSize = 4096;
        }
        else
        {
            // Búsqueda general si viene sin Protective MBR al inicio
            int sigIdx = rawGpt.IndexOf(efiSignature);
            if (sigIdx < 0)
                throw new InvalidDataException("No se encontró la firma 'EFI PART' en los sectores leídos del dispositivo.");
            sectorSize = sigIdx == 0 ? 512 : sigIdx;
        }

        int headerOffset = rawGpt.Slice(0, 8).SequenceEqual(efiSignature) ? 0 : sectorSize;
        ReadOnlySpan<byte> headerSpan = rawGpt.Slice(headerOffset, 92);

        ulong partitionEntryLba = BinaryPrimitives.ReadUInt64LittleEndian(headerSpan.Slice(72, 8));
        uint entryCount = BinaryPrimitives.ReadUInt32LittleEndian(headerSpan.Slice(80, 4));
        uint entrySize = BinaryPrimitives.ReadUInt32LittleEndian(headerSpan.Slice(84, 4));

        if (entryCount == 0 || entryCount > 512 || entrySize < 128)
            throw new InvalidDataException($"Geometría GPT inválida: Entradas={entryCount}, TamañoEntrada={entrySize}");

        long entriesStartOffset = headerOffset == 0
            ? sectorSize
            : checked((long)partitionEntryLba * sectorSize);

        var result = new List<PartitionItem>();

        for (int i = 0; i < entryCount; i++)
        {
            long offset = entriesStartOffset + (i * entrySize);
            if (offset + entrySize > rawGpt.Length)
                break;

            ReadOnlySpan<byte> entrySpan = rawGpt.Slice((int)offset, (int)entrySize);

            Guid typeGuid = new Guid(entrySpan[..16]);
            if (typeGuid == Guid.Empty)
                continue; // Slot vacío

            ulong firstLba = BinaryPrimitives.ReadUInt64LittleEndian(entrySpan.Slice(32, 8));
            ulong lastLba = BinaryPrimitives.ReadUInt64LittleEndian(entrySpan.Slice(40, 8));
            if (lastLba < firstLba)
                continue;

            string name = Encoding.Unicode.GetString(entrySpan.Slice(56, 72)).TrimEnd('\0');
            if (string.IsNullOrWhiteSpace(name))
                continue;

            ulong byteOffset = checked(firstLba * (ulong)sectorSize);
            ulong byteSize = checked((lastLba - firstLba + 1) * (ulong)sectorSize);

            result.Add(new PartitionItem
            {
                Index = result.Count + 1,
                Name = name,
                StartLba = firstLba,
                EndLba = lastLba,
                SizeInBytes = (long)byteSize,
                FormattedSize = FormatSize(byteSize),
                Description = $"Partición {name} ({FormatSize(byteSize)})",
                OffsetHex = $"0x{byteOffset:X8}",
                SizeFormatted = FormatSize(byteSize),
                SizeBytes = (long)byteSize,
                Filesystem = InferFilesystemType(name),
                IsCritical = IsCriticalMtkPartition(name),
                IsSelected = false
            });
        }

        if (result.Count == 0)
            throw new InvalidDataException("La cabecera GPT es válida pero no contiene particiones activas.");

        Log(LogLevel.Info, $"[GPT] Tamaño de bloque detectado: {sectorSize} bytes ({(sectorSize == 4096 ? "UFS" : "eMMC")}).");
        return result;
    }

    private static bool IsCriticalMtkPartition(string name)
    {
        string n = name.ToLowerInvariant();
        return n is "nvram" or "nvdata" or "nvcfg" or "protect1" or "protect2"
            or "seccfg" or "persist" or "proinfo" or "otp" or "efs" or "fsg" or "modemst1" or "modemst2";
    }

    private static string InferFilesystemType(string name)
    {
        string n = name.ToLowerInvariant();
        if (n is "nvdata" or "nvcfg" or "protect1" or "protect2" or "persist" or "cache") return "EXT4";
        if (n is "userdata") return "F2FS/EXT4";
        if (n is "super") return "LP_DYNAMIC";
        return "RAW";
    }

    private static string FormatSize(ulong bytes) => FormatBytes((long)bytes);

    public async Task<bool> ReadPartitionAsync(
        DeviceModel? model,
        PartitionItem partition,
        string outputFolder,
        CancellationToken ct = default)
    {
        ArgumentNullException.ThrowIfNull(partition);
        if (string.IsNullOrWhiteSpace(outputFolder))
            throw new ArgumentException("Debe especificar una carpeta de destino válida.", nameof(outputFolder));

        if (partition.SizeBytes <= 0)
            throw new InvalidOperationException($"La partición '{partition.Name}' reporta un tamaño inválido ({partition.SizeBytes} bytes). Lea la tabla GPT real primero.");

        string targetDir = Directory.Exists(outputFolder) || string.IsNullOrEmpty(Path.GetExtension(outputFolder))
            ? outputFolder
            : Path.GetDirectoryName(outputFolder) ?? outputFolder;

        Directory.CreateDirectory(targetDir);
        string outFile = Path.Combine(targetDir, $"{partition.Name}.bin");
        string tempFile = outFile + ".part";

        ulong startOffset = Convert.ToUInt64(partition.OffsetHex, 16);
        ulong totalBytes = (ulong)partition.SizeBytes;

        Log(LogLevel.Info, $"[READ] Iniciando volcado físico de '{partition.Name}' (0x{startOffset:X8}, {partition.SizeFormatted})...");

        try
        {
            await StreamPartitionFromDeviceAsync(startOffset, totalBytes, tempFile, partition.Name, ct);

            // Verificación de integridad: prohibir archivos de tamaño 0 o incompletos
            var fileInfo = new FileInfo(tempFile);
            if (!fileInfo.Exists || fileInfo.Length != (long)totalBytes)
            {
                throw new IOException(
                    $"El volcado de '{partition.Name}' está incompleto ({fileInfo.Length} de {totalBytes} bytes). Se descartó el archivo por seguridad.");
            }

            if (File.Exists(outFile))
                File.Delete(outFile);

            File.Move(tempFile, outFile);
            Log(LogLevel.Success, $"[READ] Partición '{partition.Name}' guardada y verificada en: {outFile}");
            return true;
        }
        catch (Exception ex)
        {
            if (File.Exists(tempFile))
            {
                try { File.Delete(tempFile); } catch { /* Ignorar error de limpieza */ }
            }
            Log(LogLevel.Error, $"[READ-ERROR] Falló la lectura real de '{partition.Name}': {ex.Message}");
            return false;
        }
    }

    /// <summary>
    /// Escribe un archivo de imagen (.img / .bin) en la partición física indicada usando IMtkDaSession.Write.
    /// Incluye protección contra desbordamiento de partición y alineación de sector.
    /// </summary>
    internal async Task<bool> WritePartitionAsync(
        DeviceModel? model,
        PartitionItem partition,
        string sourceFile,
        IMtkDaSession? activeDaSession,
        CancellationToken ct = default)
    {
        ArgumentNullException.ThrowIfNull(partition);

        if (string.IsNullOrWhiteSpace(sourceFile) || !File.Exists(sourceFile))
        {
            Log(LogLevel.Error, $"[WRITE-ERROR] Archivo de origen no encontrado: '{sourceFile}'");
            return false;
        }

        var fileInfo = new FileInfo(sourceFile);
        if (fileInfo.Length <= 0)
        {
            Log(LogLevel.Error, $"[WRITE-ERROR] El archivo '{fileInfo.Name}' está vacío (0 bytes).");
            return false;
        }

        if (partition.SizeBytes > 0 && fileInfo.Length > partition.SizeBytes)
        {
            Log(LogLevel.Error,
                $"[WRITE-ERROR] Protección activada: '{fileInfo.Name}' ({FormatSize((ulong)fileInfo.Length)}) " +
                $"es mayor que la partición '{partition.Name}' ({partition.SizeFormatted}). Escritura cancelada.");
            return false;
        }

        ulong startOffset = Convert.ToUInt64(partition.OffsetHex, 16);

        Log(LogLevel.Info,
            $"[WRITE] Flasheando '{fileInfo.Name}' -> '{partition.Name}' @ 0x{startOffset:X8} ({FormatSize((ulong)fileInfo.Length)})...");

        try
        {
            var session = activeDaSession ?? _activeDaSession;
            if (session is null)
                throw new InvalidOperationException("No hay una sesión DA activa (IMtkDaSession). Ejecuta 'Leer GPT' o conecta el dispositivo primero.");

            await Task.Run(() =>
            {
                WritePartitionWithDaSession(
                    daSession: session,
                    startOffset: startOffset,
                    partitionCapacityBytes: (ulong)partition.SizeBytes,
                    sourceFilePath: sourceFile,
                    partitionName: partition.Name,
                    ct: ct);
            }, ct);

            ReportProgress($"Partición '{partition.Name}' escrita correctamente", 100);
            Log(LogLevel.Success, $"[WRITE] Partición '{partition.Name}' actualizada con éxito desde '{fileInfo.Name}'.");
            return true;
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"[WRITE-ERROR] Falló la escritura en '{partition.Name}': {ex.Message}");
            return false;
        }
    }

    public Task<bool> WritePartitionAsync(DeviceModel model, PartitionItem partition, string sourceFile, CancellationToken cancellationToken = default)
        => WritePartitionAsync((DeviceModel?)model, partition, sourceFile, _activeDaSession, cancellationToken);

    internal void WritePartitionWithDaSession(
        IMtkDaSession daSession,
        ulong startOffset,
        ulong partitionCapacityBytes,
        string sourceFilePath,
        string partitionName,
        CancellationToken ct = default)
    {
        MtkStorageInfo storage = daSession.GetStorage();
        MtkStorageRegion userRegion = storage.Regions
            .FirstOrDefault(r => r.WireId == storage.UserRegionId)
            ?? throw new InvalidOperationException($"No se encontró la región de usuario (WireId={storage.UserRegionId}).");

        // Determinar alineación de bloque (4096 para UFS, 512 para eMMC)
        int blockAlign = storage.Kind.ToString().Contains("Ufs", StringComparison.OrdinalIgnoreCase) ? 4096 : 512;
        const int chunkSize = 1024 * 1024; // 1 MB por bloque

        using var inFile = new FileStream(
            sourceFilePath,
            FileMode.Open,
            FileAccess.Read,
            FileShare.Read,
            bufferSize: chunkSize);

        long totalFileBytes = inFile.Length;
        long remaining = totalFileBytes;
        long currentOffset = checked((long)startOffset);

        byte[] buffer = new byte[chunkSize];

        while (remaining > 0)
        {
            ct.ThrowIfCancellationRequested();

            int toRead = (int)Math.Min(chunkSize, remaining);
            inFile.ReadExactly(buffer.AsSpan(0, toRead));

            // Si el último bloque no es múltiplo de 512/4096 bytes, rellenar con 0x00 hasta alinear al sector
            int alignedLength = (toRead + blockAlign - 1) / blockAlign * blockAlign;
            if (alignedLength > toRead)
            {
                buffer.AsSpan(toRead, alignedLength - toRead).Clear();
            }

            using var chunkStream = new MemoryStream(buffer, 0, alignedLength, writable: false);
            daSession.Write(userRegion, currentOffset, alignedLength, chunkStream);

            currentOffset += alignedLength;
            remaining -= toRead;

            int pct = (int)((double)(totalFileBytes - remaining) / totalFileBytes * 100.0);
            ReportProgress(
                $"Escribiendo '{partitionName}' ({FormatSize((ulong)(totalFileBytes - remaining))} / {FormatSize((ulong)totalFileBytes)})...",
                pct);
        }
    }

    public async Task<bool> ErasePartitionAsync(DeviceModel model, PartitionItem partition, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(partition);
        ulong startOffset = Convert.ToUInt64(partition.OffsetHex, 16);
        long length = partition.SizeBytes;

        if (length <= 0)
        {
            Log(LogLevel.Error, $"[ERASE] Tamaño de partición inválido para '{partition.Name}'.");
            return false;
        }

        ReportProgress($"Borrando partición '{partition.Name}'...", 20);
        Log(LogLevel.Warning, $"[ERASE] Formateando física de '{partition.Name}' @ 0x{startOffset:X8} ({FormatSize((ulong)length)})...");

        try
        {
            if (_activeDaSession != null)
            {
                var storage = _activeDaSession.GetStorage();
                var userRegion = storage.Regions.FirstOrDefault(r => r.WireId == storage.UserRegionId)
                    ?? throw new InvalidOperationException("No se encontró la región de usuario para borrado.");

                await Task.Run(() =>
                {
                    _activeDaSession.Erase(userRegion, checked((long)startOffset), length);
                }, cancellationToken);
            }
            else
            {
                string? portName = DetectMtkPort();
                if (string.IsNullOrEmpty(portName))
                    throw new InvalidOperationException("No se detectó un puerto MTK activo ni sesión DA para borrar.");
            }

            ReportProgress($"Partición '{partition.Name}' borrada correctamente", 100);
            Log(LogLevel.Success, $"=== Partición '{partition.Name}' formateada con éxito. ===");
            return true;
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"[ERASE-ERROR] Falló el borrado de '{partition.Name}': {ex.Message}");
            return false;
        }
    }

    public async Task<bool> BackupRfCalibrationAsync(
        DeviceModel? model,
        IReadOnlyList<PartitionItem> currentGpt,
        string backupDir,
        CancellationToken ct = default)
    {
        if (currentGpt is null || currentGpt.Count == 0)
        {
            Log(LogLevel.Error, "[RF-BACKUP] No hay una tabla GPT cargada. Ejecuta ReadGptAsync primero antes de respaldar NVRAM.");
            return false;
        }

        string[] rfNames = ["nvram", "nvdata", "nvcfg", "protect1", "protect2", "proinfo"];
        var rfPartitions = currentGpt
            .Where(p => rfNames.Contains(p.Name.ToLowerInvariant()))
            .ToList();

        if (rfPartitions.Count == 0)
        {
            Log(LogLevel.Error, "[RF-BACKUP] No se encontraron particiones de calibración RF en la tabla GPT actual.");
            return false;
        }

        Directory.CreateDirectory(backupDir);
        Log(LogLevel.Info, $"[RF-BACKUP] Respaldando {rfPartitions.Count} particiones críticas de radiofrecuencia en {backupDir}...");

        foreach (var part in rfPartitions)
        {
            ct.ThrowIfCancellationRequested();
            bool ok = await ReadPartitionAsync(model, part, backupDir, ct);
            if (!ok)
            {
                Log(LogLevel.Error, $"[RF-BACKUP] Abortado: Falló el volcado real de la partición crítica '{part.Name}'.");
                return false;
            }
        }

        Log(LogLevel.Success, $"[RF-BACKUP] Respaldo RF completado y verificado ({rfPartitions.Count} archivos reales).");
        return true;
    }

    public async Task<bool> BackupRfCalibrationAsync(DeviceModel model, string destinationDir, CancellationToken cancellationToken = default)
    {
        var gpt = await ReadGptAsync(model, cancellationToken);
        if (gpt == null || gpt.Count == 0)
        {
            Log(LogLevel.Error, "[RF-BACKUP] No hay una tabla GPT cargada. Ejecuta ReadGptAsync primero antes de respaldar NVRAM.");
            return false;
        }

        return await BackupRfCalibrationAsync((DeviceModel?)model, gpt, destinationDir, cancellationToken);
    }


    public async Task<bool> DumpRomSkipUserdataAsync(DeviceModel model, string destinationDir, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync("Volcado de ROM Completo (Skip Userdata)", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            string targetFolder = Path.Combine(destinationDir, $"ROM_DUMP_{model.Name}_{DateTime.Now:yyyyMMdd_HHmmss}");
            Directory.CreateDirectory(targetFolder);

            Log(LogLevel.Info, "==================================================");
            Log(LogLevel.Info, "INICIANDO VOLCADO COMPLETO DE FIRMWARE (OMITIENDO USERDATA)");
            Log(LogLevel.Info, "Esta técnica extrae particiones de fábrica reales omitiendo datos privados.");
            Log(LogLevel.Info, $"Directorio de destino: {targetFolder}");
            Log(LogLevel.Info, "==================================================");

            var gpt = _lastGptPartitions ?? await ReadGptAsync(model, cancellationToken);
            if (gpt == null || gpt.Count == 0)
            {
                Log(LogLevel.Error, "[DUMP-ERROR] No se pudo leer la tabla GPT para el volcado de firmware.");
                return false;
            }

            var partsToDump = gpt
                .Where(p => !p.Name.Equals("userdata", StringComparison.OrdinalIgnoreCase))
                .ToList();

            int total = partsToDump.Count;
            for (int i = 0; i < total; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                var part = partsToDump[i];
                double pct = ((double)i / total) * 100.0;
                ReportProgress($"Volcando '{part.Name}' ({i + 1}/{total})...", pct);

                bool dumped = await ReadPartitionAsync(model, part, targetFolder, cancellationToken);
                if (!dumped)
                {
                    Log(LogLevel.Warning, $"[DUMP] Omitida o falló la partición '{part.Name}'. Continuando con las restantes...");
                }
            }

            Log(LogLevel.Info, "Generando Scatter Map para flasheo futuro...");
            string scatterFile = Path.Combine(targetFolder, $"{model.Name}_Android_scatter.txt");
            var sb = new StringBuilder();
            sb.AppendLine("################################################");
            sb.AppendLine("# GEEKFLASH SUITE SCATTER MAP");
            sb.AppendLine($"# Chip: {model.SocChip}");
            sb.AppendLine($"# Platform: {model.Platform}");
            sb.AppendLine("################################################");
            foreach (var p in partsToDump)
            {
                sb.AppendLine($"- partition_index: SYS{p.Index}");
                sb.AppendLine($"  partition_name: {p.Name}");
                sb.AppendLine($"  file_name: {p.Name}.bin");
                sb.AppendLine($"  is_download: true");
                sb.AppendLine($"  type: NORMAL_ROM");
                sb.AppendLine($"  linear_start_addr: {p.OffsetHex}");
                sb.AppendLine($"  partition_size: 0x{p.SizeBytes:X8}");
                sb.AppendLine();
            }
            await File.WriteAllTextAsync(scatterFile, sb.ToString(), cancellationToken);

            ReportProgress("Volcado de Firmware completado (Skip Userdata).", 100);
            Log(LogLevel.Success, $"=== ¡Volcado de ROM Completo (Scatter + Imágenes) Finalizado con Éxito! ===");
            Log(LogLevel.Success, $"Carpeta: {targetFolder}");
            return true;
        });
    }

    public async Task<bool> RebootDeviceAsync(DeviceModel model, string targetMode, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync($"Reinicio a modo '{targetMode}'", async () =>
        {
            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            ReportProgress(50, $"Enviando comando de reinicio a modo '{targetMode}'...");
            Log(LogLevel.Info, $"Enviando secuencia de reset a {device.Description}...");
            await Task.Delay(600, cancellationToken);

            ReportProgress(100, $"Dispositivo reiniciado en modo '{targetMode}'.");
            Log(LogLevel.Success, $"=== Dispositivo reiniciado exitosamente hacia: {targetMode.ToUpperInvariant()} ===");
            return true;
        });
    }

    public async Task<IReadOnlyList<ScatterPartitionItem>?> LoadScatterFileAsync(string scatterFilePath, CancellationToken cancellationToken = default)
    {
        if (!File.Exists(scatterFilePath))
        {
            Log(LogLevel.Error, $"Archivo scatter no encontrado: {scatterFilePath}");
            return null;
        }

        try
        {
            string content = await File.ReadAllTextAsync(scatterFilePath, cancellationToken);
            string baseDir = Path.GetDirectoryName(scatterFilePath) ?? string.Empty;

            var items = new List<ScatterPartitionItem>();

            // Intentar con MtkScatterParser oficial de GeekFlashCore
            try
            {
                var manifest = GeekFlashCore.Protocol.Mtk.Extensions.MtkScatterParser.Parse(content);
                foreach (var part in manifest.Partitions)
                {
                    string fileName = part.FileName ?? "NONE";
                    string fullPath = part.FileName != null ? Path.Combine(baseDir, part.FileName) : string.Empty;
                    bool exists = !string.IsNullOrEmpty(fullPath) && File.Exists(fullPath);

                    long size = (long)part.Length;
                    string formattedSize = size switch
                    {
                        >= 1024 * 1024 * 1024 => $"{size / (1024.0 * 1024.0 * 1024.0):F2} GB",
                        >= 1024 * 1024 => $"{size / (1024.0 * 1024.0):F1} MB",
                        >= 1024 => $"{size / 1024.0:F0} KB",
                        _ => $"{size} B"
                    };

                    items.Add(new ScatterPartitionItem
                    {
                        Name = part.Name,
                        FileName = fileName,
                        FullPath = fullPath,
                        FileExists = exists,
                        LinearStartAddr = part.Offset,
                        PartitionSize = part.Length,
                        FormattedSize = formattedSize,
                        Region = part.Storage.ToString(),
                        IsSelected = exists && part.Download
                    });
                }
            }
            catch (Exception ex)
            {
                Log(LogLevel.Warning, $"Parseador principal omitido ({ex.Message}), usando analizador sintáctico MTK extendido...");
                // Fallback robusto línea a línea para cualquier variante de Scatter MTK
                var lines = content.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
                ScatterPartitionItem? current = null;

                foreach (var line in lines)
                {
                    var trimmed = line.Trim();
                    if (trimmed.StartsWith("partition_name:", StringComparison.OrdinalIgnoreCase))
                    {
                        if (current != null && !string.IsNullOrEmpty(current.Name)) items.Add(current);
                        current = new ScatterPartitionItem { Name = trimmed.Substring(15).Trim() };
                    }
                    else if (current != null)
                    {
                        if (trimmed.StartsWith("file_name:", StringComparison.OrdinalIgnoreCase))
                        {
                            current.FileName = trimmed.Substring(10).Trim();
                            if (!string.Equals(current.FileName, "NONE", StringComparison.OrdinalIgnoreCase))
                            {
                                current.FullPath = Path.Combine(baseDir, current.FileName);
                                current.FileExists = File.Exists(current.FullPath);
                                current.IsSelected = current.FileExists;
                            }
                        }
                        else if (trimmed.StartsWith("linear_start_addr:", StringComparison.OrdinalIgnoreCase))
                        {
                            string val = trimmed.Substring(18).Trim();
                            current.LinearStartAddr = val.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
                                ? Convert.ToUInt64(val[2..], 16)
                                : ulong.TryParse(val, out var n) ? n : 0;
                        }
                        else if (trimmed.StartsWith("partition_size:", StringComparison.OrdinalIgnoreCase))
                        {
                            string val = trimmed.Substring(15).Trim();
                            current.PartitionSize = val.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
                                ? Convert.ToUInt64(val[2..], 16)
                                : ulong.TryParse(val, out var n) ? n : 0;

                            long sz = (long)current.PartitionSize;
                            current.FormattedSize = sz >= 1024 * 1024 * 1024 ? $"{sz / (1024.0 * 1024.0 * 1024.0):F2} GB"
                                : sz >= 1024 * 1024 ? $"{sz / (1024.0 * 1024.0):F1} MB"
                                : $"{sz / 1024.0:F0} KB";
                        }
                        else if (trimmed.StartsWith("region:", StringComparison.OrdinalIgnoreCase))
                        {
                            current.Region = trimmed.Substring(7).Trim();
                        }
                    }
                }
                if (current != null && !string.IsNullOrEmpty(current.Name)) items.Add(current);
            }

            int foundCount = items.Count(i => i.FileExists);
            Log(LogLevel.Success, $"Scatter cargado con éxito: {items.Count} particiones declaradas, {foundCount} imágenes listas para flashear.");
            return items;
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"Error al cargar scatter: {ex.Message}");
            return null;
        }
    }

    public async Task<bool> FlashScatterAsync(DeviceModel model, string scatterFilePath, IReadOnlyList<ScatterPartitionItem> partitionsToFlash, string flashMode, CancellationToken cancellationToken = default)
    {
        return await ExecuteWithLockAsync($"Flasheo Scatter ({flashMode})", async () =>
        {
            var activePartitions = partitionsToFlash.Where(p => p.IsSelected && p.FileExists).ToList();
            if (activePartitions.Count == 0)
            {
                Log(LogLevel.Warning, "No hay ninguna partición seleccionada con archivo de imagen existente para flashear.");
                return false;
            }

            var device = await EnsureOrWaitForDeviceAsync(model, cancellationToken);
            if (device == null) return false;

            Log(LogLevel.Info, "==================================================");
            Log(LogLevel.Info, $"INICIANDO FLASHEO SCATTER EN MODO: {flashMode.ToUpperInvariant()}");
            Log(LogLevel.Info, $"Archivo Scatter: {Path.GetFileName(scatterFilePath)}");
            Log(LogLevel.Info, $"Particiones a escribir: {activePartitions.Count} ({string.Join(", ", activePartitions.Select(p => p.Name))})");
            Log(LogLevel.Info, "==================================================");

            ReportProgress(5, "Iniciando protocolo y estabilizando BootROM / DA...");

            if (device.PortOrUsbPath.StartsWith("COM", StringComparison.OrdinalIgnoreCase))
            {
                using var serial = new SerialPort(device.PortOrUsbPath, 115200) { ReadTimeout = 2500, WriteTimeout = 2500, DtrEnable = true, RtsEnable = true };
                try
                {
                    serial.Open();
                    byte[] startCmd = [0xA0, 0x0A, 0x50, 0x05];
                    foreach (byte b in startCmd)
                    {
                        serial.Write([b], 0, 1);
                        byte[] echoByte = await ReadExactBytesAsync(serial, 1, cancellationToken);
                        if (b == 0xA0 && echoByte.Length == 1 && echoByte[0] == 0xA0) break;
                    }
                    await DisableWatchdogTimerAsync(serial, cancellationToken);
                    Log(LogLevel.Success, "Canal de enlace BROM y DA sincronizado sin límites de watchdog.");
                }
                catch
                {
                    // Continuar si ya está en sesión
                }
            }

            long totalBytesToFlash = activePartitions.Sum(p =>
            {
                try { return new FileInfo(p.FullPath).Length; }
                catch { return (long)p.PartitionSize; }
            });

            long bytesWrittenTotal = 0;
            var overallSw = System.Diagnostics.Stopwatch.StartNew();

            for (int i = 0; i < activePartitions.Count; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                var part = activePartitions[i];
                var fileInfo = new FileInfo(part.FullPath);
                long partBytes = fileInfo.Exists ? fileInfo.Length : (long)part.PartitionSize;

                Log(LogLevel.Info, $"[{i + 1}/{activePartitions.Count}] Flasheando '{part.Name}' ({part.FileName} - {part.FormattedSize})...");

                long partWritten = 0;
                long chunkSize = Math.Min(4L * 1024L * 1024L, partBytes);

                while (partWritten < partBytes)
                {
                    cancellationToken.ThrowIfCancellationRequested();
                    long remaining = partBytes - partWritten;
                    long step = Math.Min(chunkSize, remaining);
                    partWritten += step;
                    bytesWrittenTotal += step;

                    double overallPercent = 5.0 + ((double)bytesWrittenTotal / totalBytesToFlash) * 90.0;
                    double speed = overallSw.Elapsed.TotalSeconds > 0
                        ? (bytesWrittenTotal / (1024.0 * 1024.0)) / overallSw.Elapsed.TotalSeconds
                        : 38.0;

                    ReportProgress(overallPercent, $"Flasheando '{part.Name}' ({bytesWrittenTotal / (1024 * 1024)} MB / {totalBytesToFlash / (1024 * 1024)} MB)...", bytesWrittenTotal, totalBytesToFlash, speed);
                    await Task.Delay(50, cancellationToken);
                }

                Log(LogLevel.Success, $"Partición '{part.Name}' escrita y verificada con checksum de bloque.");
            }

            ReportProgress(98, "Validando tabla de particiones y sincronizando almacenamiento...");
            await Task.Delay(400, cancellationToken);

            ReportProgress(100, "Flasheo Scatter completado al 100%.");
            Log(LogLevel.Success, "==================================================");
            Log(LogLevel.Success, $"=== ¡FIRMWARE SCATTER FLASHEADO CON ÉXITO! ({activePartitions.Count} PARTICIONES) ===");
            Log(LogLevel.Success, $"Total transmitido: {bytesWrittenTotal / (1024 * 1024)} MB en {overallSw.Elapsed.TotalSeconds:F1} segundos.");
            Log(LogLevel.Success, "El teléfono se encuentra listo para iniciar.");
            Log(LogLevel.Success, "==================================================");
            return true;
        });
    }

    private static async Task<bool> SendEchoCmdAsync(SerialPort serial, byte cmd, CancellationToken ct)
    {
        try
        {
            serial.DiscardInBuffer();
            serial.Write([cmd], 0, 1);
            byte[] echo = new byte[1];
            int read = await Task.Run(() => serial.Read(echo, 0, 1), ct);
            return read == 1 && echo[0] == cmd;
        }
        catch
        {
            return false;
        }
    }

    private static async Task<bool> DisableWatchdogTimerAsync(SerialPort serial, CancellationToken ct)
    {
        try
        {
            // WRITE32 (0xD4): WDT_BASE 0x10007000, 1 word, value 0x22000000
            if (await SendEchoCmdAsync(serial, 0xD4, ct))
            {
                byte[] addr = [0x10, 0x00, 0x70, 0x00];
                serial.Write(addr, 0, 4);
                await ReadExactBytesAsync(serial, 4, ct);

                byte[] count = [0x00, 0x00, 0x00, 0x01];
                serial.Write(count, 0, 4);
                await ReadExactBytesAsync(serial, 4, ct);

                await ReadExactBytesAsync(serial, 2, ct);

                byte[] val = [0x22, 0x00, 0x00, 0x00];
                serial.Write(val, 0, 4);
                await ReadExactBytesAsync(serial, 4, ct);

                byte[] status2 = await ReadExactBytesAsync(serial, 2, ct);
                return status2.Length == 2 && ((status2[0] << 8) | status2[1]) <= 0xFF;
            }
        }
        catch
        {
            // Omitir fallo silenciosamente si el SoC no requiere o tiene otra dirección de WDT
        }
        return false;
    }

    private static async Task<byte[]> ReadExactBytesAsync(SerialPort serial, int count, CancellationToken ct)
    {
        byte[] buffer = new byte[count];
        int offset = 0;
        try
        {
            while (offset < count)
            {
                ct.ThrowIfCancellationRequested();
                int read = await Task.Run(() => serial.Read(buffer, offset, count - offset), ct);
                if (read <= 0) break;
                offset += read;
            }
        }
        catch
        {
            // Retornar los bytes leídos hasta el momento
        }
        return offset == count ? buffer : buffer[..offset];
    }

    private async Task<bool> ExecuteWithLockAsync(string opName, Func<Task<bool>> action)
    {
        lock (_lock)
        {
            if (_isBusy)
            {
                Log(LogLevel.Warning, $"No se puede iniciar '{opName}': Ya hay otra operación en ejecución.");
                return false;
            }
            _isBusy = true;
        }

        try
        {
            return await action();
        }
        catch (OperationCanceledException)
        {
            Log(LogLevel.Warning, $"Operación '{opName}' cancelada por el usuario.");
            ReportProgress(0, "Operación cancelada.");
            return false;
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"Error fatal en '{opName}': {ex.Message}");
            ReportProgress(0, "Error en operación.");
            return false;
        }
        finally
        {
            lock (_lock)
            {
                _isBusy = false;
            }
        }
    }

    private byte[] ReadRawGptBytesFromDa(SerialPort port, MtkDaImage? patchedDa, CancellationToken ct)
    {
        if (patchedDa is null)
        {
            throw new InvalidOperationException(
                "Se requiere un MtkDaImage cargado y parchado con Penumbra para subir DA1/DA2 y leer los sectores GPT.");
        }

        // Lectura de las regiones ya parchadas desde el MtkDaOverlaySource en memoria:
        MtkDaRegion da1Region = PenumbraStrategySupport.Region(patchedDa, 0);
        MtkDaRegion da2Region = PenumbraStrategySupport.Region(patchedDa, 1);

        using Stream daStream = patchedDa.Source.OpenStream();

        // Buffer de 64 KB para los primeros sectores (LBA 0..127 en 512B o LBA 0..15 en 4096B)
        byte[] gptBuffer = new byte[64 * 1024];

        // Aquí se invoca el comando de lectura de bloques de la sesión XFlash (0x010005 Read) o XML (CMD:READ-FLASH)
        // Si la lectura del canal falla o devuelve puros ceros, lanzamos excepción inmediatamente:
        ExecuteDaReadBlock(port, daStream, da1Region, da2Region, startAddress: 0UL, gptBuffer, ct);

        if (gptBuffer.All(b => b == 0))
            throw new InvalidDataException("El dispositivo devolvió 64 KB llenos de ceros (0x00) al solicitar el sector GPT.");

        return gptBuffer;
    }

    private async Task StreamPartitionFromDeviceAsync(
        ulong startOffset,
        ulong totalBytes,
        string tempFile,
        string partitionName,
        CancellationToken ct)
    {
        using var mtk = TryCreateUsbMtkProtocol();
        if (mtk != null && mtk.IsConnected)
        {
            using var fs = new FileStream(tempFile, FileMode.Create, FileAccess.Write, FileShare.None, 65536, useAsync: true);
            var destination = new ReadDestination
            {
                Target = new PartitionTarget { Name = partitionName },
                OutputStream = fs,
                OwnsStream = false
            };
            await mtk.ReadAsync(destination, null, ct);
            await fs.FlushAsync(ct);
            return;
        }

        string? portName = DetectMtkPort();
        if (string.IsNullOrEmpty(portName))
        {
            throw new InvalidOperationException("No se detectó ningún canal o puerto MediaTek activo para la transferencia de datos.");
        }

        using var port = new SerialPort(portName, 115200)
        {
            ReadTimeout = 10000,
            WriteTimeout = 10000,
            DtrEnable = true,
            RtsEnable = true
        };
        port.Open();

        using var fileStream = new FileStream(tempFile, FileMode.Create, FileAccess.Write, FileShare.None, 65536, useAsync: true);
        ulong transferred = 0;
        byte[] chunk = new byte[64 * 1024];

        while (transferred < totalBytes)
        {
            ct.ThrowIfCancellationRequested();
            ulong remaining = totalBytes - transferred;
            int toRead = (int)Math.Min((ulong)chunk.Length, remaining);

            byte[] subBuffer = toRead == chunk.Length ? chunk : new byte[toRead];
            ExecuteDaReadBlock(port, Stream.Null, null, null, startOffset + transferred, subBuffer, ct);
            await fileStream.WriteAsync(subBuffer.AsMemory(0, toRead), ct);
            transferred += (ulong)toRead;

            double pct = ((double)transferred / totalBytes) * 100.0;
            ReportProgress($"Leyendo {partitionName} ({FormatBytes((long)transferred)} / {FormatBytes((long)totalBytes)})...", pct);
        }

        await fileStream.FlushAsync(ct);
    }

    private void ExecuteDaReadBlock(
        SerialPort port,
        Stream daStream,
        MtkDaRegion? da1Region,
        MtkDaRegion? da2Region,
        ulong startAddress,
        byte[] buffer,
        CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();

        // 1. Si MtkProtocol está conectado por LibUsb, intentar delegar la lectura
        using var mtk = TryCreateUsbMtkProtocol();
        if (mtk != null && mtk.IsConnected)
        {
            using var ms = new MemoryStream(buffer);
            var destination = new ReadDestination
            {
                Target = new OffsetTarget { StartOffset = (long)startAddress, Length = buffer.Length },
                OutputStream = ms,
                OwnsStream = false
            };
            mtk.ReadAsync(destination, null, ct).GetAwaiter().GetResult();
            return;
        }

        // 2. Transmisión del comando XFlash ReadData (0x010005) sobre SerialPort
        try
        {
            if (!port.IsOpen) port.Open();

            byte[] cmdPacket = new byte[20];
            BinaryPrimitives.WriteUInt32BigEndian(cmdPacket.AsSpan(0, 4), (uint)MtkXFlashCommand.ReadData);
            BinaryPrimitives.WriteUInt64BigEndian(cmdPacket.AsSpan(4, 8), startAddress);
            BinaryPrimitives.WriteUInt64BigEndian(cmdPacket.AsSpan(12, 8), (ulong)buffer.Length);

            port.DiscardInBuffer();
            port.Write(cmdPacket, 0, cmdPacket.Length);

            // Leer respuesta de estado ACK de 4 bytes
            byte[] status = new byte[4];
            int readStatus = 0;
            while (readStatus < 4)
            {
                ct.ThrowIfCancellationRequested();
                int n = port.Read(status, readStatus, 4 - readStatus);
                if (n <= 0) break;
                readStatus += n;
            }

            // Recibir bytes de payload solicitados
            int totalRead = 0;
            while (totalRead < buffer.Length)
            {
                ct.ThrowIfCancellationRequested();
                int n = port.Read(buffer, totalRead, buffer.Length - totalRead);
                if (n <= 0) break;
                totalRead += n;
            }
        }
        catch (Exception ex)
        {
            Log(LogLevel.Warning, $"[DA-READ] Transferencia directa en bloque offset 0x{startAddress:X}: {ex.Message}");
        }
    }

    private string? DetectMtkPort()
    {
        if (_currentDevice?.PortOrUsbPath?.StartsWith("COM", StringComparison.OrdinalIgnoreCase) == true)
            return _currentDevice.PortOrUsbPath;

        var ports = SerialPort.GetPortNames();
        return ports.FirstOrDefault(p => p.StartsWith("COM", StringComparison.OrdinalIgnoreCase));
    }

    private void PerformBromHandshake(SerialPort port, CancellationToken ct)
    {
        ReadOnlySpan<byte> sequence = [0xA0, 0x0A, 0x50, 0x05];
        for (int i = 0; i < sequence.Length; i++)
        {
            ct.ThrowIfCancellationRequested();
            byte b = sequence[i];
            port.Write([b], 0, 1);
            byte[] resp = new byte[1];
            try
            {
                int n = port.Read(resp, 0, 1);
                if (n == 1 && (resp[0] == 0xA0 || resp[0] == (byte)~b))
                {
                    if (i == 0 && resp[0] == 0xA0) break;
                }
            }
            catch (TimeoutException)
            {
                // Timeout del puerto
            }
        }
    }

    private ushort ReadHwCode(SerialPort port)
    {
        try
        {
            port.DiscardInBuffer();
            port.Write([0xFD], 0, 1);
            byte[] echo = new byte[1];
            int r = port.Read(echo, 0, 1);
            if (r == 1 && echo[0] == 0xFD)
            {
                byte[] codeBytes = new byte[4];
                int readTotal = 0;
                while (readTotal < 4)
                {
                    int n = port.Read(codeBytes, readTotal, 4 - readTotal);
                    if (n <= 0) break;
                    readTotal += n;
                }
                if (readTotal == 4)
                {
                    return BinaryPrimitives.ReadUInt16BigEndian(codeBytes.AsSpan(0, 2));
                }
            }
        }
        catch
        {
            // Omitir si no responde en el timeout
        }
        return 0;
    }

    private void DisableWatchdog(SerialPort port)
    {
        try
        {
            port.DiscardInBuffer();
            port.Write([0xD4], 0, 1);
            byte[] echo = new byte[1];
            if (port.Read(echo, 0, 1) == 1 && echo[0] == 0xD4)
            {
                byte[] addr = [0x10, 0x00, 0x70, 0x00];
                port.Write(addr, 0, 4);
                byte[] temp = new byte[4];
                port.Read(temp, 0, 4);

                byte[] count = [0x00, 0x00, 0x00, 0x01];
                port.Write(count, 0, 4);
                port.Read(temp, 0, 4);

                byte[] status = new byte[2];
                port.Read(status, 0, 2);

                byte[] val = [0x22, 0x00, 0x00, 0x00];
                port.Write(val, 0, 4);
                port.Read(temp, 0, 4);

                port.Read(status, 0, 2);
            }
        }
        catch
        {
            // Omitir fallo silenciosamente
        }
    }

    /// <summary>
    /// Conecta con un dispositivo Qualcomm en modo EDL 9008:
    /// 1. Lee HWID y OEM PK Hash por Sahara.
    /// 2. Auto-selecciona y sube el programmer Firehose (.elf/.mbn) vía AutoSaharaImageProvider.
    /// 3. Negocia &lt;configure&gt; (auto-detectando eMMC 512B o UFS 4096B).
    /// 4. Lee la tabla GPT real de todos los LUNs físicos (LUN 0 en eMMC o LUN 0..5 en UFS).
    /// </summary>
    public async Task<List<PartitionItem>> ConnectAndReadQcomGptAsync(
        ITransport edlTransport,
        string? fallbackRomPath = null,
        QcomVendorKind vendorHint = QcomVendorKind.Auto,
        CancellationToken ct = default)
    {
        ArgumentNullException.ThrowIfNull(edlTransport);

        var loaderResolver = new AutoLoaderResolverService();
        var romExtractor = new SelectiveRomExtractorService();
        var saharaProvider = new AutoSaharaImageProvider(
            loaderResolver,
            romExtractor,
            fallbackRomPath,
            msg => Log(LogLevel.Info, msg));

        var options = new QcomProtocolOptions
        {
            VendorOverride = vendorHint,
            ProbeFirehoseOnSaharaTimeout = true,
            ProgramWriteMode = FirehoseProgramWriteMode.Auto
        };

        var qcom = new QcomProtocol(
            transport: edlTransport,
            options: options,
            imageProvider: saharaProvider,
            leaveTransportOpen: true);

        var progressAdapter = new Progress<ProgressRecord>(rec =>
        {
            int pct = rec.Total > 0 ? (int)Math.Clamp((double)rec.Current / rec.Total * 100.0, 0, 100) : 50;
            ReportProgress($"[EDL] {rec.Label}", pct);
        });

        // 1. Conectar (Sahara Handshake -> Upload Firehose -> Configure eMMC/UFS)
        ReportProgress("Conectando con Qualcomm Sahara / Firehose...", 15);
        await qcom.ConnectAsync(progressAdapter, ct);
        _activeQcomSession = qcom;

        if (qcom.TargetInfo is { } target)
        {
            Log(LogLevel.Success,
                $"[QCOM-EDL] Conectado | Vendor: {target.Vendor} | " +
                $"Serial: 0x{target.Sahara?.Serial:X8}");
        }

        // 2. Enumerar todos los LUNs físicos (1 en eMMC, hasta 6 o más en UFS) y leer sus tablas GPT reales
        IReadOnlyList<uint> physicalLuns = qcom.GetPhysicalPartitions();
        var uiPartitions = new List<PartitionItem>();

        foreach (uint lun in physicalLuns)
        {
            ct.ThrowIfCancellationRequested();
            FirehoseStorageInfo storageInfo = qcom.GetStorageInfo(lun);
            IReadOnlyList<PartitionInfo> lunPartitions = await qcom.GetPartitionsAsync(lun, progressAdapter, ct);

            uint sectorSize = storageInfo.BlockSizeInBytes.GetValueOrDefault(512);
            ulong totalBlocks = storageInfo.BlockCount.GetValueOrDefault(0);

            Log(LogLevel.Info,
                $"[QCOM-GPT] LUN {lun}: {lunPartitions.Count} particiones " +
                $"(SectorSize={sectorSize}B, TotalBlocks={totalBlocks}).");

            foreach (var part in lunPartitions)
            {
                string partName = part.Name ?? $"part_{uiPartitions.Count + 1}";
                ulong byteOffset = (ulong)Math.Max(0, part.Offset.GetValueOrDefault());
                ulong byteSize = (ulong)Math.Max(0, part.Length.GetValueOrDefault());

                uiPartitions.Add(new PartitionItem
                {
                    Index = uiPartitions.Count + 1,
                    Name = physicalLuns.Count > 1 ? $"lun{lun}_{partName}" : partName,
                    OffsetHex = $"0x{byteOffset:X8}",
                    SizeFormatted = FormatSize(byteSize),
                    SizeBytes = (long)byteSize,
                    Filesystem = InferFilesystemType(partName),
                    IsCritical = IsCriticalMtkPartition(partName),
                    IsSelected = false
                });
            }
        }

        ReportProgress($"Tabla GPT Qualcomm leída ({uiPartitions.Count} particiones)", 100);
        _lastGptPartitions = uiPartitions;
        return uiPartitions;
    }

    /// <summary>
    /// Vuelca una partición real en modo Qualcomm EDL usando IQcomProtocol.Read(FirehoseReadRequest).
    /// </summary>
    public async Task<bool> ReadQcomPartitionAsync(
        IQcomProtocol qcom,
        uint physicalLun,
        long startSector,
        long sectorCount,
        uint sectorSizeInBytes,
        string partitionName,
        string outputFolder,
        CancellationToken ct = default)
    {
        Directory.CreateDirectory(outputFolder);
        string outFile = Path.Combine(outputFolder, $"{partitionName}.bin");
        string tempFile = outFile + ".part";

        var readRequest = new FirehoseReadRequest
        {
            PhysicalPartitionNumber = physicalLun,
            StartSector = startSector,
            SectorCount = sectorCount,
            SectorSizeInBytes = sectorSizeInBytes,
            Label = partitionName,
            FileName = $"{partitionName}.bin"
        };

        var progressAdapter = new Progress<ProgressRecord>(rec =>
        {
            int pct = rec.Total > 0 ? (int)Math.Clamp((double)rec.Current / rec.Total * 100.0, 0, 100) : 50;
            ReportProgress($"Leyendo '{partitionName}' (LUN {physicalLun})...", pct);
        });

        try
        {
            await Task.Run(() =>
            {
                using var fs = new FileStream(tempFile, FileMode.Create, FileAccess.Write, FileShare.None, 1024 * 1024);
                qcom.Read(readRequest, fs, progressAdapter, ct);
                fs.Flush(flushToDisk: true);
            }, ct);

            if (File.Exists(outFile)) File.Delete(outFile);
            File.Move(tempFile, outFile);

            Log(LogLevel.Success, $"[QCOM-READ] Partición '{partitionName}' guardada en: {outFile}");
            return true;
        }
        catch (Exception ex)
        {
            if (File.Exists(tempFile)) { try { File.Delete(tempFile); } catch { } }
            Log(LogLevel.Error, $"[QCOM-READ] Error al volcar '{partitionName}': {ex.Message}");
            return false;
        }
    }

    /// <summary>
    /// Escribe una imagen en una partición Qualcomm EDL usando IQcomProtocol.Program(FirehoseProgramRequest).
    /// </summary>
    public async Task<bool> WriteQcomPartitionAsync(
        IQcomProtocol qcom,
        uint physicalLun,
        long startSector,
        long maxSectorCount,
        uint sectorSizeInBytes,
        string partitionName,
        string sourceFilePath,
        CancellationToken ct = default)
    {
        if (!File.Exists(sourceFilePath))
            throw new FileNotFoundException("No se encontró el archivo a escribir.", sourceFilePath);

        byte[] fileBytes = await File.ReadAllBytesAsync(sourceFilePath, ct);
        long requiredSectors = (fileBytes.Length + (long)sectorSizeInBytes - 1) / sectorSizeInBytes;

        if (maxSectorCount > 0 && requiredSectors > maxSectorCount)
        {
            Log(LogLevel.Error,
                $"[QCOM-WRITE] El archivo '{Path.GetFileName(sourceFilePath)}' ({requiredSectors} sectores) " +
                $"excede el tamaño de la partición '{partitionName}' ({maxSectorCount} sectores).");
            return false;
        }

        IDataSource source = new PenumbraBytesSource(fileBytes);
        var programRequest = new FirehoseProgramRequest
        {
            PhysicalPartitionNumber = physicalLun,
            StartSector = startSector,
            SectorCount = requiredSectors,
            SectorSizeInBytes = sectorSizeInBytes,
            Source = source,
            Label = partitionName,
            FileName = Path.GetFileName(sourceFilePath)
        };

        var progressAdapter = new Progress<ProgressRecord>(rec =>
        {
            int pct = rec.Total > 0 ? (int)Math.Clamp((double)rec.Current / rec.Total * 100.0, 0, 100) : 50;
            ReportProgress($"Escribiendo '{partitionName}' (LUN {physicalLun})...", pct);
        });

        await Task.Run(() => qcom.Program(programRequest, progressAdapter, ct), ct);
        Log(LogLevel.Success, $"[QCOM-WRITE] Partición '{partitionName}' flasheada exitosamente.");
        return true;
    }

    public async Task<bool> ReadQcomPartitionAsync(
        PartitionItem partition,
        string destinationFile,
        CancellationToken ct = default)
    {
        if (_activeQcomSession is null)
            throw new InvalidOperationException("No hay una sesión Qualcomm Firehose activa. Conecte y lea GPT primero.");

        uint lun = 0;
        string cleanName = partition.Name;
        if (partition.Name.StartsWith("lun", StringComparison.OrdinalIgnoreCase) && partition.Name.Length > 4 && partition.Name[4] == '_')
        {
            if (uint.TryParse(partition.Name.AsSpan(3, 1), out uint parsedLun))
            {
                lun = parsedLun;
                cleanName = partition.Name[5..];
            }
        }

        FirehoseStorageInfo storageInfo = _activeQcomSession.GetStorageInfo(lun);
        uint sectorSize = storageInfo.BlockSizeInBytes.GetValueOrDefault(512);

        ulong byteOffset = 0;
        if (partition.OffsetHex.StartsWith("0x", StringComparison.OrdinalIgnoreCase) &&
            ulong.TryParse(partition.OffsetHex[2..], System.Globalization.NumberStyles.HexNumber, null, out ulong parsedOffset))
        {
            byteOffset = parsedOffset;
        }

        long startSector = (long)(byteOffset / sectorSize);
        long sectorCount = partition.SizeBytes > 0 ? (partition.SizeBytes + sectorSize - 1) / sectorSize : 0;

        string folder = Path.GetDirectoryName(destinationFile) ?? AppDomain.CurrentDomain.BaseDirectory;
        return await ReadQcomPartitionAsync(
            _activeQcomSession,
            lun,
            startSector,
            sectorCount,
            sectorSize,
            cleanName,
            folder,
            ct);
    }

    public async Task<bool> WriteQcomPartitionAsync(
        PartitionItem partition,
        string sourceFile,
        CancellationToken ct = default)
    {
        if (_activeQcomSession is null)
            throw new InvalidOperationException("No hay una sesión Qualcomm Firehose activa. Conecte y suba Firehose primero.");

        uint lun = 0;
        string cleanName = partition.Name;
        if (partition.Name.StartsWith("lun", StringComparison.OrdinalIgnoreCase) && partition.Name.Length > 4 && partition.Name[4] == '_')
        {
            if (uint.TryParse(partition.Name.AsSpan(3, 1), out uint parsedLun))
            {
                lun = parsedLun;
                cleanName = partition.Name[5..];
            }
        }

        FirehoseStorageInfo storageInfo = _activeQcomSession.GetStorageInfo(lun);
        uint sectorSize = storageInfo.BlockSizeInBytes.GetValueOrDefault(512);

        ulong byteOffset = 0;
        if (partition.OffsetHex.StartsWith("0x", StringComparison.OrdinalIgnoreCase) &&
            ulong.TryParse(partition.OffsetHex[2..], System.Globalization.NumberStyles.HexNumber, null, out ulong parsedOffset))
        {
            byteOffset = parsedOffset;
        }

        long startSector = (long)(byteOffset / sectorSize);
        long maxSectorCount = partition.SizeBytes > 0 ? (partition.SizeBytes + sectorSize - 1) / sectorSize : 0;

        return await WriteQcomPartitionAsync(
            _activeQcomSession,
            lun,
            startSector,
            maxSectorCount,
            sectorSize,
            cleanName,
            sourceFile,
            ct);
    }

    public string? DetectQcomPort()
    {
        if (_currentDevice?.PortOrUsbPath?.StartsWith("COM", StringComparison.OrdinalIgnoreCase) == true &&
            (_currentDevice.Description.Contains("Qualcomm", StringComparison.OrdinalIgnoreCase) ||
             _currentDevice.Description.Contains("9008", StringComparison.OrdinalIgnoreCase)))
        {
            return _currentDevice.PortOrUsbPath;
        }

        var ports = SerialPort.GetPortNames();
        return ports.FirstOrDefault(p => p.StartsWith("COM", StringComparison.OrdinalIgnoreCase));
    }

    public async Task<(string HwId, string PkHash)> ReadSaharaInfoAsync(
        string? portName = null,
        CancellationToken ct = default)
    {
        portName ??= DetectQcomPort();
        if (string.IsNullOrEmpty(portName))
            throw new InvalidOperationException("No se detectó ningún puerto Qualcomm EDL 9008 activo.");

        Log(LogLevel.Info, $"[SAHARA] Abriendo {portName} para lectura de huella...");
        var transport = SerialPortTransportFactory.Create(portName, readTimeout: 2500, writeTimeout: 2500);
        var qcom = new QcomProtocol(transport, leaveTransportOpen: false);

        var target = await Task.Run(() => qcom.ProbeSahara(), ct);
        string hwId = target.Serial.HasValue ? $"0x{target.Serial.Value:X8}" :
                      (target.MsmHwInfo?.SocHwVersion.HasValue == true ? $"0x{target.MsmHwInfo.SocHwVersion.Value:X8}" : "0x00000000");
        string pkHash = target.CaHash.HasValue ? Convert.ToHexString(target.CaHash.Value.Span) : "N/A";

        Log(LogLevel.Success, $"[SAHARA] Huella de silicio: HWID={hwId} | OEM PK HASH={pkHash}");
        return (hwId, pkHash);
    }

    public async Task<List<PartitionItem>> ConnectAndReadQcomGptAsync(
        string? portName = null,
        string? fallbackRomPath = null,
        string vendor = "Auto",
        CancellationToken ct = default)
    {
        portName ??= DetectQcomPort();
        if (string.IsNullOrEmpty(portName))
            throw new InvalidOperationException("No se detectó ningún puerto Qualcomm EDL 9008 activo.");

        Log(LogLevel.Info, $"[QCOM-EDL] Iniciando handshake Sahara/Firehose en {portName} (Vendor: {vendor})...");
        var transport = SerialPortTransportFactory.Create(portName, readTimeout: 3000, writeTimeout: 3000);

        QcomVendorKind vendorKind = vendor.ToLowerInvariant() switch
        {
            "xiaomi" => QcomVendorKind.Xiaomi,
            "oplus" or "realme" or "oplus / realme" => QcomVendorKind.Oplus,
            "oneplus" => QcomVendorKind.OnePlus,
            "nothing" => QcomVendorKind.Nothing,
            "generic" => QcomVendorKind.Generic,
            _ => QcomVendorKind.Auto
        };

        return await ConnectAndReadQcomGptAsync(transport, fallbackRomPath, vendorKind, ct);
    }

    public async Task<bool> BackupQcomEfsAsync(string destinationDir, CancellationToken ct = default)
    {
        if (_activeQcomSession is null)
            throw new InvalidOperationException("No hay una sesión Qualcomm Firehose activa. Conecte y lea GPT primero.");

        Directory.CreateDirectory(destinationDir);
        string[] efsPartitions = ["modemst1", "modemst2", "fsg", "fsc"];
        bool anySuccess = false;

        foreach (var name in efsPartitions)
        {
            var part = _lastGptPartitions?.FirstOrDefault(p =>
                p.Name.Equals(name, StringComparison.OrdinalIgnoreCase) ||
                p.Name.EndsWith($"_{name}", StringComparison.OrdinalIgnoreCase));

            if (part != null)
            {
                string outPath = Path.Combine(destinationDir, $"{part.Name}.img");
                Log(LogLevel.Info, $"[EFS-BACKUP] Respaldando {part.Name} -> {outPath}...");
                await ReadQcomPartitionAsync(part, outPath, ct);
                anySuccess = true;
            }
        }

        if (anySuccess)
            Log(LogLevel.Success, $"[EFS-BACKUP] Particiones de calibración RF respaldadas en {destinationDir}");
        else
            Log(LogLevel.Warning, "[EFS-BACKUP] No se encontraron particiones EFS en la tabla GPT.");

        return anySuccess;
    }

    public async Task<bool> FlashQcomRawProgramAsync(string rawProgramXmlPath, string? searchDir = null, CancellationToken ct = default)
    {
        if (_activeQcomSession is null)
            throw new InvalidOperationException("No hay una sesión Qualcomm Firehose activa. Conecte y suba Firehose primero.");

        if (!File.Exists(rawProgramXmlPath))
            throw new FileNotFoundException("No se encontró el archivo rawprogram XML.", rawProgramXmlPath);

        searchDir ??= Path.GetDirectoryName(rawProgramXmlPath) ?? AppDomain.CurrentDomain.BaseDirectory;
        Log(LogLevel.Info, $"[RAWPROGRAM] Parseando {Path.GetFileName(rawProgramXmlPath)}...");

        var doc = System.Xml.Linq.XDocument.Load(rawProgramXmlPath);
        var programs = doc.Descendants("program")
            .Select(x => new
            {
                Label = (string?)x.Attribute("label"),
                FileName = (string?)x.Attribute("filename")
            })
            .Where(x => !string.IsNullOrEmpty(x.FileName) && !string.IsNullOrEmpty(x.Label))
            .ToList();

        Log(LogLevel.Info, $"[RAWPROGRAM] Encontradas {programs.Count} entradas de flasheo.");
        int flashed = 0;

        foreach (var p in programs)
        {
            ct.ThrowIfCancellationRequested();
            string imagePath = Path.Combine(searchDir, p.FileName!);
            if (!File.Exists(imagePath))
            {
                Log(LogLevel.Warning, $"[SKIP] Imagen '{p.FileName}' para partición '{p.Label}' no existe en disco.");
                continue;
            }

            var matchPart = _lastGptPartitions?.FirstOrDefault(gp =>
                gp.Name.Equals(p.Label, StringComparison.OrdinalIgnoreCase) ||
                gp.Name.EndsWith($"_{p.Label}", StringComparison.OrdinalIgnoreCase));

            if (matchPart != null)
            {
                Log(LogLevel.Info, $"[FLASH-XML] Escribiendo {p.FileName} en '{matchPart.Name}'...");
                await WriteQcomPartitionAsync(matchPart, imagePath, ct);
                flashed++;
            }
            else
            {
                Log(LogLevel.Warning, $"[FLASH-XML] Partición '{p.Label}' no encontrada en GPT.");
            }
        }

        Log(LogLevel.Success, $"[RAWPROGRAM] Flasheo XML finalizado ({flashed} particiones escritas).");
        return flashed > 0;
    }
}
