<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GeekFlashCore.Services</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeekFlashCore.Abstractions\GeekFlashCore.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Abstractions\GeekFlashCore.Protocol.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Mtk\GeekFlashCore.Protocol.Mtk.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Mtk.Abstractions\GeekFlashCore.Protocol.Mtk.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Mtk.Extensions\GeekFlashCore.Protocol.Mtk.Extensions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Qcom\GeekFlashCore.Protocol.Qcom.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Qcom.Abstractions\GeekFlashCore.Protocol.Qcom.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Sprd\GeekFlashCore.Protocol.Sprd.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Protocol.Sprd.Abstractions\GeekFlashCore.Protocol.Sprd.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Firmware\GeekFlashCore.Firmware.csproj" />
    <ProjectReference Include="..\GeekFlashCore.UsbWatcher\GeekFlashCore.UsbWatcher.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Transport.LibUsb\GeekFlashCore.Transport.LibUsb.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Transport.SerialPort\GeekFlashCore.Transport.SerialPort.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Transport.Abstractions\GeekFlashCore.Transport.Abstractions.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Gpt\GeekFlashCore.Gpt.csproj" />
    <ProjectReference Include="..\GeekFlashCore.Gpt.Abstractions\GeekFlashCore.Gpt.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Auth\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
